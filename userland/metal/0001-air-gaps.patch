+/* The pointer a constant global's initializer holds at byte `rel`: the cell of
+ * a `constexpr sampler` wrapper, for one. Walks the initializer by type, so a
+ * member found at that offset is the member and nothing else is guessed; a
+ * zeroinitializer yields a null pointer for any pointer-typed leaf.
+ */
+static struct air_val *
+const_global_pointer(struct air_ctx *c, const struct air_ptr *p)
+{
+   const struct air_global *g = p->global;
+   if (!g || !g->is_const || !g->init || g->externally_initialized) {
+      air_error(c, "instruction: a pointer loaded from memory that is not a constant "
+                   "global (argument buffers)");
+      return NULL;
+   }
+   uint64_t rel;
+   if (!p->offset) {
+      rel = 0;
+   } else {
+      uint64_t abs;
+      if (!nir_src_is_const(nir_src_for_ssa(p->offset)) ||
+          (abs = nir_src_as_uint(nir_src_for_ssa(p->offset))) < p->global_base) {
+         air_error(c, "instruction: a pointer loaded from a constant global at a "
+                      "run-time offset");
+         return NULL;
+      }
+      rel = abs - p->global_base;
+   }
+
+   const struct air_type *t = g->value_type;
+   const struct air_value *v = g->init;
+   bool zero = false;
+   for (;;) {
+      const struct air_constant *k = air_value_as_constant(v);
+      if (k && (k->ckind == AIR_CONST_NULL || k->ckind == AIR_CONST_UNDEF ||
+                k->ckind == AIR_CONST_POISON))
+         zero = true;
+      if (t->kind == AIR_TYPE_POINTER) {
+         if (rel) {
+            air_error(c, "instruction: a pointer loaded from the middle of a pointer "
+                         "in a constant global");
+            return NULL;
+         }
+         if (zero) {
+            struct air_ptr np = { .class = AIR_PTR_NONE, .pointee = t->elem };
+            return air_val_ptr(c, np);
+         }
+         return air_get(c, v);
+      }
+      const struct air_type *et = NULL;
+      const struct air_value *ev = NULL;
+      uint64_t erel = 0;
+      if (t->kind == AIR_TYPE_STRUCT) {
+         for (unsigned n = 0; n < t->num_members && !et; n++) {
+            uint64_t off = air_struct_member_offset(c->m, t, n);
+            uint64_t size = air_type_alloc_size(c->m, t->members[n]);
+            if (rel >= off && rel < off + size) {
+               et = t->members[n];
+               erel = rel - off;
+               if (!zero && k && k->ckind == AIR_CONST_AGGREGATE && n < k->num_elems)
+                  ev = k->elems[n];
+            }
+         }
+      } else if (t->kind == AIR_TYPE_ARRAY) {
+         uint64_t es = air_type_alloc_size(c->m, t->elem);
+         uint64_t n = es ? rel / es : 0;
+         if (es && n < t->count) {
+            et = t->elem;
+            erel = rel - n * es;
+            if (!zero && k && k->ckind == AIR_CONST_AGGREGATE && n < k->num_elems)
+               ev = k->elems[n];
+         }
