+/* -- pointer cells ------------------------------------------------------ */
+
+/* Metal's compiler keeps a `sampler` argument that is later chosen between two
+ * (the argument, or a constexpr one when a function constant says the argument
+ * is absent) in an `alloca ptr`, stores the argument there once at the top of
+ * the function, reaches the cell through a bitcast and a `select` against a
+ * constant global that wraps the other sampler, and loads the sampler back out
+ * through the chosen address. Memory is the wrong model for that here: a
+ * pointer is a resolution, not bytes (docs/air.md section 3), so there is
+ * nothing to put in the cell.
+ *
+ * It is still answerable, and exactly, when the cell behaves like a name for
+ * ONE value: it is written once, before anything reads it, and its address is
+ * never seen by anything that could write it again or compare it. Then every
+ * load from the cell, however it is reached, yields the one stored value, and
+ * the cell can be a translation-time slot (AIR_PTR_CELL) instead of memory.
+ * This function proves that, over the whole function body, or says no -- and
+ * a no leaves the alloca as scratch memory, so the store of a pointer into it
+ * is refused by name exactly as before.
+ *
+ * What the proof demands:
+ *   - the values that can hold the cell's address (the alloca, and bitcasts,
+ *     selects, phis and all-zero geps of those) are used ONLY as the pointer
+ *     operand of a load of a POINTER, as such another alias, or as the pointer
+ *     operand of the store below. Passed to a call, stored as a value,
+ *     compared, cast to an integer, indexed with a non-zero index or loaded
+ *     as anything but a pointer all let the address or its bytes out;
+ *   - there is exactly ONE store, its pointer operand is the alloca itself or
+ *     a bitcast of it (not a select or a phi: those could pick another
+ *     cell), and it is in the entry block -- which has no predecessor, so it
+ *     runs once and before every other block;
+ *   - a load in the entry block comes after the store in it.
+ * A cell addressed through a select with another object is fine to LOAD
+ * through: the select is kept as a choice of pointers (AIR_VAL_PTR_SELECT)
+ * and the load answers each side from its own object.
+ */
+static bool
+cell_is_resolvable(struct air_ctx *c, const struct air_inst *alloca)
+{
+   const struct air_function *f = c->fn;
+   if (!f || !f->num_blocks)
+      return false;
+   void *tmp = ralloc_context(NULL);
+   struct set *alias = _mesa_pointer_set_create(tmp);
+   struct set *direct = _mesa_pointer_set_create(tmp);
+   _mesa_set_add(alias, &alloca->base);
+   _mesa_set_add(direct, &alloca->base);
+
+   bool changed;
+   do {
+      changed = false;
+      for (unsigned bi = 0; bi < f->num_blocks; bi++) {
+         for (unsigned i = 0; i < f->blocks[bi].num_insts; i++) {
+            const struct air_inst *in = f->blocks[bi].insts[i];
+            bool derived = false;
+            switch (in->op) {
+            case AIR_OP_CAST:
+               if (in->sub == AIR_CAST_BITCAST &&
+                   _mesa_set_search(alias, in->operands[0])) {
+                  derived = true;
+                  if (_mesa_set_search(direct, in->operands[0]) &&
+                      !_mesa_set_search(direct, &in->base)) {
+                     _mesa_set_add(direct, &in->base);
+                     changed = true;
+                  }
+               }
+               break;
+            case AIR_OP_SELECT:
+               derived = _mesa_set_search(alias, in->operands[1]) ||
+                         _mesa_set_search(alias, in->operands[2]);
+               break;
+            case AIR_OP_PHI:
+               for (unsigned k = 0; k < in->num_operands; k++)
+                  derived |= _mesa_set_search(alias, in->operands[k]) != NULL;
+               break;
+            case AIR_OP_GEP:
+               derived = _mesa_set_search(alias, in->operands[0]) != NULL;
+               break;
+            default:
+               break;
+            }
+            if (derived && !_mesa_set_search(alias, &in->base)) {
+               _mesa_set_add(alias, &in->base);
+               changed = true;
+            }
+         }
+      }
+   } while (changed);
+
+   unsigned stores = 0;
+   bool ok = true;
+   for (unsigned bi = 0; bi < f->num_blocks && ok; bi++) {
+      for (unsigned i = 0; i < f->blocks[bi].num_insts && ok; i++) {
+         const struct air_inst *in = f->blocks[bi].insts[i];
+         if (in == alloca)
+            continue;
+         for (unsigned k = 0; k < in->num_operands && ok; k++) {
+            if (!_mesa_set_search(alias, in->operands[k]))
+               continue;
+            switch (in->op) {
+            case AIR_OP_CAST:
+               ok = in->sub == AIR_CAST_BITCAST && in->base.type->kind == AIR_TYPE_POINTER;
+               break;
+            case AIR_OP_SELECT:
+               ok = k >= 1;
+               break;
+            case AIR_OP_PHI:
+               break;
+            case AIR_OP_GEP: {
+               ok = k == 0;
+               for (unsigned j = 1; ok && j < in->num_operands; j++) {
+                  uint64_t idx;
+                  ok = air_const_uint(in->operands[j], &idx) && idx == 0;
+               }
+               break;
+            }
+            case AIR_OP_LOAD:
+               /* before the store, in the entry block, it would read nothing */
+               ok = k == 0 && in->base.type->kind == AIR_TYPE_POINTER &&
+                    (bi != 0 || stores == 1);
+               break;
+            case AIR_OP_STORE:
+               ok = k == 1 && bi == 0 && _mesa_set_search(direct, in->operands[1]) &&
+                    in->operands[0]->type->kind == AIR_TYPE_POINTER;
+               if (ok)
+                  stores++;
+               break;
+            default:
+               ok = false;
+               break;
+            }
+         }
+      }
+   }
+   ralloc_free(tmp);
+   return ok && stores == 1;
+}
