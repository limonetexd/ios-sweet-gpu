+/* A sampler CHOSEN between two (a `select` of sampler pointers, which is how a
+ * shader falls back on a constexpr sampler when the one it was given is
+ * absent). Both are real bindings, so the choice is only which index: the
+ * tex instruction takes the lower one as its index and the run-time distance
+ * to the chosen one as a sampler_offset, and no other sampler is touched.
+ */
+static bool
+sampler_choice(struct air_ctx *c, const struct air_val *v, struct air_ptr *out)
+{
+   const struct air_val *a = v->elems[0], *b = v->elems[1];
+   if (a->kind != AIR_VAL_PTR || b->kind != AIR_VAL_PTR ||
+       a->ptr.class != AIR_PTR_SAMPLER || b->ptr.class != AIR_PTR_SAMPLER ||
+       a->ptr.offset || b->ptr.offset)
+      return air_error(c, "intrinsic: a sampler chosen between things that are not two "
+                          "plain samplers");
+   if (a->ptr.binding == b->ptr.binding) {
+      *out = a->ptr;
+      return true;
+   }
+   unsigned lo = MIN2(a->ptr.binding, b->ptr.binding);
+   struct air_ptr p = a->ptr;
+   p.binding = lo;
+   p.offset = nir_bcsel(&c->b, v->def, nir_imm_int(&c->b, a->ptr.binding - lo),
+                        nir_imm_int(&c->b, b->ptr.binding - lo));
+   *out = p;
+   return true;
+}
