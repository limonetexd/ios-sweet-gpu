+   if (!device) {
+      say(why, why_size, "a clear with no device");
+      return -1;
+   }
+   if (color_count > PIPE_MAX_COLOR_BUFS) {
+      say(why, why_size, "a clear of %u colour attachments, and a pass has at most %u",
+          color_count, PIPE_MAX_COLOR_BUFS);
+      return -1;
+   }
