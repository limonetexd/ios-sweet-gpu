+   for (unsigned i = 0; i <= color_count; i++) {
+      bool is_depth = i == color_count;
+      struct rwa_texture *t = is_depth ? depth : color ? color[i] : NULL;
+      char what[48];
+      if (!t) {
+         if (!is_depth && (clear_color_mask & (1u << i))) {
+            say(why, why_size, "colour attachment %u is cleared and is not a texture", i);
+            return -1;
+         }
+         continue;
+      }
+      if (is_depth)
+         snprintf(what, sizeof(what), "the depth attachment");
+      else
+         snprintf(what, sizeof(what), "colour attachment %u", i);
+      unsigned bind = is_depth ? PIPE_BIND_DEPTH_STENCIL : PIPE_BIND_RENDER_TARGET;
+      if (is_depth && !format_is_depth_stencil(t->res->format)) {
+         say(why, why_size, "the depth attachment is %s, which is a colour format",
+             t->format_name);
+         return -1;
+      }
+      if (!(t->res->bind & bind)) {
+         say(why, why_size, "%s (%s) was made without MTLTextureUsageRenderTarget", what,
+             t->format_name);
+         return -1;
+      }
+      unsigned ts = t->res->nr_samples > 1 ? t->res->nr_samples : 1;
+      if (!attachment_shape_fits(t, ts, what, why, why_size))
+         return -1;
+      unsigned tw = t->shape.width;
+      unsigned th = t->shape.height ? t->shape.height : 1;
+      if (!sized) {
+         w = tw;
+         h = th;
+         samples = ts;
+         sized = true;
+      } else if (tw != w || th != h || ts != samples) {
+         say(why, why_size, "%s is %ux%u with %u sample%s and the pass's first attachment "
+                            "is %ux%u with %u", what, tw, th, ts, ts == 1 ? "" : "s", w, h,
+             samples);
+         return -1;
+      }
+   }
+   bool clears_zs = depth && ((clear_depth && format_has_depth(depth->res->format)) ||
+                              (clear_stencil && format_has_stencil(depth->res->format)));
+   if (!clear_color_mask && !clears_zs)
+      return 0;   /* every load action is Load or DontCare: nothing to do */
+
+   struct pipe_context *pipe = device->pipe;
+   struct pipe_surface *surf[PIPE_MAX_COLOR_BUFS] = { 0 };
+   struct pipe_surface *zsurf = NULL;
+   if (bind_pass_framebuffer(device, color, color_count, depth, w, h, samples, surf, &zsurf,
