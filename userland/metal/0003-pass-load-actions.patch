+/*
+ * rwa_render_clear, a pass's load actions on their own: what a Metal pass that clears and
+ * draws nothing needs, and what a pass whose attachments clear to different colours needs
+ * ahead of its first draw. Every case reads all sixteen texels back, so a clear that
+ * reached the wrong attachment, or none, or half of one, is a wrong number and not a
+ * guess.
+ *
+ * The last case is the bug this call was made for, at the library: a clear, then two draws
+ * that each cover one triangle of the quad, and both triangles must survive -- a second
+ * draw that carried the clear again would wipe the first. It needs a fragment shader that
+ * returns its float4 at [[buffer(0)]], e.g.
+ *
+ *    fragment float4 f(constant float4 &c [[buffer(0)]]) { return c; }
+ *
+ * and is skipped, said as skipped, without one.
+ *
+ *   air_metal_test --clear [FILE.metallib FUNCTION]
+ */
+static struct rwa_texture *
+clear_rt(struct rwa_device *device, unsigned format, const char *what)
+{
+   char why[WHY] = "";
+   const struct rwa_texture_shape ts = {
+      .pixel_format = format, .type = MTL_TEXTURE_TYPE_2D, .width = TEX, .height = TEX,
+      .depth = 1, .array_length = 1, .mip_levels = 1, .sample_count = 1,
+      .usage = (format == MTL_RGBA32_FLOAT ? MTL_USAGE_SHADER_READ : 0) |
+               MTL_USAGE_RENDER_TARGET,
+   };
+   struct rwa_texture *t = rwa_texture_create(device, &ts, why, sizeof(why));
+   if (!t)
+      printf("air_metal_test: clear: rwa_texture_create (%s): %s\n", what, why);
+   return t;
+}
+
+/* Whether every texel of an RGBA32Float attachment is `want`. */
+static bool
+clear_holds(struct rwa_texture *t, const float want[4], const char *what)
+{
+   char why[WHY] = "";
+   const unsigned origin[3] = { 0, 0, 0 }, extent[3] = { TEX, TEX, 1 };
+   float px[TEX * TEX * 4];
+   if (rwa_texture_read(t, 0, 0, origin, extent, px, 0, why, sizeof(why)) != 0) {
+      printf("air_metal_test: clear: rwa_texture_read (%s): %s\n", what, why);
+      return false;
+   }
+   for (unsigned i = 0; i < TEX * TEX; i++) {
+      if (memcmp(&px[4 * i], want, 4 * sizeof(float)) != 0) {
+         printf("air_metal_test: clear: %s texel %u is %g %g %g %g, wanted %g %g %g %g\n",
+                what, i, px[4 * i], px[4 * i + 1], px[4 * i + 2], px[4 * i + 3], want[0],
+                want[1], want[2], want[3]);
+         return false;
+      }
+   }
+   return true;
+}
+
+static bool
+clear_fill(struct rwa_texture *t, const float v[4], const char *what)
+{
+   char why[WHY] = "";
+   const unsigned origin[3] = { 0, 0, 0 }, extent[3] = { TEX, TEX, 1 };
+   float px[TEX * TEX * 4];
+   for (unsigned i = 0; i < TEX * TEX; i++)
+      memcpy(&px[4 * i], v, 4 * sizeof(float));
+   if (rwa_texture_write(t, 0, 0, origin, extent, px, 0, why, sizeof(why)) != 0) {
+      printf("air_metal_test: clear: rwa_texture_write (%s): %s\n", what, why);
+      return false;
+   }
+   return true;
+}
+
+static bool
+clear_case(const char *name, bool ok)
+{
+   printf("air_metal_test: clear: %-40s %s\n", name, ok ? "PASS" : "FAIL");
+   return ok;
+}
