+/*
+ * The framebuffer of one pass, from the caller's own textures, and its release. A draw
+ * and a clear-only pass bind it the same way, so there is one copy of how. create_surface
+ * wants a context, so this is a per-submission cost; the caller releases it before it may
+ * destroy the textures under it. A NULL colour attachment is left unbound -- a draw has
+ * already refused one, and a clear-only pass may have a gap Metal allows.
+ */
+static int
+bind_pass_framebuffer(struct rwa_device *device, struct rwa_texture *const *color,
+                      unsigned color_count, struct rwa_texture *depth, unsigned w, unsigned h,
+                      unsigned samples, struct pipe_surface **surf,
+                      struct pipe_surface **zsurf, char *why, size_t why_size)
+{
+   struct pipe_context *pipe = device->pipe;
+   if (color_count && !color) {
+      say(why, why_size, "%u colour attachments and no array of them", color_count);
+      return -1;
+   }
+   /* pipe_framebuffer_state.samples is filled in although nothing here reads it: both
+    * drivers take the pass's sample count off the attachments instead
+    * (util_framebuffer_get_num_samples ignores this field whenever there is one), and a
+    * field left at zero that happens to mean "one sample" is a thing to be found out by
+    * the next driver rather than by this comment.
+    */
+   struct pipe_framebuffer_state fb = { .width = w, .height = h,
+                                        .nr_cbufs = color_count,
+                                        .samples = samples };
+   *zsurf = NULL;
+   for (unsigned i = 0; i < color_count; i++) {
+      surf[i] = NULL;
+      if (!color[i])
+         continue;
+      surf[i] = pipe->create_surface(pipe, color[i]->res,
+         &(struct pipe_surface){ .format = color[i]->res->format });
+      if (!surf[i]) {
+         say(why, why_size, "%s would not make a render surface of colour attachment %u",
+             rwa_device_name(device), i);
+         for (unsigned j = 0; j < i; j++)
+            if (surf[j])
+               pipe->surface_destroy(pipe, surf[j]);
+         return -1;
+      }
+      fb.cbufs[i] = surf[i];
+   }
+   if (depth) {
+      *zsurf = pipe->create_surface(pipe, depth->res,
+         &(struct pipe_surface){ .format = depth->res->format });
+      if (!*zsurf) {
+         say(why, why_size, "%s would not make a render surface of the depth attachment",
+             rwa_device_name(device));
+         for (unsigned j = 0; j < color_count; j++)
+            if (surf[j])
+               pipe->surface_destroy(pipe, surf[j]);
+         return -1;
+      }
+      fb.zsbuf = *zsurf;
+   }
+   pipe->set_framebuffer_state(pipe, &fb);
+   return 0;
+}
+
+/* The framebuffer is released before the surfaces are destroyed, and both before the
+ * caller's next call, which may be rwa_texture_destroy on one of these attachments: a
+ * context still holding a surface of a freed resource is the same trap as a bound sampler
+ * state (rwa_sampler_destroy).
+ */
+static void
+release_pass_framebuffer(struct pipe_context *pipe, struct pipe_surface **surf,
+                         unsigned color_count, struct pipe_surface *zsurf)
+{
+   pipe->set_framebuffer_state(pipe, &(struct pipe_framebuffer_state){ 0 });
+   for (unsigned i = 0; i < color_count; i++)
+      if (surf[i])
+         pipe->surface_destroy(pipe, surf[i]);
+   if (zsurf)
+      pipe->surface_destroy(pipe, zsurf);
+}
+
+/*
+ * A pass's load actions, against the bound framebuffer. `colors` holds four floats per
+ * colour attachment and `color_mask` says which attachments are MTLLoadActionClear; any
+ * other attachment is Load or DontCare and is never touched.
+ *
+ * PIPE_CLEAR_COLOR clears every bound cbuf with ONE colour, so it is used only when the
+ * clearing attachments are all of the bound ones and share a colour (bitwise). Otherwise
+ * each clearing attachment gets its own clear_render_target, which is the only way to
+ * leave a Load attachment beside a Clear one as it was.
+ *
+ * Depth and stencil are each their own load action, because a pass that clears the depth
+ * and keeps the stencil is ordinary. An aspect is cleared only if the attachment has it:
+ * clearing the stencil of a Depth32Float buffer is a caller's mistake, but Gallium's clear
+ * would either ignore it or touch a plane that is not there. Returns whether anything was
+ * cleared.
+ */
+static bool
+clear_pass(struct pipe_context *pipe, struct pipe_surface *const *surf, unsigned color_count,
+           const float *colors, unsigned color_mask, const struct rwa_texture *depth,
+           const float *clear_depth, const unsigned *clear_stencil, unsigned w, unsigned h)
+{
+   unsigned bound = 0;
+   for (unsigned i = 0; i < color_count; i++)
+      if (surf[i])
+         bound |= 1u << i;
+   color_mask &= bound;
+
+   unsigned first = color_mask ? (unsigned)__builtin_ctz(color_mask) : 0;
+   bool one_colour = color_mask == bound;
+   for (unsigned i = 0; one_colour && i < color_count; i++)
+      if ((color_mask & (1u << i)) &&
+          memcmp(&colors[4 * i], &colors[4 * first], 4 * sizeof(float)) != 0)
+         one_colour = false;
+
+   /* For an integer attachment the bits of the float land in the right place when the
+    * colour is zero, which is the one air_run uses.
+    */
+   union pipe_color_union clear;
+   unsigned mask = 0;
+   for (unsigned c = 0; c < 4; c++)
+      clear.f[c] = color_mask ? colors[4 * first + c] : 0.0f;
+   /* Exactly the clearing attachments' bits and never PIPE_CLEAR_COLOR: freedreno reads
+    * pfb->cbufs[i] for every bit set below nr_cbufs, so a bit over a gap is a NULL
+    * dereference.
+    */
+   if (color_mask && one_colour)
+      for (unsigned i = 0; i < color_count; i++)
+         if (color_mask & (1u << i))
+            mask |= PIPE_CLEAR_COLOR0 << i;
+   if (clear_depth && depth && format_has_depth(depth->res->format))
+      mask |= PIPE_CLEAR_DEPTH;
+   if (clear_stencil && depth && format_has_stencil(depth->res->format))
+      mask |= PIPE_CLEAR_STENCIL;
+   if (mask)
+      pipe->clear(pipe, mask, NULL, &clear, clear_depth ? (double)*clear_depth : 0.0,
+                  clear_stencil ? *clear_stencil & 0xff : 0);
+   if (color_mask && !one_colour) {
+      for (unsigned i = 0; i < color_count; i++) {
+         if (!(color_mask & (1u << i)))
+            continue;
+         union pipe_color_union c;
+         memcpy(c.f, &colors[4 * i], 4 * sizeof(float));
+         pipe->clear_render_target(pipe, surf[i], &c, 0, 0, w, h, false);
+      }
+   }
+   return mask != 0 || color_mask != 0;
+}
