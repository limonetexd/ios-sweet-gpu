+/*
+ * A recorded command OWNS what it names, from -recordWork: until it is gone, which is
+ * Metal's retainedReferences (this driver's command buffers answer YES): the encoder's
+ * tables hold plain pointers, and this plug-in is not ARC, so nothing else keeps an
+ * application's buffer alive between the draw that names it and the -commit that reads
+ * it. metaltest's draw() holds its vertex buffers in locals under ARC, so they were
+ * freed when draw() returned and -commit sent -mesaBuffer to a dead object: tests 08-11
+ * died of SIGSEGV inside the draw while compute (whose buffer outlives -commit) passed.
+ */
 @implementation RedwoodMetalWork
+
+- (void)retainReferences
+{
+	if (retained) {
+		return;
+	}
+	retained = YES;
+	[pipeline retain];
+	[render retain];
+	[depth retain];
+	[depthStencilState retain];
+	[indexBuffer retain];
+	for (unsigned i = 0; i < 8; i++) {
+		[color[i] retain];
+	}
+	for (unsigned i = 0; i < RW_MAX_BUFFERS; i++) {
+		[vertexBuffers[i] retain];
+		[buffers[i] retain];
+		[textures[i] retain];
+		[samplers[i] retain];
+	}
+}
+
+- (void)dealloc
+{
+	if (retained) {
+		[pipeline release];
+		[render release];
+		[depth release];
+		[depthStencilState release];
+		[indexBuffer release];
+		for (unsigned i = 0; i < 8; i++) {
+			[color[i] release];
+		}
+		for (unsigned i = 0; i < RW_MAX_BUFFERS; i++) {
+			[vertexBuffers[i] release];
+			[buffers[i] release];
+			[textures[i] release];
+			[samplers[i] release];
+		}
+	}
+	[super dealloc];
+}
+
 @end
 
