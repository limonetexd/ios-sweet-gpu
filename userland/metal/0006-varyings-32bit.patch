+/*
+ * Whether 16-bit varyings stay 16-bit: boot-arg sweetmetal_f16vary=1 keeps the front end's
+ * old behaviour, anything else (absent included) makes every vertex output and fragment
+ * input 32-bit, converted at the store and after the load. ir3 lowers mediump only for
+ * fragment outputs and links a half vertex output by its regid without the half flag, which
+ * is how one triangle of a CoreAnimation quad drew a saturated colour. Decided once per
+ * process and said once.
+ */
+#define RW_F16VARY_KEY "sweetmetal_f16vary="
+
+static bool
+rw_keep_16bit_varyings(void)
+{
+	static dispatch_once_t once;
+	static bool keep;
+
+	dispatch_once(&once, ^{
+		char args[1024] = "";
+		size_t size = sizeof(args) - 1;
+		const char *at = NULL;
+
+		if (sysctlbyname("kern.bootargs", args, &size, NULL, 0) == 0) {
+			for (at = args; (at = strstr(at, RW_F16VARY_KEY)) != NULL;
+			     at += strlen(RW_F16VARY_KEY)) {
+				if (at == args || at[-1] == ' ') {
+					break;
+				}
+			}
+		}
+		keep = at != NULL && at[strlen(RW_F16VARY_KEY)] == '1';
+	});
+	return keep;
+}
+
+/* The one line per process: what the library actually did, from the first pipeline it
+ * made, since only the library knows whether its compiler has 16-bit ALU. */
+static void
+rw_varyings_said(unsigned mode)
+{
+	static dispatch_once_t once;
+
+	dispatch_once(&once, ^{
+		rw_print("varyings: %s\n",
+			 mode == RWA_VARYINGS_32BIT ?
+				 "16-bit widened to 32-bit (compiler has 16-bit ALU; "
+				 "sweetmetal_f16vary=1 keeps them)" :
+			 mode == RWA_VARYINGS_KEPT_FORCED ?
+				 "16-bit kept as declared (forced by boot-arg sweetmetal_f16vary=1)" :
+			 mode == RWA_VARYINGS_KEPT_NO_16BIT ?
+				 "16-bit kept as declared (compiler has no 16-bit ALU)" :
+				 "mode not reported by the library");
+	});
+}
