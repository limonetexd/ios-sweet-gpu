+/*
+ * Whether a fragment function that stores to [[depth]] in a pipeline with no depth
+ * attachment is refused: boot-arg sweetmetal_depthrefuse=1 keeps the old refusal, anything
+ * else (absent included) has the library remove the store, which is what Metal does with
+ * such a write. CoreAnimation aborts in create_pipeline_state when it is refused, and
+ * backboardd with it. Decided once per process.
+ */
+#define RW_DEPTHREFUSE_KEY "sweetmetal_depthrefuse="
 
+static bool
+rw_refuse_depth_store(void)
+{
+	static dispatch_once_t once;
+	static bool refuse;
+
+	dispatch_once(&once, ^{
+		char args[1024] = "";
+		size_t size = sizeof(args) - 1;
+		const char *at = NULL;
+
+		if (sysctlbyname("kern.bootargs", args, &size, NULL, 0) == 0) {
+			for (at = args; (at = strstr(at, RW_DEPTHREFUSE_KEY)) != NULL;
+			     at += strlen(RW_DEPTHREFUSE_KEY)) {
+				if (at == args || at[-1] == ' ') {
+					break;
+				}
+			}
+		}
+		refuse = at != NULL && at[strlen(RW_DEPTHREFUSE_KEY)] == '1';
+	});
+	return refuse;
+}
