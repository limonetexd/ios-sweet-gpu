+/*
+ * The library has one Gallium pipe_context per device, and a pipe_context is single-threaded
+ * by contract; the library itself has no lock. So every call into it is made under this one
+ * process-wide recursive mutex, and -commit holds it across a command buffer's whole replay,
+ * because the context keeps the framebuffer, the bound pipeline and the current batch between
+ * calls. Without it backboardd died with two commits inside rwa_render_draw at once (log
+ * xnu-0160vA line 4447) and with ctx->batch NULL mid-draw (xnu-0160d8 lines 2991 and
+ * 4482-4515), one boot each. Boot-arg sweetmetal_nolock=1 keeps the old unlocked calls.
+ * Decided once per process and said once.
+ */
+#define RW_NOLOCK_KEY "sweetmetal_nolock="
+
+static pthread_mutex_t rw_lib_mutex;
+
+static bool
+rw_lib_serialized(void)
+{
+	static dispatch_once_t once;
+	static bool serialized;
+
+	dispatch_once(&once, ^{
+		char args[1024] = "";
+		size_t size = sizeof(args) - 1;
+		const char *at = NULL;
+		pthread_mutexattr_t attr;
+
+		if (sysctlbyname("kern.bootargs", args, &size, NULL, 0) == 0) {
+			for (at = args; (at = strstr(at, RW_NOLOCK_KEY)) != NULL;
+			     at += strlen(RW_NOLOCK_KEY)) {
+				if (at == args || at[-1] == ' ') {
+					break;
+				}
+			}
+		}
+		serialized = !(at != NULL && at[strlen(RW_NOLOCK_KEY)] == '1');
+		pthread_mutexattr_init(&attr);
+		pthread_mutexattr_settype(&attr, PTHREAD_MUTEX_RECURSIVE);
+		pthread_mutex_init(&rw_lib_mutex, &attr);
+		pthread_mutexattr_destroy(&attr);
+		rw_print("library calls: %s\n", serialized ?
+			 "serialized by one recursive lock (sweetmetal_nolock=1 turns it off)" :
+			 "NOT serialized (forced by boot-arg sweetmetal_nolock=1)");
+	});
+	return serialized;
 }
 
+static inline void
+rw_lib_lock(void)
+{
+	if (rw_lib_serialized()) {
+		pthread_mutex_lock(&rw_lib_mutex);
+	}
+}
+
+static inline void
+rw_lib_unlock(void)
+{
+	if (rw_lib_serialized()) {
+		pthread_mutex_unlock(&rw_lib_mutex);
+	}
+}
