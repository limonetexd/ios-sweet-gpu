+	if (emit) {
+		/* the library's interval ends here too; read under the library's lock, which the
+		 * caller holds, and outside rw_pl.lock */
+		memset(&out->lib, 0, sizeof(out->lib));
+		out->lib.size = sizeof(out->lib);
+		out->lib_ok = device != NULL && mesa.passlog_read != NULL &&
+			      mesa.passlog_read(device, &out->lib, 1) == 0;
+	}
+	return emit;
