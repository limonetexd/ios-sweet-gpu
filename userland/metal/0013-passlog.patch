+		emit = true;
+		out->span_ns = now - rw_pl.start_ns;
+		out->cbs = rw_pl.cbs;
+		out->draws = rw_pl.draws;
+		out->names = rw_pl.n;
+		out->other = rw_pl.other;
+		snprintf(out->other.name, RW_PL_NAME, "(other)");
