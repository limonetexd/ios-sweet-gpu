+ * starts the next one: true means print `out` (after the library's lock is released). */
+static bool
+rw_passlog_cb_end(struct rw_pl_cb *cb, struct rwa_device *device, struct rw_pl_block *out)
+{
+	uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+	uint64_t ns = now - cb->t0;
+	uint64_t other = cb->other;
+	bool emit = false;
+
+	pthread_mutex_lock(&rw_pl.lock);
+	if (rw_pl.start_ns == 0) {
+		rw_pl.start_ns = cb->t0;
+	}
+	rw_pl.cbs++;
+	for (unsigned i = 0; i < cb->n; i++) {
+		unsigned j;
+
+		rw_pl.draws += cb->draws[i];
+		for (j = 0; j < rw_pl.n; j++) {
+			if (strcmp(rw_pl.rows[j].name, cb->name[i]) == 0) {
+				break;
+			}
+		}
+		if (j == rw_pl.n && rw_pl.n < RW_PL_SLOTS) {
+			snprintf(rw_pl.rows[j].name, RW_PL_NAME, "%s", cb->name[i]);
+			rw_pl.n++;
+		}
+		if (j < rw_pl.n) {
+			rw_pl_add(&rw_pl.rows[j], cb->draws[i], ns);
+		} else {
+			other += cb->draws[i];
+		}
