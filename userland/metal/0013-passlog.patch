+ * RW_PL_SLOTS per interval, and a name that does not fit is counted in "(other)". The
+ * interval table has its own lock, taken only in rw_passlog_cb_end and always INSIDE the
+ * library's lock when that one is on (rw_lib_lock, then rw_pl.lock: never the other way).
+ * The block is printed after -commit has released both.
+ */
+#define RW_PASSLOG_KEY "sweetmetal_passlog="
+#define RW_PL_NAME 48
+#define RW_PL_CB_MAX 32
+#define RW_PL_SLOTS 32
+#define RW_PL_TOP 10
+#define RW_PL_INTERVAL_NS 5000000000ull
