+			for (unsigned j = 0; j < rw_pl.n; j++) {
+				if (!taken[j] && (best == RW_PL_SLOTS ||
+						  rw_pl.rows[j].draws > rw_pl.rows[best].draws)) {
+					best = j;
+				}
+			}
+			if (best == RW_PL_SLOTS) {
+				break;
+			}
+			taken[best] = true;
+			out->top[out->top_n++] = rw_pl.rows[best];
+		}
+		memset(rw_pl.rows, 0, sizeof(rw_pl.rows));
+		memset(&rw_pl.other, 0, sizeof(rw_pl.other));
+		rw_pl.n = 0;
+		rw_pl.cbs = 0;
+		rw_pl.draws = 0;
+		rw_pl.start_ns = now;
+	}
+	pthread_mutex_unlock(&rw_pl.lock);
