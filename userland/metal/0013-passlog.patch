+static bool
+rw_passlog_on(void)
+{
+	static dispatch_once_t once;
+	static bool on;
+
+	dispatch_once(&once, ^{
+		char args[1024] = "";
+		size_t size = sizeof(args) - 1;
+		const char *at = NULL;
+
+		if (sysctlbyname("kern.bootargs", args, &size, NULL, 0) == 0) {
+			for (at = args; (at = strstr(at, RW_PASSLOG_KEY)) != NULL;
+			     at += strlen(RW_PASSLOG_KEY)) {
+				if (at == args || at[-1] == ' ') {
+					break;
+				}
+			}
+		}
+		on = at != NULL && at[strlen(RW_PASSLOG_KEY)] == '1';
+	});
+	return on;
