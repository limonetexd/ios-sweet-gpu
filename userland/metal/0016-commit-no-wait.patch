+/*
+ * 0016: hand the queued work to the GPU and return as soon as it has it, without waiting
+ * for it to finish. The point is overlap: with a draw and a clear returning early (0011)
+ * but one wait per command buffer, a frame costs the CPU's part plus the GPU's part; with
+ * the wait moved to the next commit it costs the larger of the two. 1125x2436 measured
+ * 8.9 ms of CPU and 17.2 ms of GPU a frame (logs/xnu-0163n.txt).
+ *
+ * The fence is dropped on purpose. A submission nobody waits on cannot be certified by a
+ * fence nobody keeps, and keeping one would be a resource held per command buffer for a
+ * promise no caller reads. The submission itself is already made: freedreno's flush
+ * submits the batch on this thread and keeps the last fence in the context, so the next
+ * rwa_finish -- which flushes again and, with nothing new queued, reuses that fence --
+ * waits for exactly this work. That is the contract: after rwa_flush the GPU has the work
+ * and the CPU must not read, rewrite or destroy anything that work named until an
+ * rwa_finish has returned.
+ */
 int
+rwa_flush(struct rwa_device *device, char *why, size_t why_size)
+{
+   struct pipe_fence_handle *fence = NULL;
+
+   if (!device)
+      return -1;
+   device->pipe->flush(device->pipe, &fence, 0);
+   if (device->passlog)
+      device->passlog_flushes++;   /* 0013 */
+   if (!fence) {
+      /* No submission at all, so there is nothing the next finish could wait for: said
+       * rather than left to look like a frame that simply has not finished yet. */
+      say(why, why_size, "the GPU driver gave no submission for the queued work, so it "
+                         "cannot be waited for later either");
+      return -1;
+   }
+   device->screen->fence_reference(device->screen, &fence, NULL);
+   return 0;
+}
