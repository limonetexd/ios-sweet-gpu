 /*
+ * 0016: whether -commit returns once its work is submitted (the default) or pays the GPU fence
+ * itself, as it did before. Boot-arg sweetmetal_commitwait=1 is the control for an A/B inside
+ * one image: with it a frame costs the CPU's part plus the GPU's; without it, the larger of
+ * the two, because the previous command buffer's fence is paid by the next commit.
+ *
+ * Said once per process. A library without rwa_flush cannot submit without waiting, so it
+ * keeps the old path whatever the boot-arg says.
+ */
+#define RW_COMMITWAIT_KEY "sweetmetal_commitwait="
+
+static bool
+rw_commit_no_wait(void)
+{
+	static dispatch_once_t once;
+	static bool enabled;
+
+	dispatch_once(&once, ^{
+		char args[1024] = "";
+		size_t size = sizeof(args) - 1;
+		const char *at = NULL;
+
+		if (sysctlbyname("kern.bootargs", args, &size, NULL, 0) == 0) {
+			for (at = args; (at = strstr(at, RW_COMMITWAIT_KEY)) != NULL;
+			     at += strlen(RW_COMMITWAIT_KEY)) {
+				if (at == args || at[-1] == ' ') {
+					break;
+				}
+			}
+		}
+		bool forced = at != NULL && at[strlen(RW_COMMITWAIT_KEY)] == '1';
+		enabled = !forced && mesa.flush != NULL && mesa.finish != NULL &&
+			  mesa.set_deferred_wait != NULL;
+		rw_print("GPU commit: %s\n", enabled ?
+			 "returns once the work is submitted; its fence is paid by the next "
+			 "commit or by -waitUntilCompleted (sweetmetal_commitwait=1 pays it "
+			 "inside -commit)" :
+			 forced ? "waits for the GPU (forced by boot-arg sweetmetal_commitwait=1)" :
+				  "waits for the GPU (this library has no rwa_flush)");
+	});
+	return enabled;
+}
