+	 * them out (IOSurfaceAddress, below), never rounded.
+	 */
+	bool exact_rows = props->getObject("IOSurfaceAddress") != NULL;
+	s->bytesPerRow = sweet_rows(sweet_dict_u32(props, "IOSurfaceBytesPerRow", 0),
+	    s->width, s->elementWidth, s->bytesPerElement, props->getCount(), exact_rows);
 	if (s->bytesPerRow < (uint64_t)sweet_div_up(s->width, s->elementWidth) * s->bytesPerElement) {
 		return kIOReturnBadArgument;
 	}
