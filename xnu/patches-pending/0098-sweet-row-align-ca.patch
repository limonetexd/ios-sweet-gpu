--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -389,12 +389,35 @@ sweet_div_up(uint32_t a, uint32_t b)
 }
 
 static uint32_t
-sweet_row_bytes(uint32_t width, uint32_t ew, uint32_t bpe)
+sweet_row_align(uint64_t row)
 {
-	uint64_t row = (uint64_t)sweet_div_up(width, ew) * bpe;
 	return (uint32_t)((row + SWEET_SURFACE_ROW_ALIGN - 1) & ~(uint64_t)(SWEET_SURFACE_ROW_ALIGN - 1));
 }
 
+static uint32_t
+sweet_row_bytes(uint32_t width, uint32_t ew, uint32_t bpe)
+{
+	return sweet_row_align((uint64_t)sweet_div_up(width, ew) * bpe);
+}
+
+/*
+ * 0098 (ios-sailfish 0162): rows for an explicit value (0: none, as above).
+ * A GPU render target needs 64-byte rows: SpringBoard asks for 833 px in 3360
+ * bytes and Mesa then refuses or misdraws it. CoreAnimation takes the real
+ * value from the lock result, so rounding is safe for its surfaces. A creator
+ * that fills the surface itself (CoreUI's glyph atlases: six keys or fewer)
+ * keeps the rows it asked for. Memory around a client address (exact) does
+ * too: its layout belongs to whoever allocated it.
+ */
+static uint32_t
+sweet_rows(uint32_t asked, uint32_t width, uint32_t ew, uint32_t bpe, unsigned int keys, bool exact)
+{
+	if (asked == 0) {
+		return sweet_row_bytes(width, ew, bpe);
+	}
+	return (keys <= 6 || exact) ? asked : sweet_row_align(asked);
+}
+
 /* Geometry from the creation properties (IOSurface.h keys). */
 static IOReturn
 sweet_surface_layout(SweetSurface *s, OSDictionary *props)
