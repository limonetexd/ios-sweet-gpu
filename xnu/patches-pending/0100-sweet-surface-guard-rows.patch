 OSDefineMetaClassAndStructors(SweetSurface, OSObject);
 
+/*
+ * 0100 (ios-topaz 0932/0940): bytes to give the pixels, with 64 rows of guard
+ * behind the last one. The GPU writes whole tiles: rows past the height (2436 is
+ * no multiple of a tile) land after the surface, in whatever pages follow. A
+ * client that already allocated more than its rows need (the screen surface
+ * comes with 2.8 MB spare) uses that; otherwise the rest is added here.
+ */
+static uint64_t
+sweet_surface_take_size(const SweetSurface *s)
+{
+	uint64_t take = s->allocSize;
+
+	if (s->bytesPerElement == 4 && s->planeCount <= 1 && s->elementHeight != 0) {
+		uint64_t rows = ((uint64_t)s->height + s->elementHeight - 1) / s->elementHeight;
+		uint64_t need = (uint64_t)s->bytesPerRow * (rows + 64);
+		if (need > take && need <= SWEET_SURFACE_MAX_ALLOC) {
+			take = round_page_64(need);
+		}
+	}
+	return take;
+}
