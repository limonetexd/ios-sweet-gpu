+ if (!error && !index[1]) error = ERANGE;
+ if (!error) {
+  *vote = (levels[0][index[0]] << 16) | (index[1] << 8) | index[0];
+  *mx_level = levels[1][index[1]];
+ }
+ __atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+ return error;
+}
