+		return EINVAL;
+	}
+	unsigned used = n;
+	for (unsigned i = 0; i < n; ++i) {
+		uint16_t value = rh_db16(res->aux + i * RH_ARC_LEVEL_SIZE);
+		if (i > 0 && value == 0) {
+			used = i;
+			for (unsigned j = i + 1; j < n; ++j) {
+				if (rh_db16(res->aux + j * RH_ARC_LEVEL_SIZE)) {
+					return EINVAL; /* nonzero data after padding */
