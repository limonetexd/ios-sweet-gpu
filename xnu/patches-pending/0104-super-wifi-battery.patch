+/*
+ * 0166: set the calendar from the PM6150 RTC (Linux rtc-pm8xxx, pm8941 layout: control 0x6046 bit 7
+ * enabled, seconds 0x6048-0x604b little endian; re-read when the low byte moved). Without it every
+ * boot's calendar starts at the epoch and kern.boottime is the same ~40 s each boot; wland's auto
+ * start compares it with /var/local/wland.boot and exits "already started in this boot" whenever
+ * it repeats (0145c, 0153, 0154: no Wi-Fi). Only when the calendar is still before 2001.
+ */
+static void
+sweetSetCalendarFromRtc(void)
+{
+	clock_sec_t now = 0;
+	clock_usec_t us = 0;
+	clock_get_calendar_microtime(&now, &us);
+	if (now > 978307200) {
+		return;
+	}
