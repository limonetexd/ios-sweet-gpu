+int
+sweet_rpmh_arc_raise(const char *res, unsigned target_vlvl)
+{
+	if (!res || (strcmp(res, "gfx.lvl") && strcmp(res, "mx.lvl")) || target_vlvl == 0) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	struct rh_res found = {0};
+	uint32_t level[RH_ARC_MAX_LEVELS] = {0};
+	unsigned count = 0;
+	uint32_t before = 0xffffffffu, after = 0xffffffffu;
+	unsigned selector = 0;
+
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing ARC raise\n");
+		goto out;
+	}
+	if (!rh_touch_ready) {
+		error = EAGAIN;
+		printf("SWEET RPMH: ARC raise deferred: L11C has not completed\n");
+		goto out;
+	}
+	error = rh_arc_read_locked(res, &found, level, &count, &before);
+	if (error) {
+		goto out;
+	}
+	printf("SWEET RPMH: ARC %s raise before=%#x table-count=%u target-vlvl=%u\n",
+	    res, before, count, target_vlvl);
+	if (before >= count) {
+		printf("SWEET RPMH: ARC %s reply is not a table index; refusing write\n", res);
+		error = EINVAL;
+		goto out;
+	}
+	if (level[before] >= target_vlvl) {
+		printf("SWEET RPMH: ARC %s already at/above vlvl=%u; no write\n",
+		    res, level[before]);
+		error = 0;
+		goto out;
+	}
+	for (selector = 0; selector < count; ++selector) {
+		if (level[selector] >= target_vlvl) {
+			break;
+		}
+	}
+	if (selector == 0 || selector >= count) {
+		printf("SWEET RPMH: ARC %s no safe selector >= target; refusing write\n", res);
+		error = ERANGE;
+		goto out;
+	}
+	printf("SWEET RPMH: ARC %s raise selector=%u vlvl=%u from=%#x vlvl=%u\n",
+	    res, selector, level[selector], before, level[before]);
+	{
+		const uint32_t offset = 0;
+		const uint32_t value = selector;
+		error = rh_send_cmds(res, found.addr, 3u, &offset, &value, 1,
+		    RH_ARC_TIMEOUT_US, NULL);
+	}
+	if (error) {
+		goto out;
+	}
+	error = rh_arc_read_locked(res, &found, level, &count, &after);
+	if (error) {
+		goto out;
+	}
+	printf("SWEET RPMH: ARC %s raise after=%#x expected=%u\n",
+	    res, after, selector);
+	if (after != selector) {
+		printf("SWEET RPMH: ARC %s raise readback mismatch; no retry, no GPUCC access\n", res);
+		error = EIO;
+	} else if (after >= count) {
+		printf("SWEET RPMH: ARC %s raise readback index outside table; no retry\n", res);
+		error = EIO;
+	} else {
+		printf("SWEET RPMH: ARC %s raise verified selector=%u vlvl=%u\n",
+		    res, selector, level[after]);
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: ARC raise %s failed errno=%d\n", res, error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
+
+/*
+ * 0149 opt-in (sweetsmmuprobe=1): vote SN15+CN0, then read the apps SMMU's
+ * ID registers from a thread of its own, logging before each read so a stall
+ * is visible as the last line. Votes stay in place for wland's SMMU step.
+ */
+/*
+ * 0153 (sweetsmmuwlan=1): wland's smmu_wlan_identity() done here at boot,
+ * where the apps-SMMU reads work, so wland (told by the boot-arg) never
+ * touches the SMMU. Same policy: WLAN SID 0x240 mask 1 -> the lowest free SMR
+ * and a free context bank with translation off (CBAR 0x1f000 = S1 translate,
+ * S2 bypass as ABL's banks; CBA2R AArch64; SCTLR 0xe0 = fault reporting, M=0).
+ */
+#define SMMU_WLAN_SID   0x240u
+#define SMMU_WLAN_MASK  0x1u
+static bool
+smmu_sid_match(uint32_t smr, uint32_t sid, uint32_t mask)
+{
+	uint32_t id = smr & 0x7fff, m = (smr >> 16) & 0x7fff;
+	return ((id ^ sid) & ~(m | mask) & 0x7fff) == 0;
+}
+static void
+sweet_smmu_wlan_stream(volatile uint32_t *gr0, uint32_t id0, uint32_t id1)
+{
+	const uint32_t nsmr = id0 & 0xff, ncb = id1 & 0xff;
+	const uint64_t psize = (id1 >> 31) ? 0x10000 : 0x1000, npage = 1ull << (((id1 >> 28) & 7) + 1);
+	if (psize != 0x1000 || nsmr > 128 || ncb > 128 || (npage + ncb) * psize > 0x100000) {
+		printf("SWEET SMMU: WLAN stream: unexpected geometry smr=%u cb=%u page=%#llx x %llu\n", nsmr, ncb, psize, npage);
+		return;
+	}
+	volatile uint32_t *gr1 = (volatile uint32_t *)ml_io_map(0x15000000 + psize, psize);
+	if (!gr1) {
+		return;
+	}
+	uint64_t used[2] = {0, 0};
+	int slot = -1;
+	for (uint32_t i = 0; i < nsmr; i++) {
+		const uint32_t smr = gr0[(0x800 + 4 * i) / 4], s2cr = gr0[(0xc00 + 4 * i) / 4];
+		if (!(smr >> 31)) {
+			if (slot < 0) {
+				slot = (int)i;
+			}
+			continue;
+		}
+		if (((s2cr >> 16) & 3) == 0) {
+			used[(s2cr & 0xff) / 64] |= 1ull << ((s2cr & 0xff) % 64);
+		}
+		if (smmu_sid_match(smr, SMMU_WLAN_SID, SMMU_WLAN_MASK)) {
+			printf("SWEET SMMU: WLAN stream: SMR%u %#x already matches (S2CR %#x)\n", i, smr, s2cr);
+			return;
+		}
+	}
+	int cb = -1;
+	volatile uint32_t *cbp = NULL;
+	for (uint32_t c = 0; c < ncb && cb < 0; c++) {
+		if (used[c / 64] & (1ull << (c % 64)) || gr1[c] != 0) {
+			continue;
+		}
+		volatile uint32_t *page = (volatile uint32_t *)ml_io_map(0x15000000 + (npage + c) * psize, psize);
+		if (page && !(page[0] & 1)) {
+			cb = (int)c;
+			cbp = page;
+		}
+	}
+	if (slot < 0 || cb < 0) {
+		printf("SWEET SMMU: WLAN stream: no free SMR/bank (SMR %d, bank %d)\n", slot, cb);
+		return;
+	}
+	cbp[0x58 / 4] = 0xffffffff;     /* FSR clear */
+	cbp[0x20 / 4] = 0;              /* TTBR0 */
+	cbp[0x24 / 4] = 0;
+	cbp[0x30 / 4] = 0;              /* TCR */
+	cbp[0x10 / 4] = 0;              /* TCR2 */
+	cbp[0x38 / 4] = 0;              /* MAIR */
+	cbp[0x3c / 4] = 0;
+	gr1[(0x800 + 4 * cb) / 4] = 0x00000001;          /* CBA2R: AArch64 */
+	gr1[cb] = 0x0001f000;                             /* CBAR */
+	cbp[0] = 0x000000e0;                              /* SCTLR last */
+	gr0[(0xc00 + 4 * slot) / 4] = (uint32_t)cb;       /* S2CR: translate via the bank */
+	gr0[(0x800 + 4 * slot) / 4] = (1u << 31) | (SMMU_WLAN_MASK << 16) | SMMU_WLAN_SID;
+	gr0[0x70 / 4] = 0;                                /* sTLBGSYNC */
+	for (int i = 0; i < 1000 && (gr0[0x74 / 4] & 1); i++) {
+		delay(1000);
+	}
+	const uint32_t smr = gr0[(0x800 + 4 * slot) / 4], s2cr = gr0[(0xc00 + 4 * slot) / 4];
+	const bool ok = (smr >> 31) && smmu_sid_match(smr, SMMU_WLAN_SID, SMMU_WLAN_MASK) &&
+	    ((s2cr >> 16) & 3) == 0 && (s2cr & 0xff) == (uint32_t)cb;
+	printf("SWEET SMMU: WLAN %#x/%#x -> CB%d via SMR%d: SMR %#x S2CR %#x SCTLR %#x CBAR %#x -> %s\n",
+	    SMMU_WLAN_SID, SMMU_WLAN_MASK, cb, slot, smr, s2cr, cbp[0], gr1[cb], ok ? "ok" : "NOT as written");
+}
+
+/*
+ * 0180: read-only. Which SMRs route the display controller (MDSS, DT iommus
+ * SID 0x800 mask 0x440) and how its context bank translates, so a page-flip
+ * present knows whether scanout addresses are physical (bypass or SCTLR.M=0)
+ * or go through an ABL page table (TTBR0).
+ */
+#define SMMU_MDSS_SID   0x800u
+#define SMMU_MDSS_MASK  0x440u
+static void
+sweet_smmu_dump_mdss(volatile uint32_t *gr0, uint32_t id0, uint32_t id1)
+{
+	const uint32_t nsmr = id0 & 0xff, ncb = id1 & 0xff;
+	const uint64_t psize = (id1 >> 31) ? 0x10000 : 0x1000, npage = 1ull << (((id1 >> 28) & 7) + 1);
+	if (psize != 0x1000 || nsmr > 128 || ncb > 128 || (npage + ncb) * psize > 0x100000) {
+		printf("SWEET SMMU: MDSS: unexpected geometry\n");
+		return;
+	}
+	volatile uint32_t *gr1 = (volatile uint32_t *)ml_io_map(0x15000000 + psize, psize);
+	unsigned found = 0;
+	for (uint32_t i = 0; i < nsmr; i++) {
+		const uint32_t smr = gr0[(0x800 + 4 * i) / 4], s2cr = gr0[(0xc00 + 4 * i) / 4];
+		if (!(smr >> 31)) {
+			continue;
+		}
+		const uint32_t id = smr & 0x7fff, m = (smr >> 16) & 0x7fff;
+		/* Overlaps the MDSS stream group: some SID matches both. */
+		if (((id ^ SMMU_MDSS_SID) & ~(m | SMMU_MDSS_MASK) & 0x7fff) != 0) {
+			continue;
+		}
+		found++;
+		const uint32_t type = (s2cr >> 16) & 3, cb = s2cr & 0xff;
+		if (type != 0 || cb >= ncb || gr1 == NULL) {
+			printf("SWEET SMMU: MDSS SMR%u %#x S2CR %#x (type %u: %s)\n", i, smr, s2cr, type,
+			    type == 1 ? "bypass" : type == 2 ? "fault" : "translate");
+			continue;
+		}
+		volatile uint32_t *cbp = (volatile uint32_t *)ml_io_map(0x15000000 + (npage + cb) * psize, psize);
+		if (cbp == NULL) {
+			continue;
+		}
+		printf("SWEET SMMU: MDSS SMR%u %#x S2CR %#x -> CB%u CBAR %#x CBA2R %#x SCTLR %#x TTBR0 %#x%08x TCR %#x TCR2 %#x MAIR %#x,%#x FSR %#x FAR %#x%08x\n",
+		    i, smr, s2cr, cb, gr1[cb], gr1[(0x800 + 4 * cb) / 4], cbp[0], cbp[0x24 / 4], cbp[0x20 / 4],
+		    cbp[0x30 / 4], cbp[0x10 / 4], cbp[0x38 / 4], cbp[0x3c / 4], cbp[0x58 / 4], cbp[0x64 / 4], cbp[0x60 / 4]);
+	}
+	printf("SWEET SMMU: MDSS %#x/%#x: %u matching SMRs\n", SMMU_MDSS_SID, SMMU_MDSS_MASK, found);
+}
+
+static void
+sweet_smmu_probe_thread(void *arg, wait_result_t wr)
+{
+	(void)wr;
+	extern void IOSleep(unsigned);
+	const int votes = (int)(uintptr_t)arg;
+	IOSleep(1000);
+	printf("SWEET SMMU: votes %s; reading apps SMMU sCR0/ID0/ID1 next\n", votes ? "failed" : "held");
+	volatile uint32_t *smmu = (volatile uint32_t *)ml_io_map(0x15000000, 0x1000);
+	if (!smmu) {
+		printf("SWEET SMMU: map failed\n");
+		return;
+	}
+	const uint32_t scr0 = smmu[0];
+	printf("SWEET SMMU: sCR0=%#x\n", scr0);
+	const uint32_t id0 = smmu[0x20 / 4], id1 = smmu[0x24 / 4], id2 = smmu[0x28 / 4];
+	printf("SWEET SMMU: ID0=%#x ID1=%#x ID2=%#x: %u SMRs, %u context banks\n", id0, id1, id2, id0 & 0xff, id1 & 0xff);
+	extern uint32_t sweet_pmem_probe_read(uint64_t pa);
+	printf("SWEET SMMU: reading ID0 through the /dev/pmem window path next\n");
+	printf("SWEET SMMU: pmem-path ID0=%#x\n", sweet_pmem_probe_read(0x15000020));
+	int wlan = 0;
+	PE_parse_boot_argn("sweetsmmuwlan", &wlan, sizeof(wlan));
+	if (wlan) {
+		sweet_smmu_wlan_stream(smmu, id0, id1);
+	}
+	sweet_smmu_dump_mdss(smmu, id0, id1);
+}
+
+void sweet_smmu_probe_start(void);
+void
+sweet_smmu_probe_start(void)
+{
+	int on = 0;
+	PE_parse_boot_argn("sweetsmmuprobe", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	/* 0150: vote now, in bsd init, so the path is up before launchd can start
+	 * wland (0139: the 20 s-later votes made the first apps-SMMU reads work). */
+	const int sn = sweet_rpmh_bcm_vote("SN15", 1, 1), cn = sweet_rpmh_bcm_vote("CN0", 1, 1);
+	printf("SWEET SMMU: votes SN15=%d CN0=%d\n", sn, cn);
+	thread_t thread = THREAD_NULL;
+	if (kernel_thread_start(sweet_smmu_probe_thread, (void *)(uintptr_t)(sn || cn), &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+		printf("SWEET SMMU: apps SMMU probe armed (1 s)\n");
+	}
+}
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * 0169: memory bandwidth. Nothing here voted for DRAM; the frames stayed at ~300 Mpx/s of GPU fill
+ * whatever the GPU clock, tiling or shaders (0154-0158 hardware). HackiOS (oosexgang/hackios-xnu-kernel,
+ * bsd/dev/hakios.cpufreq.c ddr_raise(), Poco X5 Pro) casts what Linux's interconnect driver casts for a
+ * busy GPU: the memory controller's BCM (MC0) and the shared hub with the system cache (SH0) at the
+ * most there is (commit, valid, average and peak 14 bits each), and ACV with the apps bit (8): their
+ * Control Center 46 -> 59 frames/s, Settings opening 29 -> 37. sweetddr=0: no vote; sweetddrvote=N:
+ * N instead of 0x3fff.
+ */
+void sweet_rpmh_ddr_raise(void);
+void
+sweet_rpmh_ddr_raise(void)
+{
+	uint32_t on = 1, vote = 0x3fff;
+	PE_parse_boot_argn("sweetddr", &on, sizeof(on));
+	PE_parse_boot_argn("sweetddrvote", &vote, sizeof(vote));
+	if (!on || vote == 0 || vote > 0x3fff) {
+		printf("SWEET DDR: no memory bandwidth vote (sweetddr=%u, vote %u)\n", on, vote);
+		return;
+	}
+	const int mc0 = sweet_rpmh_bcm_vote("MC0", vote, vote);
+	const int sh0 = sweet_rpmh_bcm_vote("SH0", vote, vote);
+	const int acv = sweet_rpmh_bcm_vote("ACV", 0, 8);
+	printf("SWEET DDR: memory bandwidth vote %u: MC0 %d, SH0 %d, ACV %d\n", vote, mc0, sh0, acv);
+}
+#endif
