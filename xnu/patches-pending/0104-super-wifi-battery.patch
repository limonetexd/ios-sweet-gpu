+/*
+ * Bluetooth rails (bsd/dev/sweet_bt.c, sweet DT bt_wcn3990): vdd-io L10A, xtal L1C, core L2C,
+ * pa L10C, each within its DT range; voltage, HPM, then enable, like vreg_enable. Only "on":
+ * an APPS "off" vote also drops what ABL voted through this DRV (Bergamota boot 0116hw).
+ */
+int sweet_rpmh_vreg_set(const char *res, unsigned mv, bool enable);
+int
+sweet_rpmh_vreg_set(const char *res, unsigned mv, bool enable)
+{
+	static const struct { const char *name; unsigned min_mv, max_mv; } bt[] = {
+		{ "ldoa10", 1704, 1900 }, { "ldoc1", 1704, 1900 }, { "ldoc2", 1245, 1350 }, { "ldoc10", 3200, 3400 },
+	};
+	bool ok = false;
+	for (unsigned i = 0; res && i < sizeof(bt) / sizeof(bt[0]); i++) {
+		ok |= !strcmp(res, bt[i].name) && mv >= bt[i].min_mv && mv <= bt[i].max_mv;
+	}
+	if (!ok || !enable) {
+		printf("SWEET RPMH: BT rail vote %s %u mV %s refused\n", res ? res : "(null)", mv, enable ? "on" : "off");
+		return EPERM;
+	}
+	for (unsigned tries = 0; __atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE); tries++) {
+		if (tries >= 200) {
+			return EBUSY;
+		}
+		delay(1000);
+	}
+	int error = EIO;
+	struct rh_res found = {0};
+	if (!rh_poisoned) {
+		error = rh_map();
+		if (!error) {
+			error = rh_lookup(res, RH_VRM, &found);
+		}
+		if (!error) {
+			const uint32_t offsets[3] = {0, 8, 4};
+			const uint32_t values[3] = {mv, 7, 1};
+			error = rh_send_cmds(res, found.addr, 15u, offsets, values, 3, RH_TIMEOUT_US, NULL);
+		}
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
