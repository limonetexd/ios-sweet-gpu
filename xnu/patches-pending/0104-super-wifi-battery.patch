+{
+	static const struct { const char *name; unsigned min_mv, max_mv; } rails[] = {
+		{ "ldoa9", 624, 760 }, { "ldoc1", 1616, 1984 }, { "ldoc2", 1200, 1352 }, { "ldoc10", 3200, 3312 },
+	};
+	if (!res || !offsets || !values || n == 0 || n > 4) {
+		return EINVAL;
+	}
+	int rail = -1;
+	for (unsigned i = 0; i < sizeof(rails) / sizeof(rails[0]); ++i) {
+		if (!strcmp(res, rails[i].name)) {
+			rail = (int)i;
+		}
+	}
+	const bool clock = !strcmp(res, "rfclka2");
+	const bool arc = !strcmp(res, "cx.lvl") || !strcmp(res, "mss.lvl");
+	if (rail < 0 && !clock && !arc) {
+		printf("SWEET RPMH: userland vote for %s refused (not a Wi-Fi/modem resource)\n", res);
+		return EPERM;
+	}
+	for (unsigned i = 0; i < n; ++i) {
+		const uint32_t o = offsets[i], v = values[i];
+		const bool ok = arc ? (o == 0 && v < RH_ARC_MAX_LEVELS) :
+		    clock ? (o == 4 && v <= 1) :
+		    ((o == 0 && v >= rails[rail].min_mv && v <= rails[rail].max_mv) || (o == 4 && v <= 1) || (o == 8 && v == 7));
+		if (!ok) {
+			printf("SWEET RPMH: userland vote %s offset %#x value %u refused\n", res, o, v);
+			return EPERM;
+		}
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	struct rh_res found = {0};
+	uint32_t level[RH_ARC_MAX_LEVELS] = {0};
+	unsigned count = 0;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing userland vote\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup(res, arc ? RH_ARC : RH_VRM, &found);
+	}
+	if (!error && arc) {
+		error = rh_arc_levels(&found, level, &count);
+		if (!error && values[0] >= count) {
+			error = ERANGE;
+		}
+	}
+	if (!error) {
+		error = rh_send_cmds(res, found.addr, arc ? 3u : 15u, offsets, values, n,
+		    arc ? RH_ARC_TIMEOUT_US : RH_TIMEOUT_US, NULL);
+	}
+out:
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
