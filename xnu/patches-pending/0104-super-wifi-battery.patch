diff --git a/bsd/dev/flame_sta.c b/bsd/dev/flame_sta.c
new file mode 100644
index 0000000..7e40bda
--- /dev/null
+++ b/bsd/dev/flame_sta.c
@@ -0,0 +1,242 @@
+/*
+ * flame: the station side of sys/redwood_sta.h (ios-topaz 0900's topaz_sta.c) over the WCN3990 radio,
+ * which runs in userland (phone/wifi wland) and reaches the kernel through bsd/dev/flame_wlan.c (its
+ * C API, flame_wlan_*, the one topaz_wlan_* was). When wland says the radio is up, en0 is made (a radio,
+ * link down until a join) and the station attached, so that wifid finds a Wi-Fi interface.
+ */
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <pexpert/pexpert.h>
+#include <sys/errno.h>
+#include <sys/redwood_net.h>
+#include <sys/redwood_sta.h>
+#include <sys/systm.h>
+
+extern kern_return_t thread_terminate(thread_t thread);
+
+struct flame_wlan_bss {
+	uint8_t bssid[6];
+	uint8_t ssid[32], ssid_length;
+	uint16_t frequency;
+	int16_t rssi;
+	uint16_t beacon_interval, capability;
+	uint32_t age_ms;
+	uint16_t elements_length;
+	uint8_t elements[768];
+};
+extern void (*flame_wlan_ready_hook)(void);
+extern bool flame_wlan_ready(void);
+extern int flame_wlan_scan(void);
+extern bool flame_wlan_heard(unsigned index, struct flame_wlan_bss *bss);
+extern void flame_wlan_address(uint8_t address[6]);
+extern int flame_wlan_join(const uint8_t *ssid, unsigned ssid_len, const uint8_t *bssid, const uint8_t *pass, unsigned pass_len);
+extern int flame_wlan_join_pmk(const uint8_t *ssid, unsigned ssid_len, const uint8_t *bssid, const uint8_t pmk[32]);
+extern int flame_wlan_leave(void);
+extern bool flame_wlan_joined(void);
+extern bool flame_wlan_transmit(const uint8_t *frame, size_t length);
+extern void (*flame_wlan_rx_hook)(const uint8_t *frame, size_t length);
+extern void (*flame_wlan_link_hook)(bool up);
+extern bool flame_wlan_link_bss(struct flame_wlan_bss *bss);
+
+static struct redwood_sta_bss sta_joined_bss;
+static int sta_last_error;
+
+static const uint16_t sta_freqs[] = {
+	2412, 2417, 2422, 2427, 2432, 2437, 2442, 2447, 2452, 2457, 2462, 2467, 2472,
+	5180, 5200, 5220, 5240, 5260, 5280, 5300, 5320,
+	5500, 5520, 5540, 5560, 5580, 5600, 5620, 5640, 5660, 5680, 5700,
+	5745, 5765, 5785, 5805, 5825,
+};
+
+static int
+sta_power(__unused bool on)
+{
+	return 0;                               /* the radio stays up with the modem */
+}
+
+static int
+sta_scan(__unused const struct redwood_sta_scan *what)
+{
+	return flame_wlan_scan();
+}
+
+static void
+sta_heard(void (*each)(const struct redwood_sta_bss *bss, void *context), void *context)
+{
+	static struct flame_wlan_bss t;
+	static struct redwood_sta_bss b;
+
+	for (unsigned i = 0; flame_wlan_heard(i, &t); i++) {
+		if (t.age_ms > 60000) {
+			continue;                       /* not heard in the last minute */
+		}
+		bzero(&b, sizeof(b));
+		memcpy(b.bssid, t.bssid, 6);
+		memcpy(b.ssid, t.ssid, t.ssid_length);
+		b.ssid_length = t.ssid_length;
+		b.frequency = t.frequency;
+		b.rssi = t.rssi;
+		b.beacon_interval = t.beacon_interval;
+		b.capability = t.capability;
+		b.age_ms = t.age_ms;
+		b.elements_length = t.elements_length < REDWOOD_STA_ELEMENTS_MOST ? t.elements_length : REDWOOD_STA_ELEMENTS_MOST;
+		memcpy(b.elements, t.elements, b.elements_length);
+		each(&b, context);
+	}
+}
+
+static int
+sta_join(const struct redwood_sta_join *what)
+{
+	static struct flame_wlan_bss t;
+	bool any = false;
+	int error;
+
+	for (int i = 0; i < 6; i++) {
+		any |= what->bssid[i] != 0;
+	}
+	if (what->security == REDWOOD_STA_WPA2_PSK && what->passphrase_length == 0) {
+		error = flame_wlan_join_pmk(what->ssid, what->ssid_length, any ? what->bssid : NULL, what->pmk);
+	} else error = flame_wlan_join(what->ssid, what->ssid_length, any ? what->bssid : NULL,
+	    what->security == REDWOOD_STA_WPA2_PSK ? what->passphrase : NULL,
+	    what->security == REDWOOD_STA_WPA2_PSK ? what->passphrase_length : 0);
+	sta_last_error = error;
+	bzero(&sta_joined_bss, sizeof(sta_joined_bss));
+	if (error == 0) {
+		for (unsigned i = 0; flame_wlan_heard(i, &t); i++) {
+			if (t.ssid_length == what->ssid_length && memcmp(t.ssid, what->ssid, t.ssid_length) == 0) {
+				memcpy(sta_joined_bss.bssid, t.bssid, 6);
+				memcpy(sta_joined_bss.ssid, t.ssid, t.ssid_length);
+				sta_joined_bss.ssid_length = t.ssid_length;
+				sta_joined_bss.frequency = t.frequency;
+				sta_joined_bss.rssi = t.rssi;
+				sta_joined_bss.beacon_interval = t.beacon_interval;
+				sta_joined_bss.capability = t.capability;
+				sta_joined_bss.elements_length = t.elements_length < REDWOOD_STA_ELEMENTS_MOST ? t.elements_length : REDWOOD_STA_ELEMENTS_MOST;
+				memcpy(sta_joined_bss.elements, t.elements, sta_joined_bss.elements_length);
+				break;
+			}
+		}
+	}
+	printf("flame wifi: join -> %d\n", error);
+	return error;
+}
+
+static int
+sta_leave(void)
+{
+	return flame_wlan_leave();
+}
+
+static void
+sta_state(struct redwood_sta_state *state)
+{
+	bzero(state, sizeof(*state));
+	state->phase = flame_wlan_joined() ? REDWOOD_STA_JOINED : REDWOOD_STA_IDLE;
+	if (state->phase == REDWOOD_STA_JOINED) {
+		state->bss = sta_joined_bss;
+		if (state->bss.ssid_length == 0) {
+			/* flame: wland joined by itself (its wlan.conf, before wifid asked): the network it reports */
+			struct flame_wlan_bss t;        /* (on any thread: not static) */
+			if (flame_wlan_link_bss(&t)) {
+				memcpy(state->bss.bssid, t.bssid, 6);
+				memcpy(state->bss.ssid, t.ssid, t.ssid_length);
+				state->bss.ssid_length = t.ssid_length;
+				state->bss.frequency = t.frequency;
+				state->bss.rssi = t.rssi;
+				state->bss.beacon_interval = t.beacon_interval;
+				state->bss.capability = t.capability;
+				state->bss.elements_length = t.elements_length < REDWOOD_STA_ELEMENTS_MOST ? t.elements_length : REDWOOD_STA_ELEMENTS_MOST;
+				memcpy(state->bss.elements, t.elements, state->bss.elements_length);
+			}
+		}
+	}
+	state->last_error = sta_last_error;
+}
+
+static unsigned
+sta_channels(struct redwood_sta_channel *channels, unsigned most)
+{
+	unsigned n = 0;
+	for (; n < most && n < sizeof(sta_freqs) / sizeof(sta_freqs[0]); n++) {
+		channels[n].frequency = sta_freqs[n];
+		channels[n].flags = REDWOOD_STA_CHANNEL_PASSIVE;
+	}
+	return n;
+}
+
+static struct redwood_sta_ops sta_ops = {
+	.power = sta_power,
+	.scan = sta_scan,
+	.heard = sta_heard,
+	.join = sta_join,
+	.leave = sta_leave,
+	.state = sta_state,
+	.channels = sta_channels,
+};
+
+static bool
+sta_transmit(mbuf_t packet, size_t length)
+{
+	static uint8_t frame[REDWOOD_NET_FRAME_MAX];   /* (one sender at a time: redwood_net's tx lock) */
+	if (length > sizeof(frame) || mbuf_copydata(packet, 0, length, frame) != 0) {
+		return false;
+	}
+	return flame_wlan_transmit(frame, length);
+}
+
+static void
+sta_rx(const uint8_t *frame, size_t length)
+{
+	redwood_net_input(frame, length);
+}
+
+static void
+sta_link_changed(bool up)
+{
+	redwood_net_link_state(up);
+	if (!up && sta_last_error == 0) {
+		redwood_sta_lost(ECONNRESET);
+	}
+}
+
+static struct redwood_net_link sta_link = {
+	.name = "wcn3990",
+	.wireless = true,
+	.up = false,
+	.transmit = sta_transmit,
+	.poll = NULL,
+};
+
+/* from the modem thread, once the radio is up: keep it short, the work goes on a thread */
+static void
+sta_bring_up(__unused void *arg, __unused wait_result_t wr)
+{
+	flame_wlan_address(sta_link.address);
+	memcpy(sta_ops.address, sta_link.address, 6);
+	flame_wlan_rx_hook = sta_rx;
+	flame_wlan_link_hook = sta_link_changed;
+	if (redwood_net_attach(&sta_link)) {
+		redwood_sta_attach(&sta_ops);
+		printf("flame wifi: en0 and the station are up for iOS\n");
+	}
+	thread_terminate(current_thread());
+}
+
+static void
+sta_ready(void)
+{
+	thread_t thread;
+	if (kernel_thread_start(sta_bring_up, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+void MiniIONetworkStackStart(void);   /* iokit/Kernel/arm/MiniIONetworkStack.cpp */
+void flame_sta_init(void);
+void
+flame_sta_init(void)
+{
+	MiniIONetworkStackStart();              /* configd waits for it before it calls the registry quiet */
+	flame_wlan_ready_hook = sta_ready;
+}
diff --git a/bsd/dev/flame_wlan.c b/bsd/dev/flame_wlan.c
new file mode 100644
index 0000000..7bac497
--- /dev/null
+++ b/bsd/dev/flame_wlan.c
@@ -0,0 +1,442 @@
+/*
+ * flame: the WCN3990 radio for the kernel's Wi-Fi station. bsd/dev/flame_sta.c (ios-topaz 0900's topaz_sta.c)
+ * puts en0 and wifid's Apple80211 requests (bsd/dev/redwood_*.c) on this file's flame_wlan_* C API, the one
+ * TopazModem.cpp offers there. The radio itself runs in userland (phone/wifi: wland), which opens /dev/wlan
+ * once it is up; sys/flame_wlan.h is the protocol, one message per read() or write().
+ *
+ * The station's requests (scan, join, leave) are queued for wland and each waits for its answer; frames en0
+ * sends are queued too (dropped when the queue is full). What wland writes back wakes the waiter, or goes to
+ * en0 (received frames) and the link hook. When wland closes the device the link is down and waiters fail.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/conf.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <sys/vnode.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+#include <sys/flame_wlan.h>
+
+void flame_wlan_init(void);
+void flame_sta_init(void);              /* bsd/dev/flame_sta.c */
+void redwood_net_init(void);            /* bsd/dev/redwood_net.c: its boot-args */
+
+/* as bsd/dev/flame_sta.c declares it (topaz_wlan_bss) */
+struct flame_wlan_bss {
+	uint8_t bssid[6];
+	uint8_t ssid[32], ssid_length;
+	uint16_t frequency;
+	int16_t rssi;
+	uint16_t beacon_interval, capability;
+	uint32_t age_ms;
+	uint16_t elements_length;
+	uint8_t elements[768];
+};
+
+void (*flame_wlan_ready_hook)(void);
+void (*flame_wlan_rx_hook)(const uint8_t *frame, size_t length);
+void (*flame_wlan_link_hook)(bool up);
+
+static LCK_GRP_DECLARE(fw_grp, "flame-wlan");
+static LCK_MTX_DECLARE(fw_lock, &fw_grp);
+
+#define FW_QLEN         64
+#define FW_PENDING      INT32_MIN
+static struct {
+	uint16_t type, len;
+	uint8_t data[FW_MSG_MAX - sizeof(struct fw_hdr)];
+} fw_q[FW_QLEN];
+static unsigned fw_q_head, fw_q_count;
+static uint64_t fw_tx_dropped;
+
+static bool fw_opened, fw_ready, fw_link_up;
+static uint8_t fw_addr[6];
+static struct fw_link fw_link;          /* the network of the last FW_LINK up */
+#define FW_BSS_MAX      64
+static struct flame_wlan_bss fw_bss[FW_BSS_MAX];
+static unsigned fw_nbss;
+static int32_t fw_scan_status = FW_PENDING, fw_join_status = FW_PENDING, fw_left_status = FW_PENDING;
+
+/* with fw_lock */
+static bool
+fw_queue_locked(uint16_t type, const void *data, size_t len)
+{
+	if (fw_q_count >= FW_QLEN || len > sizeof(fw_q[0].data)) {
+		return false;
+	}
+	unsigned i = (fw_q_head + fw_q_count) % FW_QLEN;
+	fw_q[i].type = type;
+	fw_q[i].len = (uint16_t)len;
+	if (len) {
+		memcpy(fw_q[i].data, data, len);
+	}
+	fw_q_count++;
+	wakeup(&fw_q_count);
+	return true;
+}
+
+/* A request of the station: queued for wland, then its answer (0 or an errno) within `secs`. */
+static int
+fw_request(uint16_t type, const void *data, size_t len, int32_t *status, int secs)
+{
+	lck_mtx_lock(&fw_lock);
+	if (!fw_opened) {
+		lck_mtx_unlock(&fw_lock);
+		return ENXIO;
+	}
+	*status = FW_PENDING;
+	if (!fw_queue_locked(type, data, len)) {
+		lck_mtx_unlock(&fw_lock);
+		return ENOBUFS;
+	}
+	struct timespec ts = { secs, 0 };
+	while (*status == FW_PENDING && fw_opened) {
+		if (msleep(status, &fw_lock, PZERO, "flamewlan", &ts) == EWOULDBLOCK) {
+			break;
+		}
+	}
+	int rc = *status != FW_PENDING ? *status : fw_opened ? ETIMEDOUT : ENXIO;
+	lck_mtx_unlock(&fw_lock);
+	return rc;
+}
+
+/* ---- the C API of bsd/dev/flame_sta.c ---- */
+
+bool flame_wlan_ready(void);
+int flame_wlan_scan(void);
+bool flame_wlan_heard(unsigned index, struct flame_wlan_bss *bss);
+void flame_wlan_address(uint8_t address[6]);
+int flame_wlan_join(const uint8_t *ssid, unsigned ssid_len, const uint8_t *bssid, const uint8_t *pass, unsigned pass_len);
+int flame_wlan_join_pmk(const uint8_t *ssid, unsigned ssid_len, const uint8_t *bssid, const uint8_t pmk[32]);
+int flame_wlan_leave(void);
+bool flame_wlan_joined(void);
+bool flame_wlan_transmit(const uint8_t *frame, size_t length);
+
+bool
+flame_wlan_ready(void)
+{
+	return fw_ready;
+}
+
+int
+flame_wlan_scan(void)
+{
+	return fw_request(FW_SCAN, NULL, 0, &fw_scan_status, 20);
+}
+
+bool
+flame_wlan_heard(unsigned index, struct flame_wlan_bss *bss)
+{
+	lck_mtx_lock(&fw_lock);
+	bool have = index < fw_nbss;
+	if (have) {
+		memcpy(bss, &fw_bss[index], sizeof(*bss));
+	}
+	lck_mtx_unlock(&fw_lock);
+	return have;
+}
+
+void
+flame_wlan_address(uint8_t address[6])
+{
+	memcpy(address, fw_addr, 6);
+}
+
+static int
+fw_join(const uint8_t *ssid, unsigned ssid_len, const uint8_t *bssid, uint8_t kind, const uint8_t *key, unsigned key_len)
+{
+	struct fw_join j;
+	bzero(&j, sizeof(j));
+	if (ssid_len == 0 || ssid_len > sizeof(j.ssid) || key_len > sizeof(j.key)) {
+		return EINVAL;
+	}
+	memcpy(j.ssid, ssid, ssid_len);
+	j.ssid_len = (uint8_t)ssid_len;
+	if (bssid != NULL) {
+		memcpy(j.bssid, bssid, 6);
+	} else {
+		j.any_bssid = 1;
+	}
+	j.key_kind = kind;
+	j.key_len = (uint8_t)key_len;
+	if (key_len) {
+		memcpy(j.key, key, key_len);
+	}
+	return fw_request(FW_JOIN, &j, sizeof(j), &fw_join_status, 40);
+}
+
+int
+flame_wlan_join(const uint8_t *ssid, unsigned ssid_len, const uint8_t *bssid, const uint8_t *pass, unsigned pass_len)
+{
+	return fw_join(ssid, ssid_len, bssid, pass != NULL && pass_len ? FW_KEY_PASSPHRASE : FW_KEY_NONE, pass,
+	           pass != NULL ? pass_len : 0);
+}
+
+int
+flame_wlan_join_pmk(const uint8_t *ssid, unsigned ssid_len, const uint8_t *bssid, const uint8_t pmk[32])
+{
+	return fw_join(ssid, ssid_len, bssid, FW_KEY_PMK, pmk, 32);
+}
+
+int
+flame_wlan_leave(void)
+{
+	return fw_request(FW_LEAVE, NULL, 0, &fw_left_status, 10);
+}
+
+bool
+flame_wlan_joined(void)
+{
+	return fw_link_up;
+}
+
+/* the network joined, as the last scan heard it (or by name alone): for a join wland made by itself */
+bool flame_wlan_link_bss(struct flame_wlan_bss *bss);
+bool
+flame_wlan_link_bss(struct flame_wlan_bss *bss)
+{
+	lck_mtx_lock(&fw_lock);
+	bool have = fw_link_up && fw_link.ssid_len > 0;
+	if (have) {
+		bzero(bss, sizeof(*bss));
+		unsigned i;
+		for (i = 0; i < fw_nbss && memcmp(fw_bss[i].bssid, fw_link.bssid, 6) != 0; i++) {
+		}
+		if (i < fw_nbss) {
+			memcpy(bss, &fw_bss[i], sizeof(*bss));
+		} else {
+			memcpy(bss->bssid, fw_link.bssid, 6);
+			memcpy(bss->ssid, fw_link.ssid, sizeof(bss->ssid));
+			bss->ssid_length = fw_link.ssid_len > 32 ? 32 : fw_link.ssid_len;
+		}
+	}
+	lck_mtx_unlock(&fw_lock);
+	return have;
+}
+
+bool
+flame_wlan_transmit(const uint8_t *frame, size_t length)
+{
+	lck_mtx_lock(&fw_lock);
+	bool ok = fw_opened && fw_link_up && fw_queue_locked(FW_TX, frame, length);
+	if (!ok) {
+		fw_tx_dropped++;
+	}
+	lck_mtx_unlock(&fw_lock);
+	return ok;
+}
+
+/* ---- /dev/wlan ---- */
+
+static int
+fw_open(__unused dev_t dev, __unused int flags, __unused int devtype, __unused proc_t p)
+{
+	lck_mtx_lock(&fw_lock);
+	int rc = fw_opened ? EBUSY : 0;
+	if (rc == 0) {
+		fw_opened = true;
+		fw_q_head = fw_q_count = 0;
+	}
+	lck_mtx_unlock(&fw_lock);
+	return rc;
+}
+
+static int
+fw_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused proc_t p)
+{
+	lck_mtx_lock(&fw_lock);
+	bool was_up = fw_link_up;
+	fw_opened = false;
+	fw_link_up = false;
+	fw_q_head = fw_q_count = 0;
+	wakeup(&fw_scan_status);
+	wakeup(&fw_join_status);
+	wakeup(&fw_left_status);
+	wakeup(&fw_q_count);
+	lck_mtx_unlock(&fw_lock);
+	printf("flame wlan: the radio's side closed /dev/wlan (%llu frames dropped)\n", fw_tx_dropped);
+	if (was_up && flame_wlan_link_hook != NULL) {
+		flame_wlan_link_hook(false);
+	}
+	return 0;
+}
+
+static int
+fw_read(__unused dev_t dev, struct uio *uio, int ioflag)
+{
+	static uint8_t buf[FW_MSG_MAX];         /* one reader: wland */
+	lck_mtx_lock(&fw_lock);
+	while (fw_q_count == 0) {
+		if (ioflag & IO_NDELAY) {
+			lck_mtx_unlock(&fw_lock);
+			return EWOULDBLOCK;
+		}
+		int e = msleep(&fw_q_count, &fw_lock, PZERO | PCATCH, "fwread", NULL);
+		if (e) {
+			lck_mtx_unlock(&fw_lock);
+			return e;
+		}
+	}
+	struct fw_hdr h = { fw_q[fw_q_head].type, fw_q[fw_q_head].len };
+	if (uio_resid(uio) < (user_ssize_t)(sizeof(h) + h.len)) {
+		lck_mtx_unlock(&fw_lock);
+		return EMSGSIZE;
+	}
+	memcpy(buf, &h, sizeof(h));
+	memcpy(buf + sizeof(h), fw_q[fw_q_head].data, h.len);
+	fw_q_head = (fw_q_head + 1) % FW_QLEN;
+	fw_q_count--;
+	lck_mtx_unlock(&fw_lock);
+	return uiomove((caddr_t)buf, (int)(sizeof(h) + h.len), uio);
+}
+
+static void
+fw_wake_status(int32_t *status, const uint8_t *p, size_t len)
+{
+	int32_t v = EIO;
+	if (len >= sizeof(v)) {
+		memcpy(&v, p, sizeof(v));
+	}
+	lck_mtx_lock(&fw_lock);
+	*status = v;
+	wakeup(status);
+	lck_mtx_unlock(&fw_lock);
+}
+
+static int
+fw_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	static uint8_t buf[FW_MSG_MAX];         /* one writer: wland */
+	user_ssize_t n = uio_resid(uio);
+	struct fw_hdr h;
+	if (n < (user_ssize_t)sizeof(h) || n > (user_ssize_t)sizeof(buf)) {
+		return EINVAL;
+	}
+	int e = uiomove((caddr_t)buf, (int)n, uio);
+	if (e) {
+		return e;
+	}
+	memcpy(&h, buf, sizeof(h));
+	const uint8_t *p = buf + sizeof(h);
+	if (h.len != n - (user_ssize_t)sizeof(h)) {
+		return EINVAL;
+	}
+	switch (h.type) {
+	case FW_HELLO: {
+		if (h.len < sizeof(struct fw_hello)) {
+			return EINVAL;
+		}
+		bool first = !fw_ready;
+		memcpy(fw_addr, ((const struct fw_hello *)p)->address, 6);
+		fw_ready = true;
+		printf("flame wlan: the radio is up (%02x:%02x:%02x:%02x:%02x:%02x)%s\n", fw_addr[0], fw_addr[1], fw_addr[2],
+		    fw_addr[3], fw_addr[4], fw_addr[5], first ? ": en0 for wifid" : "");
+		if (first && flame_wlan_ready_hook != NULL) {
+			flame_wlan_ready_hook();
+		}
+		break;
+	}
+	case FW_BSS_BEGIN:
+		lck_mtx_lock(&fw_lock);
+		fw_nbss = 0;
+		lck_mtx_unlock(&fw_lock);
+		break;
+	case FW_BSS: {
+		const struct fw_bss *b = (const struct fw_bss *)p;
+		if (h.len < sizeof(*b)) {
+			return EINVAL;
+		}
+		lck_mtx_lock(&fw_lock);
+		if (fw_nbss < FW_BSS_MAX) {
+			struct flame_wlan_bss *t = &fw_bss[fw_nbss++];
+			memcpy(t->bssid, b->bssid, 6);
+			memcpy(t->ssid, b->ssid, sizeof(t->ssid));
+			t->ssid_length = b->ssid_len > 32 ? 32 : b->ssid_len;
+			t->frequency = b->frequency;
+			t->rssi = b->rssi;
+			t->beacon_interval = b->beacon_interval;
+			t->capability = b->capability;
+			t->age_ms = b->age_ms;
+			t->elements_length = b->elements_len > sizeof(t->elements) ? sizeof(t->elements) : b->elements_len;
+			memcpy(t->elements, b->elements, t->elements_length);
+		}
+		lck_mtx_unlock(&fw_lock);
+		break;
+	}
+	case FW_SCAN_DONE:
+		fw_wake_status(&fw_scan_status, p, h.len);
+		break;
+	case FW_JOIN_DONE:
+		fw_wake_status(&fw_join_status, p, h.len);
+		break;
+	case FW_LEFT:
+		fw_wake_status(&fw_left_status, p, h.len);
+		break;
+	case FW_LINK: {
+		bool up = h.len >= 1 && p[0] != 0;
+		lck_mtx_lock(&fw_lock);
+		bool changed = up != fw_link_up;
+		fw_link_up = up;
+		if (up && h.len >= sizeof(fw_link)) {
+			memcpy(&fw_link, p, sizeof(fw_link));
+		}
+		lck_mtx_unlock(&fw_lock);
+		if (changed && flame_wlan_link_hook != NULL) {
+			flame_wlan_link_hook(up);
+		}
+		break;
+	}
+	case FW_RX:
+		if (h.len >= 14 && h.len <= FW_FRAME_MAX && flame_wlan_rx_hook != NULL) {
+			flame_wlan_rx_hook(p, h.len);
+		}
+		break;
+	default:
+		return EINVAL;
+	}
+	return 0;
+}
+
+static const struct cdevsw fw_cdevsw = {
+	.d_open       = fw_open,
+	.d_close      = fw_close,
+	.d_read       = fw_read,
+	.d_write      = fw_write,
+	.d_ioctl      = eno_ioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = 0,
+};
+
+/* Boot-arg sweetwifid=0: no /dev/wlan, no en0 (wland keeps its own utun). */
+void
+flame_wlan_init(void)
+{
+	uint32_t on = 1;
+	PE_parse_boot_argn("sweetwifid", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	int major = cdevsw_add(-1, &fw_cdevsw);
+	if (major < 0) {
+		printf("flame wlan: cdevsw_add failed (%d)\n", major);
+		return;
+	}
+	devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0600, "wlan");
+	redwood_net_init();
+	flame_sta_init();
+	printf("flame wlan: /dev/wlan ready (major %d)\n", major);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/redwood_apple80211.c b/bsd/dev/redwood_apple80211.c
new file mode 100644
index 0000000..e2674ee
--- /dev/null
+++ b/bsd/dev/redwood_apple80211.c
@@ -0,0 +1,739 @@
+/*
+ * Darwin-on-redwood: Apple80211, answered in the kernel.
+ *
+ * iOS's Wi-Fi side -- wifid, and through it Settings and the status bar -- talks to a Wi-Fi
+ * driver in requests that were once ioctls and are, where the driver offers no user client,
+ * ioctls still: SIOCGA80211 and SIOCSA80211 on any socket, with a struct apple80211req that
+ * names the interface, a request type, a value, and a buffer in the caller's memory
+ * (IO80211.framework: Apple80211Get/Set and their kin all end there). XNU hands an interface
+ * ioctl it does not know to the interface, so they arrive in bsd/dev/redwood_net.c, which
+ * passes them here when its link is a radio.
+ *
+ * What is asked is answered from the station boundary (sys/redwood_sta.h): the radio's power,
+ * its channels, a scan and what it heard, the network joined. What happens there by itself is
+ * told to iOS the way a driver tells it: kernel events of class 6 (IEEE 802.11), subclass 1,
+ * whose code is Apple80211's own event number and whose data begins with the interface's name
+ * in 16 bytes (IO80211.framework reads them from a PF_SYSTEM socket and compares the name).
+ *
+ * Every request is still written to the log -- who asks, get or set, the type, the value, the
+ * length -- because which of them wifid needs is found that way. Never what a request carries:
+ * a network's name or its key may be in there.
+ *
+ * The request types and the layouts are Apple's. The old ones are as the headers of its open
+ * IO80211 sources once described them (apple80211_ioctl.h, apple80211_var.h); where iOS 16.5
+ * differs the layout was read out of IO80211.framework of 16.5, which fills and reads the same
+ * structures on the other side (Apple80211GetWithIOCTL, _getScanData, _addScanResultToList,
+ * _performAssociation, _dispatchAsyncAssocEvent, _dispatchLinkChangedEvent).
+ *
+ * A join: ASSOCIATE (20) carries the network's name, perhaps its access point, and the
+ * passphrase as typed (the framework does not make the key of it), and is answered at once;
+ * when the station has joined or failed, event 9 says so, and ASSOCIATE_RESULT (21) gives the
+ * outcome as one of Apple80211's result numbers, which the framework turns into its errors:
+ * 1 success, 21 "invalid PMK" (a wrong passphrase), 9 a timeout, 2 anything else.
+ */
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <libkern/libkern.h>
+#include <sys/errno.h>
+#include <sys/kern_event.h>
+#include <sys/kernel.h>
+#include <sys/proc.h>
+#include <sys/redwood_input.h>
+#include <sys/redwood_net.h>
+#include <sys/redwood_sta.h>
+#include <sys/sockio.h>
+#include <sys/systm.h>
+
+#define SIOCSA80211             0x802869c8u     /* _IOW('i', 200, struct apple80211req) */
+#define SIOCGA80211             0xc02869c9u     /* _IOWR('i', 201, struct apple80211req) */
+
+struct apple80211req {
+	char req_if_name[16];
+	int32_t req_type;
+	int32_t req_val;
+	uint32_t req_len;
+	user_addr_t req_data __attribute__((aligned(8)));
+};
+
+/* (as far as they have come by: the names help reading the log) */
+static const char *
+type_name(int32_t type)
+{
+	static const struct {
+		int32_t type;
+		const char *name;
+	} names[] = {
+		{ 1, "SSID" }, { 2, "AUTH_TYPE" }, { 3, "CIPHER_KEY" }, { 4, "CHANNEL" }, { 5, "POWERSAVE" }, { 6, "PROTMODE" },
+		{ 7, "TXPOWER" }, { 8, "RATE" }, { 9, "BSSID" }, { 10, "SCAN_REQ" }, { 11, "SCAN_RESULT" }, { 12, "CARD_CAPABILITIES" },
+		{ 13, "STATE" }, { 14, "PHY_MODE" }, { 15, "OP_MODE" }, { 16, "RSSI" }, { 17, "NOISE" }, { 18, "INT_MIT" }, { 19, "POWER" },
+		{ 20, "ASSOCIATE" }, { 21, "ASSOCIATE_RESULT" }, { 22, "DISASSOCIATE" }, { 23, "STATUS_DEV_NAME" }, { 24, "IBSS_MODE" },
+		{ 25, "HOST_AP_MODE" }, { 26, "AP_MODE" }, { 27, "SUPPORTED_CHANNELS" }, { 28, "LOCALE" }, { 29, "DEAUTH" },
+		{ 30, "COUNTERMEASURES" }, { 32, "RATE_SET" }, { 42, "STATION_LIST" }, { 43, "DRIVER_VERSION" },
+		{ 44, "HARDWARE_VERSION" }, { 46, "RSN_IE" }, { 47, "BACKGROUND_SCAN" }, { 48, "AP_IE_LIST" }, { 49, "STATS" },
+		{ 50, "ASSOCIATION_STATUS" }, { 51, "COUNTRY_CODE" }, { 54, "RADIO_INFO" }, { 57, "MCS" }, { 66, "MCS_INDEX_SET" },
+		{ 79, "STA_STATS" }, { 80, "ROAM_THRESH" }, { 85, "IE" }, { 86, "SCAN_REQ_MULTIPLE" }, { 87, "BTCOEX_MODE" },
+		{ 90, "SCANCACHE_CLEAR" }, { 94, "VIRTUAL_IF_CREATE" }, { 95, "VIRTUAL_IF_DELETE" }, { 103, "CURRENT_NETWORK" },
+		{ 106, "RSSI_BOUNDS" }, { 107, "ROAM" }, { 207, "CHANNELS_INFO" }, { 254, "HW_SUPPORTED_CHANNELS" },
+	};
+
+	for (unsigned i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+		if (names[i].type == type) {
+			return names[i].name;
+		}
+	}
+	return "?";
+}
+
+/* ---- the layouts ------------------------------------------------------------------------------------------ */
+
+#define CHANNEL_20MHZ           0x2u
+#define CHANNEL_2GHZ            0x8u
+#define CHANNEL_5GHZ            0x10u
+#define CHANNEL_ACTIVE          0x80u           /* the radio may send there */
+#define CHANNEL_DFS             0x100u
+
+struct apple80211_channel {
+	uint32_t version, channel, flags;
+};
+
+/* SUPPORTED_CHANNELS (27) and HW_SUPPORTED_CHANNELS (254): 4824 bytes */
+struct apple80211_channels {
+	uint32_t version, count;
+	struct apple80211_channel channels[401];
+	uint32_t unused;
+};
+
+/* CHANNELS_INFO (207): 10016 bytes; of each channel a byte in each of several rows, and a word of flags */
+struct apple80211_channels_info {
+	uint8_t unknown_0[12];
+	uint16_t count;
+	uint8_t unknown_1[800];
+	uint8_t number[400], indoor[400], dfs[400], passive[400], wide_40[400], wide_80[400];
+	uint8_t unknown_2[1602];
+	uint32_t flags[400];
+	uint8_t unknown_3[3600];
+} __attribute__((packed));
+
+/* SCAN_REQ (10): 5456 bytes */
+struct apple80211_scan_request {
+	uint32_t version, bss_type;
+	uint8_t bssid[6], unused_0[2];
+	uint32_t ssid_length;
+	uint8_t ssid[32];
+	uint32_t scan_type;                     /* 1: asking, 2: listening only */
+	uint32_t phy_mode;
+	uint16_t dwell_ms, unused_1;
+	uint32_t rest_ms;
+	uint32_t channel_count;
+	struct apple80211_channel channels[400];
+	uint64_t flags;
+	uint32_t unused_2;
+	uint32_t name_count;                    /* networks asked for by name, each in 56 bytes */
+	uint8_t names[10][56];
+	uint32_t short_ssid, unused_3;
+};
+
+/* SCAN_RESULT (11) and CURRENT_NETWORK (103): 1164 bytes */
+struct apple80211_scan_result {
+	uint32_t version;
+	struct apple80211_channel channel;
+	uint16_t noise_known;
+	int16_t noise, snr, rssi;
+	uint16_t beacon_interval, capability;
+	uint8_t bssid[6];
+	uint8_t rate_count, unused_0;
+	uint32_t rates[15];                     /* Mbit/s */
+	uint8_t ssid_length, ssid[32], unused_1[3];
+	uint32_t age_ms;
+	uint8_t flags, unused_2;
+	uint16_t elements_length;               /* comes in as the room there is */
+	uint8_t elements[1024];
+};
+
+/* ASSOCIATE (20): 592 bytes; of what follows the key (the RSN element wifid built, flags) nothing is used */
+struct apple80211_assoc {
+	uint32_t version;
+	uint16_t mode, auth_lower, auth_upper, unused_0;
+	uint32_t ssid_length;
+	uint8_t ssid[32];
+	uint8_t bssid[6], unused_1[2];
+	uint32_t key_version, key_length, key_cipher;   /* cipher 10: a passphrase as typed; 6: the key (from 64 hex digits) */
+	uint16_t key_flags, key_index;
+	uint8_t key[64];
+	uint8_t rest[0x250 - 0x88];
+};
+
+#define CIPHER_PMK              6
+#define CIPHER_PASSPHRASE       10
+
+/* the link event's data (at least 32 bytes, or the framework drops the event) */
+struct apple80211_link_changed {
+	uint8_t down, unused_0[3];
+	int32_t rssi;
+	uint16_t snr, noise;
+	uint8_t unused_1[4];
+	uint8_t involuntary, unused_2[3];
+	uint32_t reason, subreason;
+	uint8_t unused_3[4];
+};
+
+_Static_assert(sizeof(struct apple80211_assoc) == 592 && offsetof(struct apple80211_assoc, key) == 0x48,
+    "the association request as iOS 16.5 has it");
+_Static_assert(sizeof(struct apple80211_link_changed) == 32 && offsetof(struct apple80211_link_changed, reason) == 0x14,
+    "the link event as iOS 16.5 reads it");
+_Static_assert(sizeof(struct apple80211_channels) == 4824, "the channel list as iOS 16.5 has it");
+_Static_assert(sizeof(struct apple80211_channels_info) == 10016 && offsetof(struct apple80211_channels_info, number) == 0x32e &&
+    offsetof(struct apple80211_channels_info, flags) == 0x12d0, "the channels' description as iOS 16.5 has it");
+_Static_assert(sizeof(struct apple80211_scan_request) == 5456 && offsetof(struct apple80211_scan_request, channels) == 0x48 &&
+    offsetof(struct apple80211_scan_request, flags) == 0x1308 && offsetof(struct apple80211_scan_request, names) == 0x1318,
+    "the scan request as iOS 16.5 has it");
+_Static_assert(sizeof(struct apple80211_scan_result) == 1164 && offsetof(struct apple80211_scan_result, ssid_length) == 0x60 &&
+    offsetof(struct apple80211_scan_result, age_ms) == 0x84 && offsetof(struct apple80211_scan_result, elements) == 0x8c,
+    "a scan's result as iOS 16.5 has it");
+
+/* Apple80211's events (APPLE80211_M_...) */
+enum { EVENT_POWER_CHANGED = 1, EVENT_SSID_CHANGED = 2, EVENT_BSSID_CHANGED = 3, EVENT_LINK_CHANGED = 4, EVENT_ASSOC_DONE = 9,
+       EVENT_SCAN_DONE = 10 };
+
+static const char interface_name[16] = "en0";   /* (bsd/dev/redwood_net.c makes one interface, and that is its name) */
+
+static LCK_GRP_DECLARE(apple80211_lock_group, "redwood-apple80211");
+static LCK_MTX_DECLARE(apple80211_lock, &apple80211_lock_group);
+static unsigned result_next;                    /* which of what the last scan heard a SCAN_RESULT request gets next */
+static uint32_t join_result;                    /* of the last join asked for: 0 while it runs, then Apple80211's number */
+
+/* ---- channels ---------------------------------------------------------------------------------------- */
+
+static unsigned
+channel_number(unsigned frequency)
+{
+	return frequency == 2484 ? 14 : frequency < 4000 ? (frequency - 2407) / 5 : (frequency - 5000) / 5;
+}
+
+static unsigned
+channel_frequency(const struct apple80211_channel *channel)
+{
+	bool low = channel->flags & CHANNEL_2GHZ ? true : channel->flags & CHANNEL_5GHZ ? false : channel->channel <= 14;
+
+	if (channel->channel == 0 || channel->channel > 196 || (channel->flags & 0x2000)) {     /* (0x2000: 6 GHz) */
+		return 0;
+	}
+	return low ? (channel->channel == 14 ? 2484 : 2407 + 5 * channel->channel) : 5000 + 5 * channel->channel;
+}
+
+static void
+channel_fill(struct apple80211_channel *channel, unsigned frequency, unsigned flags)
+{
+	channel->version = 1;
+	channel->channel = channel_number(frequency);
+	channel->flags = CHANNEL_20MHZ | (frequency < 4000 ? CHANNEL_2GHZ : CHANNEL_5GHZ) | (flags & REDWOOD_STA_CHANNEL_PASSIVE ?
+	    0 : CHANNEL_ACTIVE) | (flags & REDWOOD_STA_CHANNEL_RADAR ? CHANNEL_DFS : 0);
+}
+
+/* ---- what the caller is given back ------------------------------------------------------------------- */
+
+/* At most as many bytes as it has room for. */
+static int
+give(const struct apple80211req *request, const void *data, size_t length)
+{
+	return request->req_data == USER_ADDR_NULL ? 0 : copyout(data, request->req_data, length < request->req_len ? length :
+	       request->req_len);
+}
+
+/* An access point in the form a scan's result has; the caller has said how much room for elements there is. */
+static int
+give_network(const struct apple80211req *request, const struct redwood_sta_bss *bss)
+{
+	struct apple80211_scan_result *result = kalloc_data(sizeof(*result), Z_WAITOK | Z_ZERO);
+	unsigned room = sizeof(result->elements);
+	int error;
+
+	if (result == NULL) {
+		return ENOMEM;
+	}
+	if (request->req_len >= sizeof(*result) && copyin(request->req_data, result, offsetof(struct apple80211_scan_result,
+	    elements)) == 0 && result->elements_length < room) {
+		room = result->elements_length;
+	}
+	bzero(result, sizeof(*result));
+	result->version = 1;
+	channel_fill(&result->channel, bss->frequency, 0);
+	result->rssi = bss->rssi;
+	result->beacon_interval = bss->beacon_interval;
+	result->capability = bss->capability;
+	memcpy(result->bssid, bss->bssid, sizeof(result->bssid));
+	result->ssid_length = bss->ssid_length;
+	memcpy(result->ssid, bss->ssid, bss->ssid_length);
+	result->age_ms = bss->age_ms;
+	result->elements_length = (uint16_t)(bss->elements_length <= room ? bss->elements_length : 0);
+	memcpy(result->elements, bss->elements, result->elements_length);
+	/* the rates it says it has (elements 1 and 50: units of 500 kbit/s, the top bit marks the ones everybody must have) */
+	for (unsigned at = 0; at + 2 <= bss->elements_length && at + 2 + bss->elements[at + 1] <= bss->elements_length;
+	    at += 2 + bss->elements[at + 1]) {
+		for (unsigned i = 0; (bss->elements[at] == 1 || bss->elements[at] == 50) && i < bss->elements[at + 1]; i++) {
+			unsigned rate = (bss->elements[at + 2 + i] & 0x7f) / 2;
+
+			if (rate != 0 && rate <= 54 && result->rate_count < 15) {
+				result->rates[result->rate_count++] = rate;
+			}
+		}
+	}
+	error = give(request, result, sizeof(*result));
+	kfree_data(result, sizeof(*result));
+	return error;
+}
+
+/* ---- get ---------------------------------------------------------------------------------------------- */
+
+static int
+get(struct apple80211req *request)
+{
+	struct redwood_sta_state *state;
+	int error = 0;
+
+	switch (request->req_type) {
+	case 43:
+	case 44: {                              /* the driver's and the hardware's name: the text alone, in 256 bytes */
+		static const char name[256] = "redwood: ath11k for the WCN6750";
+
+		return give(request, name, sizeof(name));
+	}
+	case 12: {
+		/*
+		 * What the card can do, a bit each (apple80211_var.h: APPLE80211_CAP_*): the 13 bytes are the
+		 * bits alone, from the first (the framework hands in a buffer that begins after the old
+		 * header's version word). AES, AES-CCM, power management, short slot and preamble, WPA2, WME,
+		 * short guard interval at 20 MHz. Read wrong, the framework sees no WPA2 and builds no join
+		 * for a WPA2 network ("Unable to join").
+		 */
+		uint8_t bits[13] = { 0 };
+		static const uint8_t has[] = { 2, 3, 6, 9, 10, 14, 17, 19 };
+
+		for (unsigned i = 0; i < sizeof(has); i++) {
+			bits[has[i] / 8] |= (uint8_t)(1u << (has[i] % 8));
+		}
+		return give(request, bits, sizeof(bits));
+	}
+	case 19: {                              /* the radio's power: one radio. Until the driver is up it counts as on: it */
+		struct {                        /* is being brought up, and iOS asks this once, early */
+			uint32_t version, radios, state[4];
+		} answer = { .version = 1, .radios = 1, .state = { !redwood_sta_present() || redwood_sta_powered() } };
+
+		return give(request, &answer, sizeof(answer));
+	}
+	case 15:                                /* the mode: a station (APPLE80211_M_STA) */
+		request->req_val = 1;
+		return 0;
+	case 27:
+	case 254: {                             /* the channels the radio may tune to */
+		struct apple80211_channels *answer;
+		struct redwood_sta_channel channels[96];
+		unsigned count = redwood_sta_channels(channels, 96);
+
+		if (count == 0 || (answer = kalloc_data(sizeof(*answer), Z_WAITOK | Z_ZERO)) == NULL) {
+			return count == 0 ? ENXIO : ENOMEM;
+		}
+		answer->version = 1;
+		answer->count = count;
+		for (unsigned i = 0; i < count; i++) {
+			channel_fill(&answer->channels[i], channels[i].frequency, channels[i].flags);
+		}
+		error = give(request, answer, sizeof(*answer));
+		kfree_data(answer, sizeof(*answer));
+		return error;
+	}
+	case 207: {                             /* ... and more of each */
+		struct apple80211_channels_info *answer;
+		struct redwood_sta_channel channels[96];
+		unsigned count = redwood_sta_channels(channels, 96);
+
+		if (count == 0 || (answer = kalloc_data(sizeof(*answer), Z_WAITOK | Z_ZERO)) == NULL) {
+			return count == 0 ? ENXIO : ENOMEM;
+		}
+		answer->count = (uint16_t)count;
+		for (unsigned i = 0; i < count; i++) {
+			struct apple80211_channel channel;
+
+			channel_fill(&channel, channels[i].frequency, channels[i].flags);
+			answer->number[i] = (uint8_t)channel.channel;
+			answer->dfs[i] = (channels[i].flags & REDWOOD_STA_CHANNEL_RADAR) != 0;
+			answer->passive[i] = (channels[i].flags & REDWOOD_STA_CHANNEL_PASSIVE) != 0;
+			answer->flags[i] = channel.flags;
+		}
+		error = give(request, answer, sizeof(*answer));
+		kfree_data(answer, sizeof(*answer));
+		return error;
+	}
+	case 21:                                /* how the last join went (0: not over yet) */
+		lck_mtx_lock(&apple80211_lock);
+		request->req_val = (int32_t)join_result;
+		lck_mtx_unlock(&apple80211_lock);
+		return 0;
+	case 11: {                              /* what the last scan heard, one access point a request; EIO: that was all */
+		struct redwood_sta_bss *bss = kalloc_data(sizeof(*bss), Z_WAITOK);
+		unsigned index;
+		bool there;
+
+		if (bss == NULL) {
+			return ENOMEM;
+		}
+		lck_mtx_lock(&apple80211_lock);
+		index = result_next++;
+		lck_mtx_unlock(&apple80211_lock);
+		there = redwood_sta_heard(index, bss);
+		error = there ? give_network(request, bss) : EIO;
+		kfree_data(bss, sizeof(*bss));
+		return error;
+	}
+	default:
+		break;
+	}
+
+	/* the rest is about the network joined, and there is none unless the station says so */
+	if ((state = kalloc_data(sizeof(*state), Z_WAITOK)) == NULL) {
+		return ENOMEM;
+	}
+	redwood_sta_state(state);
+	switch (request->req_type) {
+	case 13:                                /* the state: APPLE80211_S_INIT 0, _SCAN 1, _AUTH 2, _ASSOC 3, _RUN 4 */
+		request->req_val = state->phase == REDWOOD_STA_JOINED ? 4 : state->phase == REDWOOD_STA_JOINING ? 2 :
+		    state->phase == REDWOOD_STA_SCANNING ? 1 : 0;
+		break;
+	case 1:                                 /* its name; the length goes back in the request */
+		if (state->phase != REDWOOD_STA_JOINED) {
+			error = ENXIO;
+		} else if ((error = give(request, state->bss.ssid, state->bss.ssid_length)) == 0) {
+			request->req_len = state->bss.ssid_length;
+		}
+		break;
+	case 9:                                 /* its access point's address */
+		error = state->phase != REDWOOD_STA_JOINED ? ENXIO : give(request, state->bss.bssid, 6);
+		break;
+	case 4: {                               /* its channel */
+		struct {
+			uint32_t version;
+			struct apple80211_channel channel;
+		} answer = { .version = 1 };
+
+		if (state->phase != REDWOOD_STA_JOINED) {
+			error = ENXIO;
+		} else {
+			channel_fill(&answer.channel, state->bss.frequency, 0);
+			error = give(request, &answer, sizeof(answer));
+		}
+		break;
+	}
+	case 16: {                              /* how strongly it is heard: dBm, per radio and all together, twice over */
+		struct {
+			uint32_t version, radios, unit;
+			int32_t each[4], all, each_ext[4], all_ext;
+		} answer = { .version = 1, .radios = 1, .each = { state->bss.rssi }, .all = state->bss.rssi,
+			     .each_ext = { state->bss.rssi }, .all_ext = state->bss.rssi };
+
+		error = state->phase != REDWOOD_STA_JOINED ? ENXIO : give(request, &answer, sizeof(answer));
+		break;
+	}
+	case 103:                               /* all of it, as a scan's result */
+		error = state->phase != REDWOOD_STA_JOINED ? ENXIO : give_network(request, &state->bss);
+		break;
+	case 2: {                               /* how it was joined: open system, then WPA2 with a passphrase */
+		struct {
+			uint32_t version, lower, upper, extended;
+		} answer = { .version = 1, .lower = 1, .upper = 8 };
+
+		error = state->phase != REDWOOD_STA_JOINED ? ENXIO : give(request, &answer, sizeof(answer));
+		break;
+	}
+	default:
+		error = EOPNOTSUPP;
+		break;
+	}
+	kfree_data(state, sizeof(*state));
+	return error;
+}
+
+/* ---- set ---------------------------------------------------------------------------------------------- */
+
+static int
+set_scan(const struct apple80211req *request, char *said, size_t said_size)
+{
+	struct apple80211_scan_request *asked;
+	struct redwood_sta_scan *what;
+	unsigned unknown = 0;
+	int error;
+
+	if (request->req_len != sizeof(*asked)) {
+		return EINVAL;
+	}
+	if (!redwood_sta_present()) {
+		return EBUSY;                   /* (the radio is still being brought up: the framework tries again) */
+	}
+	asked = kalloc_data(sizeof(*asked), Z_WAITOK);
+	what = kalloc_data(sizeof(*what), Z_WAITOK | Z_ZERO);
+	if (asked == NULL || what == NULL || (error = copyin(request->req_data, asked, sizeof(*asked))) != 0) {
+		error = asked == NULL || what == NULL ? ENOMEM : error;
+		goto out;
+	}
+	if (asked->ssid_length <= sizeof(what->ssid)) {
+		what->ssid_length = (uint8_t)asked->ssid_length;
+		memcpy(what->ssid, asked->ssid, asked->ssid_length);
+	}
+	what->passive = asked->scan_type == 2;
+	what->dwell_ms = asked->dwell_ms;
+	/* (more channels than there is room to name: every channel) */
+	for (unsigned i = 0; i < asked->channel_count && i < 400 && asked->channel_count <= 64; i++) {
+		unsigned frequency = channel_frequency(&asked->channels[i]);
+
+		if (frequency != 0) {
+			what->frequencies[what->frequency_count++] = (uint16_t)frequency;
+		} else {
+			unknown++;
+		}
+	}
+	snprintf(said, said_size, " (a scan: type %u, %u channels of which %u are not the radio's, %u ms on each, a name of %u bytes, "
+	    "%u more names, flags %#llx)", asked->scan_type, asked->channel_count, unknown, asked->dwell_ms, asked->ssid_length,
+	    asked->name_count, asked->flags);
+	if (asked->channel_count != 0 && asked->channel_count <= 64 && what->frequency_count == 0) {
+		error = EINVAL;                 /* (nothing of what is asked for is a channel of this radio's) */
+	} else {
+		lck_mtx_lock(&apple80211_lock);
+		result_next = 0;
+		lck_mtx_unlock(&apple80211_lock);
+		error = redwood_sta_ask_scan(what);
+	}
+out:
+	if (asked != NULL) {
+		kfree_data(asked, sizeof(*asked));
+	}
+	if (what != NULL) {
+		kfree_data(what, sizeof(*what));
+	}
+	return error;
+}
+
+static int
+set_join(const struct apple80211req *request, char *said, size_t said_size)
+{
+	struct apple80211_assoc *asked;
+	struct redwood_sta_join *what;
+	int error;
+
+	if (request->req_len < offsetof(struct apple80211_assoc, rest)) {
+		return EINVAL;
+	}
+	asked = kalloc_data(sizeof(*asked), Z_WAITOK | Z_ZERO);
+	what = kalloc_data(sizeof(*what), Z_WAITOK | Z_ZERO);
+	if (asked == NULL || what == NULL || (error = copyin(request->req_data, asked, offsetof(struct apple80211_assoc, rest))) != 0) {
+		error = asked == NULL || what == NULL ? ENOMEM : error;
+		goto out;
+	}
+	/* (lengths and kinds only: the name, the access point and the key stay out of the log) */
+	snprintf(said, said_size, " (a join: a name of %u bytes, %s access point, authentication %#x/%#x, a key of %u bytes of kind %u)",
+	    asked->ssid_length, asked->bssid[0] | asked->bssid[1] | asked->bssid[2] | asked->bssid[3] | asked->bssid[4] |
+	    asked->bssid[5] ? "a given" : "any", asked->auth_lower, asked->auth_upper, asked->key_length, asked->key_cipher);
+	if (asked->ssid_length == 0 || asked->ssid_length > sizeof(what->ssid)) {
+		error = EINVAL;
+		goto out;
+	}
+	what->ssid_length = (uint8_t)asked->ssid_length;
+	memcpy(what->ssid, asked->ssid, asked->ssid_length);
+	memcpy(what->bssid, asked->bssid, sizeof(what->bssid));
+	if (asked->key_length == 0) {
+		what->security = REDWOOD_STA_OPEN;
+	} else if (asked->key_cipher == CIPHER_PASSPHRASE && asked->key_length >= 8 && asked->key_length <= 63) {
+		what->security = REDWOOD_STA_WPA2_PSK;
+		what->passphrase_length = (uint8_t)asked->key_length;
+		memcpy(what->passphrase, asked->key, asked->key_length);
+	} else if (asked->key_cipher == CIPHER_PMK && asked->key_length == sizeof(what->pmk)) {
+		what->security = REDWOOD_STA_WPA2_PSK;
+		memcpy(what->pmk, asked->key, sizeof(what->pmk));
+	} else {
+		error = EINVAL;
+		goto out;
+	}
+	lck_mtx_lock(&apple80211_lock);
+	join_result = 0;
+	lck_mtx_unlock(&apple80211_lock);
+	error = redwood_sta_ask_join(what);
+out:
+	if (asked != NULL) {
+		memset_s(asked, sizeof(*asked), 0, sizeof(*asked));
+		kfree_data(asked, sizeof(*asked));
+	}
+	if (what != NULL) {
+		memset_s(what, sizeof(*what), 0, sizeof(*what));
+		kfree_data(what, sizeof(*what));
+	}
+	return error;
+}
+
+static int
+set(const struct apple80211req *request, char *said, size_t said_size)
+{
+	switch (request->req_type) {
+	case 20:
+		return set_join(request, said, said_size);
+	case 22:                                /* leave the network */
+		return redwood_sta_ask_leave();
+	case 19: {                              /* the radio's power */
+		struct {
+			uint32_t version, radios, state[4];
+		} asked;
+		int error;
+
+		if (request->req_len < sizeof(asked) || (error = copyin(request->req_data, &asked, sizeof(asked))) != 0) {
+			return request->req_len < sizeof(asked) ? EINVAL : error;
+		}
+		snprintf(said, said_size, " (power: %s)", asked.state[0] ? "on" : "off");
+		return redwood_sta_ask_power(asked.state[0] != 0);
+	}
+	case 10:
+		return set_scan(request, said, said_size);
+	default:
+		return EOPNOTSUPP;
+	}
+}
+
+/* ---- events -------------------------------------------------------------------------------------------- */
+
+static void
+post(uint32_t code, const void *data, uint32_t length)
+{
+	struct kev_msg message = { .vendor_code = KEV_VENDOR_APPLE, .kev_class = KEV_IEEE80211_CLASS, .kev_subclass = 1,
+		                   .event_code = code };
+	char name[16];
+
+	memcpy(name, interface_name, sizeof(name));
+	message.dv[0].data_length = sizeof(name);
+	message.dv[0].data_ptr = name;
+	if (length != 0) {
+		message.dv[1].data_length = length;
+		message.dv[1].data_ptr = __DECONST(void *, data);
+	}
+	kev_post_msg(&message);
+}
+
+/* What the station side says has happened (bsd/dev/redwood_sta.c calls this, on its thread or the station's). */
+void
+redwood_apple80211_event(enum redwood_sta_event event, int status)
+{
+	static unsigned said;
+
+	if (said < 200) {
+		said++;
+		printf("apple80211: the station says: %s, %d\n", event == REDWOOD_STA_POWER ? "power" : event == REDWOOD_STA_SCAN_DONE ?
+		    "a scan is over" : event == REDWOOD_STA_JOIN_DONE ? "a join is over" : "the link", status);
+	}
+	switch (event) {
+	case REDWOOD_STA_POWER:
+		post(EVENT_POWER_CHANGED, NULL, 0);
+		break;
+	case REDWOOD_STA_SCAN_DONE:
+		lck_mtx_lock(&apple80211_lock);
+		result_next = 0;
+		lck_mtx_unlock(&apple80211_lock);
+		post(EVENT_SCAN_DONE, NULL, 0);
+		break;
+	case REDWOOD_STA_JOIN_DONE:
+		lck_mtx_lock(&apple80211_lock);
+		join_result = status == 0 ? 1 : status == EAUTH ? 21 : status == ETIMEDOUT ? 9 : 2;
+		lck_mtx_unlock(&apple80211_lock);
+		post(EVENT_ASSOC_DONE, NULL, 0);
+		break;
+	case REDWOOD_STA_LINK: {
+		struct apple80211_link_changed link = { .down = status != 1, .involuntary = status != 1 && status != 0,
+			                                .reason = status != 1 && status != 0 ? 4 : 0 };      /* (4: gone, not asked) */
+		struct redwood_sta_state *state = kalloc_data(sizeof(*state), Z_WAITOK | Z_ZERO);
+
+		if (state != NULL) {
+			redwood_sta_state(state);
+			link.rssi = status == 1 ? state->bss.rssi : 0;
+			kfree_data(state, sizeof(*state));
+		}
+		post(EVENT_SSID_CHANGED, NULL, 0);
+		post(EVENT_BSSID_CHANGED, NULL, 0);
+		post(EVENT_LINK_CHANGED, &link, sizeof(link));
+		break;
+	}
+	}
+}
+
+/* ---- the requests as they arrive --------------------------------------------------------------------- */
+
+/*
+ * How often each kind of request came and how it fared: said when the run ends, because the
+ * lines said along the way can be lost with the middle of a long log.
+ */
+static struct {
+	int32_t type;
+	bool set;
+	unsigned times, answered;
+	int last_error;
+} kinds[96];
+static unsigned kind_count;
+
+static void
+note(const struct apple80211req *request, bool is_set, int error)
+{
+	unsigned i;
+
+	lck_mtx_lock(&apple80211_lock);
+	for (i = 0; i < kind_count && !(kinds[i].type == request->req_type && kinds[i].set == is_set); i++) {
+	}
+	if (i < sizeof(kinds) / sizeof(kinds[0])) {
+		if (i == kind_count) {
+			kinds[kind_count++] = (typeof(kinds[0])) { .type = request->req_type, .set = is_set };
+		}
+		kinds[i].times++;
+		kinds[i].answered += error == 0;
+		kinds[i].last_error = error != 0 ? error : kinds[i].last_error;
+	}
+	lck_mtx_unlock(&apple80211_lock);
+}
+
+void
+redwood_apple80211_summary(void)
+{
+	static bool said;
+
+	if (said) {
+		return;
+	}
+	said = true;
+	for (unsigned i = 0; i < kind_count; i++) {
+		printf("apple80211: in this run: %s %d (%s) %u times, answered %u times%s", kinds[i].set ? "set" : "get", kinds[i].type,
+		    type_name(kinds[i].type), kinds[i].times, kinds[i].answered, kinds[i].last_error == 0 ? "\n" : "");
+		if (kinds[i].last_error != 0) {
+			printf("; the last refusal: %d%s\n", kinds[i].last_error, kinds[i].last_error == EOPNOTSUPP ? " (not built)" : "");
+		}
+	}
+}
+
+/* An Apple80211 request for the radio's interface, from the process that is running now. */
+errno_t
+redwood_apple80211_ioctl(u_long command, void *data)
+{
+	static unsigned said;
+	struct apple80211req *request = data;
+	char who[32] = "?", what[200] = "";
+	bool is_set = command == SIOCSA80211;
+	int error;
+
+	if (command != SIOCSA80211 && command != SIOCGA80211) {
+		return EOPNOTSUPP;
+	}
+	proc_selfname(who, sizeof(who));
+	error = is_set ? set(request, what, sizeof(what)) : get(request);
+	note(request, is_set, error);
+	/* (a request that is repeated for ever is said a few hundred times) */
+	if (said < 800) {
+		said++;
+		printf("apple80211: %s %s %d (%s), value %d, %u bytes%s: %s", who, is_set ? "sets" : "gets", request->req_type,
+		    type_name(request->req_type), request->req_val, request->req_len, what, error == 0 ? "answered\n" : error ==
+		    EOPNOTSUPP ? "REFUSED\n" : "");
+		if (error != 0 && error != EOPNOTSUPP) {
+			printf("error %d\n", error);
+		}
+	}
+	return error;
+}
diff --git a/bsd/dev/redwood_net.c b/bsd/dev/redwood_net.c
new file mode 100644
index 0000000..e7b46fd
--- /dev/null
+++ b/bsd/dev/redwood_net.c
@@ -0,0 +1,376 @@
+/*
+ * en0: a network interface that is Ethernet as far as the rest of the kernel and iOS can tell.
+ *
+ * iOS expects its interfaces from IONetworkingFamily, which this kernel does not have; the BSD
+ * half of the kernel does not need it. The interface is made with the kernel's own interface
+ * KPI, the way bsd/net/if_fake.c makes its "feth": family Ethernet, the stock Ethernet framing
+ * and demultiplexing, one function that is given a frame to send and one call to hand a frame
+ * that has arrived to the stack. What iOS's user space makes of an interface that has no
+ * IOKit object behind it is another matter: see userland/src/net_test.m.
+ *
+ * What carries the frames is a link driver's business; sys/redwood_net.h is all that the two
+ * know of each other. The first link is QEMU's virtio network device (redwood_virtio_net.c).
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <net/bpf.h>
+#include <net/ethernet.h>
+#include <net/if.h>
+#include <net/if_ether.h>
+#include <net/if_media.h>
+#include <net/if_types.h>
+#include <net/kpi_interface.h>
+#include <netinet/in.h>
+#include <pexpert/pexpert.h>
+#include <sys/kern_event.h>
+#include <sys/kpi_mbuf.h>
+#include <sys/proc.h>
+#include <sys/redwood_net.h>
+#include <sys/sockio.h>
+#include <sys/systm.h>
+
+extern void RedwoodWLANStart(const char *interface, const uint8_t *address);  /* iokit/Kernel/RedwoodWLAN.cpp */
+
+static LCK_GRP_DECLARE(net_lck_grp, "redwood-net");
+static LCK_MTX_DECLARE(net_tx_lock, &net_lck_grp);
+static const struct redwood_net_link *net_link;
+static bool net_link_up;
+static ifnet_t net_ifp;
+
+/* What has gone through: said once a minute while anything moves. */
+static struct {
+	uint64_t sent, received, sent_bytes, received_bytes, dropped_out, dropped_in;
+} net_count;
+
+/*
+ * Boot-arg net_trace=N: a line in the log for each of the first N frames, either way.
+ * Boot-arg net_names=1: a line for every name asked of a DNS server and for every TCP connection
+ * begun from here -- which is how to see what a system that has just been given a network does
+ * with it (up to NAMES_MAX lines).
+ */
+#define NAMES_MAX       3000
+static uint32_t net_trace, net_names;
+
+static void
+trace_frame(const char *way, const uint8_t *frame, size_t length, size_t whole)
+{
+	static uint32_t said, names;
+	const uint8_t *end = frame + length, *ip = frame + ETHER_HDR_LEN, *l4;
+	uint16_t type;
+	bool ports;
+
+	if (length < ETHER_HDR_LEN + 28 || (said >= net_trace && (!net_names || names >= NAMES_MAX))) {
+		return;
+	}
+	type = (uint16_t)(frame[12] << 8 | frame[13]);
+	l4 = ip + 4 * (ip[0] & 0xf);
+	ports = type == ETHERTYPE_IP && (ip[9] == IPPROTO_TCP || ip[9] == IPPROTO_UDP) && l4 + 4 <= end;
+	if (net_names && names < NAMES_MAX && ports && way[0] == 'o') {
+		if (ip[9] == IPPROTO_UDP && (l4[2] << 8 | l4[3]) == 53 && l4 + 8 + 12 < end) {
+			char name[128];
+			const uint8_t *label = l4 + 8 + 12;
+			size_t n = 0;
+
+			/* the question: lengths and labels, up to a zero */
+			while (label < end && *label != 0 && *label < 64 && label + 1 + *label < end && n + *label + 2 < sizeof(name)) {
+				memcpy(name + n, label + 1, *label);
+				n += *label;
+				name[n++] = '.';
+				label += 1 + *label;
+			}
+			name[n ? n - 1 : 0] = 0;
+			names++;
+			printf("net: asks for the name %s (type %u)\n", name, label + 2 < end ? label[1] << 8 | label[2] : 0);
+		} else if (ip[9] == IPPROTO_TCP && l4 + 14 <= end && (l4[13] & 0x12) == 0x02) {
+			names++;
+			printf("net: connects to %u.%u.%u.%u port %u\n", ip[16], ip[17], ip[18], ip[19], l4[2] << 8 | l4[3]);
+		}
+	}
+	if (said >= net_trace) {
+		return;
+	}
+	said++;
+	if (type == ETHERTYPE_IP) {
+		printf("net: %s %zu bytes: IPv4 %s %u.%u.%u.%u:%u -> %u.%u.%u.%u:%u%s\n", way, whole, ip[9] == IPPROTO_TCP ? "TCP" :
+		    ip[9] == IPPROTO_UDP ? "UDP" : ip[9] == IPPROTO_ICMP ? "ICMP" : "protocol?", ip[12], ip[13], ip[14], ip[15],
+		    ports ? l4[0] << 8 | l4[1] : 0, ip[16], ip[17], ip[18], ip[19], ports ? l4[2] << 8 | l4[3] : 0,
+		    ip[9] == IPPROTO_TCP && ports && l4 + 14 <= end ? (l4[13] & 2 ? " SYN" : l4[13] & 1 ? " FIN" : l4[13] & 4 ? " RST" : "") : "");
+	} else {
+		printf("net: %s %zu bytes: %s (type %#x) to %02x:%02x:%02x:%02x:%02x:%02x\n", way, whole, type == ETHERTYPE_ARP ? "ARP" :
+		    type == ETHERTYPE_IPV6 ? "IPv6" : "?", type, frame[0], frame[1], frame[2], frame[3], frame[4], frame[5]);
+	}
+}
+
+/* ... of a frame on its way out: the start of it is enough */
+static void
+trace_packet(mbuf_t packet, size_t length)
+{
+	uint8_t start[192];
+	size_t have = length < sizeof(start) ? length : sizeof(start);
+
+	if ((net_trace || net_names) && mbuf_copydata(packet, 0, have, start) == 0) {
+		trace_frame("out", start, have, length);
+	}
+}
+
+/* ---- the interface -------------------------------------------------------------------------------- */
+
+/* The stack has a frame to send (a chain of mbufs that starts with the Ethernet header). */
+static errno_t
+net_output(ifnet_t ifp, mbuf_t packet)
+{
+	size_t length = mbuf_pkthdr_len(packet);
+	bool sent = false;
+
+	if (length <= REDWOOD_NET_FRAME_MAX && net_link_up) {
+		bpf_tap_out(ifp, DLT_EN10MB, packet, NULL, 0);
+		trace_packet(packet, length);
+		lck_mtx_lock(&net_tx_lock);
+		sent = net_link->transmit(packet, length);
+		lck_mtx_unlock(&net_tx_lock);
+	}
+	if (sent) {
+		net_count.sent++;
+		net_count.sent_bytes += length;
+		ifnet_stat_increment_out(ifp, 1, (uint32_t)length, 0);
+	} else {
+		net_count.dropped_out++;
+		ifnet_stat_increment_out(ifp, 0, 0, 1);
+	}
+	mbuf_freem(packet);
+	return 0;
+}
+
+/* A frame has arrived. */
+void
+redwood_net_input(const uint8_t *frame, size_t length)
+{
+	struct ifnet_stat_increment_param stats = { .packets_in = 1, .bytes_in = (uint32_t)length };
+	unsigned int chunks = 1;
+	mbuf_t packet = NULL;
+	char *header;
+
+	trace_frame("in ", frame, length, length);
+	if (net_ifp == NULL || length < ETHER_HDR_LEN || length > REDWOOD_NET_FRAME_MAX ||
+	    mbuf_allocpacket(MBUF_DONTWAIT, length, &chunks, &packet) != 0) {
+		net_count.dropped_in++;
+		return;
+	}
+	if (mbuf_copyback(packet, 0, length, frame, MBUF_DONTWAIT) != 0) {
+		mbuf_freem(packet);
+		net_count.dropped_in++;
+		return;
+	}
+	/* as every Ethernet driver hands a frame up: the header noted and stepped over */
+	header = mbuf_data(packet);
+	mbuf_pkthdr_setrcvif(packet, net_ifp);
+	mbuf_pkthdr_setheader(packet, header);
+	mbuf_pkthdr_adjustlen(packet, -ETHER_HDR_LEN);
+	mbuf_setdata(packet, header + ETHER_HDR_LEN, length - ETHER_HDR_LEN);
+	bpf_tap_in(net_ifp, DLT_EN10MB, packet, header, ETHER_HDR_LEN);
+	net_count.received++;
+	net_count.received_bytes += length;
+	ifnet_input(net_ifp, packet, &stats);
+}
+
+static unsigned net_ioctls_said;
+
+static errno_t
+net_ioctl(ifnet_t ifp, u_long command, void *data)
+{
+	/* (a radio says it is one here too: IO80211.framework lists the interfaces whose media is 802.11) */
+	const int media[] = { (net_link->wireless ? IFM_IEEE80211 : IFM_ETHER) | IFM_AUTO };
+	struct ifreq *request = data;
+	struct ifmediareq *media_request = data;
+	user_addr_t list;
+	errno_t error = 0;
+
+	if (net_link->wireless && net_ioctls_said < 80) {
+		char who[32] = "?";
+
+		/* (while iOS's Wi-Fi side is being got to talk to this: who asks the interface what) */
+		proc_selfname(who, sizeof(who));
+		if (strcmp(who, "configd") != 0) {
+			net_ioctls_said++;
+			printf("net: en0 is asked %#lx by %s\n", command, who);
+		}
+	}
+	switch (command) {
+	case SIOCSIFADDR:
+		ifnet_set_flags(ifp, IFF_UP, IFF_UP);
+		break;
+	case SIOCSIFFLAGS:
+		/* running whenever it is up: the link is there or it is not, nothing is switched on */
+		ifnet_set_flags(ifp, (ifnet_flags(ifp) & IFF_UP) ? IFF_RUNNING : 0, IFF_RUNNING);
+		break;
+	case SIOCGIFMEDIA32:
+	case SIOCGIFMEDIA64:
+		/* what configd asks to learn whether the cable is in */
+		list = command == SIOCGIFMEDIA64 ? ((struct ifmediareq64 *)media_request)->ifmu_ulist :
+		    CAST_USER_ADDR_T(((struct ifmediareq32 *)media_request)->ifmu_ulist);
+		media_request->ifm_active = media_request->ifm_current = media[0];
+		media_request->ifm_mask = 0;
+		media_request->ifm_status = IFM_AVALID | (net_link_up ? IFM_ACTIVE : 0);
+		if (list != USER_ADDR_NULL && media_request->ifm_count > 0) {
+			error = copyout(media, list, sizeof(media));
+		}
+		media_request->ifm_count = 1;
+		break;
+	case SIOCGIFDEVMTU:
+		request->ifr_devmtu.ifdm_current = ifnet_mtu(ifp);
+		request->ifr_devmtu.ifdm_max = ETHERMTU;
+		request->ifr_devmtu.ifdm_min = IF_MINMTU;
+		break;
+	case SIOCSIFMTU:
+		error = request->ifr_mtu > ETHERMTU || request->ifr_mtu < IF_MINMTU ? EINVAL : ifnet_set_mtu(ifp, request->ifr_mtu);
+		break;
+	case SIOCADDMULTI:
+	case SIOCDELMULTI:
+		break;                          /* the link hands us everything anyway */
+	default:
+		/* what iOS's Wi-Fi side asks of a radio's interface: bsd/dev/redwood_apple80211.c */
+		error = net_link->wireless ? redwood_apple80211_ioctl(command, data) : EOPNOTSUPP;
+		break;
+	}
+	return error;
+}
+
+/* Tell whoever listens for kernel events (configd does) that the link is up, or down. */
+static void
+net_link_event(ifnet_t ifp, uint32_t code)
+{
+	_Alignas(struct kern_event_msg) char message[sizeof(struct kern_event_msg) + sizeof(struct net_event_data)] = { 0 };
+	struct kern_event_msg *header = (struct kern_event_msg *)message;
+	struct net_event_data *about = (struct net_event_data *)(header + 1);
+
+	header->total_size = sizeof(message);
+	header->vendor_code = KEV_VENDOR_APPLE;
+	header->kev_class = KEV_NETWORK_CLASS;
+	header->kev_subclass = KEV_DL_SUBCLASS;
+	header->event_code = code;
+	about->if_family = ifnet_family(ifp);
+	about->if_unit = ifnet_unit(ifp);
+	strlcpy(about->if_name, ifnet_name(ifp), IFNAMSIZ);
+	ifnet_event(ifp, header);
+}
+
+void
+redwood_net_link_state(bool up)
+{
+	if (net_ifp == NULL || up == net_link_up) {
+		return;
+	}
+	net_link_up = up;
+	printf("net: the link (%s) is %s\n", net_link->name, up ? "up" : "down");
+	net_link_event(net_ifp, up ? KEV_DL_LINK_ON : KEV_DL_LINK_OFF);
+}
+
+/* The interface's own thread: for a link that wants to be asked, and for the minute's line in the log. */
+static void
+net_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	uint64_t said = 0, total;
+	unsigned quiet = 0;
+
+	for (unsigned tick = 1;; tick++) {
+		quiet = net_link->poll != NULL && net_link->poll() ? 0 : quiet + 1;
+		/* about once a minute, if anything has moved since */
+		total = net_count.sent + net_count.received + net_count.dropped_out + net_count.dropped_in;
+		if (tick % 8192 == 0 && total != said) {
+			said = total;
+			printf("net: so far %llu frames sent (%llu bytes), %llu received (%llu bytes); dropped: %llu out, %llu in\n",
+			    net_count.sent, net_count.sent_bytes, net_count.received, net_count.received_bytes,
+			    net_count.dropped_out, net_count.dropped_in);
+		}
+		delay_for_interval(quiet < 100 ? 2 : 10, NSEC_PER_MSEC);
+	}
+}
+
+bool
+redwood_net_attach(const struct redwood_net_link *link)
+{
+	struct ifnet_init_eparams init = {
+		.ver = IFNET_INIT_CURRENT_VERSION,
+		.len = sizeof(init),
+		/*
+		 * The simple model: every frame straight to net_output(). And no Skywalk "nexus" made for
+		 * the interface by itself: sockets are all that is asked of it so far.
+		 */
+		.flags = IFNET_INIT_LEGACY | IFNET_INIT_NX_NOAUTO,
+		.uniqueid = "redwood-en0",
+		.uniqueid_len = 11,
+		.name = "en",
+		.unit = 0,
+		.family = IFNET_FAMILY_ETHERNET,
+		.subfamily = link->wireless ? IFNET_SUBFAMILY_WIFI : IFNET_SUBFAMILY_ANY,
+		.type = IFT_ETHER,
+		.output = net_output,
+		.demux = ether_demux,
+		.add_proto = ether_add_proto,
+		.del_proto = ether_del_proto,
+		.check_multi = ether_check_multi,
+		.framer_extended = ether_frameout_extended,
+		.ioctl = net_ioctl,
+		.broadcast_addr = etherbroadcastaddr,
+		.broadcast_len = ETHER_ADDR_LEN,
+	};
+	const uint8_t *address = link->address;
+	ifnet_t ifp = NULL;
+	thread_t thread;
+	errno_t error;
+
+	if (net_link != NULL) {
+		printf("net: en0 is on %s already; %s is not attached\n", net_link->name, link->name);
+		return false;
+	}
+	net_link = link;
+	net_link_up = link->up;
+	error = ifnet_allocate_extended(&init, &ifp);
+	if (error != 0) {
+		printf("net: the interface cannot be made: error %d\n", error);
+		net_link = NULL;
+		return false;
+	}
+	ifnet_set_capabilities_enabled(ifp, 0, -1);
+	ifnet_set_addrlen(ifp, ETHER_ADDR_LEN);
+	ifnet_set_baudrate(ifp, 100 * 1000 * 1000);
+	ifnet_set_mtu(ifp, ETHERMTU);
+	ifnet_set_flags(ifp, IFF_BROADCAST | IFF_MULTICAST | IFF_SIMPLEX, 0xffff);
+	ifnet_set_hdrlen(ifp, ETHER_HDR_LEN);
+	ifnet_set_offload(ifp, 0);
+	error = ifnet_attach(ifp, NULL);
+	if (error != 0) {
+		printf("net: the interface cannot be attached: error %d\n", error);
+		ifnet_release(ifp);
+		net_link = NULL;
+		return false;
+	}
+	ifnet_set_lladdr(ifp, address, ETHER_ADDR_LEN);
+	bpfattach(ifp, DLT_EN10MB, ETHER_HDR_LEN);
+	net_ifp = ifp;
+	if (net_link_up) {
+		net_link_event(ifp, KEV_DL_LINK_ON);
+	}
+	if (link->wireless) {
+		/* (a radio's address is the phone's own: not for the log; and iOS's Wi-Fi side finds the interface by a service) */
+		printf("net: en0 attached on %s (a radio), link %s\n", link->name, net_link_up ? "up" : "down");
+		RedwoodWLANStart("en0", address);
+	} else {
+		printf("net: en0 attached on %s, address %02x:%02x:%02x:%02x:%02x:%02x, link %s\n", link->name, address[0],
+		    address[1], address[2], address[3], address[4], address[5], net_link_up ? "up" : "down");
+	}
+	if (kernel_thread_start(net_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	return true;
+}
+
+void
+redwood_net_init(void)
+{
+	PE_parse_boot_argn("net_trace", &net_trace, sizeof(net_trace));
+	PE_parse_boot_argn("net_names", &net_names, sizeof(net_names));
+}
diff --git a/bsd/dev/redwood_sta.c b/bsd/dev/redwood_sta.c
new file mode 100644
index 0000000..f4e0490
--- /dev/null
+++ b/bsd/dev/redwood_sta.c
@@ -0,0 +1,371 @@
+/*
+ * Darwin-on-redwood: what stands between the two sides of the station boundary
+ * (sys/redwood_sta.h).
+ *
+ * Whoever wants a network asks from wherever it happens to be: an ioctl of wifid's, the thread
+ * that brings the radio up. The station side wants to be called by one thread, one call at a
+ * time, and a scan or a join takes seconds. So what is asked for is noted here and done by a
+ * thread of this file's; the asker returns at once and hears the outcome as an event. One
+ * request of each kind can wait: a second scan asked for while the first has not begun
+ * replaces it, as does a second join.
+ *
+ * What the last scan heard is kept here, so that it can be read without entering the station
+ * side, and so is the list of channels.
+ *
+ * The network the kernel was given in a file is a standing request: joined at the start, and
+ * again whenever the radio is turned back on (Settings' switch), until somebody asks for
+ * another network -- as iOS itself rejoins the networks it knows. If that other network cannot
+ * be joined (a wrong passphrase), the standing one is joined again.
+ */
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <kern/sched_prim.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <sys/errno.h>
+#include <sys/redwood_input.h>
+#include <sys/redwood_sta.h>
+#include <sys/systm.h>
+
+extern void thread_set_thread_name(thread_t thread, const char *name);
+
+#define HEARD_MOST      128
+#define CHANNELS_MOST   96
+
+static LCK_GRP_DECLARE(sta_lock_group, "redwood-sta");
+static LCK_MTX_DECLARE(sta_lock, &sta_lock_group);
+
+static const struct redwood_sta_ops *sta_ops;   /* the station side, while there is one */
+static bool sta_thread_made;
+static bool sta_calls;                          /* the thread is in a call of the station side's */
+static unsigned sta_reads;                      /* ... and so many others are in its state() */
+static bool sta_on;                             /* the radio's power, as last asked for */
+
+/* what has been asked for and not begun */
+static bool asked_power, asked_power_on, asked_scan, asked_join, asked_leave;
+static struct redwood_sta_scan asked_scan_what;
+static struct redwood_sta_join asked_join_what;
+static struct redwood_sta_join standing;        /* the network joined whenever the radio comes on (ssid_length 0: none) */
+static struct redwood_sta_join fallback;        /* ... as it was before a join that has not come through yet */
+
+static struct redwood_sta_bss *heard;           /* by the last scan that came to an end */
+static unsigned heard_count;
+static struct redwood_sta_channel channels[CHANNELS_MOST];
+static unsigned channel_count;
+
+static void
+heard_one(const struct redwood_sta_bss *bss, __unused void *context)
+{
+	/* (only the thread writes the list, and it reads the count without the lock) */
+	if (heard_count < HEARD_MOST) {
+		lck_mtx_lock(&sta_lock);
+		heard[heard_count++] = *bss;
+		lck_mtx_unlock(&sta_lock);
+	}
+}
+
+static void
+sta_runs(__unused void *parameter, __unused wait_result_t result)
+{
+	static struct redwood_sta_scan scan;
+	static struct redwood_sta_join join;
+
+	for (;;) {
+		const struct redwood_sta_ops *ops;
+		bool power = false, power_on = false, leave = false, do_join = false, do_scan = false;
+		int error = 0;
+
+		lck_mtx_lock(&sta_lock);
+		while (sta_ops == NULL || !(asked_power || asked_leave || asked_join || asked_scan)) {
+			lck_mtx_sleep(&sta_lock, LCK_SLEEP_DEFAULT, (event_t)&sta_ops, THREAD_UNINT);
+		}
+		ops = sta_ops;
+		/* one thing at a time, in the order that makes sense when several wait */
+		if (asked_power) {
+			power = true;
+			power_on = asked_power_on;
+			asked_power = false;
+		} else if (asked_leave) {
+			leave = true;
+			asked_leave = false;
+		} else if (asked_join) {
+			do_join = true;
+			join = asked_join_what;
+			bzero(&asked_join_what, sizeof(asked_join_what));
+			asked_join = false;
+		} else {
+			do_scan = true;
+			scan = asked_scan_what;
+			asked_scan = false;
+		}
+		sta_calls = true;
+		lck_mtx_unlock(&sta_lock);
+
+		if (power) {
+			struct redwood_sta_state *state = kalloc_data(sizeof(*state), Z_WAITOK | Z_ZERO);
+			bool was_joined = false;
+
+			if (state != NULL) {
+				ops->state(state);
+				was_joined = state->phase == REDWOOD_STA_JOINED;
+				kfree_data(state, sizeof(*state));
+			}
+			error = ops->power(power_on);
+			if (!power_on && was_joined) {
+				redwood_apple80211_event(REDWOOD_STA_LINK, 0);
+			}
+			redwood_apple80211_event(REDWOOD_STA_POWER, error == 0 ? power_on : !power_on);
+			lck_mtx_lock(&sta_lock);
+			if (error == 0 && power_on && standing.ssid_length != 0 && !asked_join) {
+				asked_join_what = standing;
+				asked_join = true;
+			}
+			lck_mtx_unlock(&sta_lock);
+		} else if (leave) {
+			ops->leave();
+			redwood_apple80211_event(REDWOOD_STA_LINK, 0);
+		} else if (do_join) {
+			error = ops->join(&join);
+			bzero(&join, sizeof(join));
+			redwood_apple80211_event(REDWOOD_STA_JOIN_DONE, error);
+			if (error == 0) {
+				redwood_apple80211_event(REDWOOD_STA_LINK, 1);
+			}
+			/* a join that did not come through (a wrong passphrase) leaves things as they were: the standing network again */
+			lck_mtx_lock(&sta_lock);
+			if (error != 0 && fallback.ssid_length != 0 && !asked_join && !asked_leave && !asked_power) {
+				standing = asked_join_what = fallback;
+				asked_join = true;
+			}
+			bzero(&fallback, sizeof(fallback));
+			lck_mtx_unlock(&sta_lock);
+		} else if (do_scan) {
+			error = ops->scan(&scan);
+			lck_mtx_lock(&sta_lock);
+			heard_count = 0;
+			lck_mtx_unlock(&sta_lock);
+			ops->heard(heard_one, NULL);
+			redwood_apple80211_event(REDWOOD_STA_SCAN_DONE, error);
+		}
+
+		lck_mtx_lock(&sta_lock);
+		sta_calls = false;
+		lck_mtx_unlock(&sta_lock);
+		thread_wakeup((event_t)&sta_calls);
+	}
+}
+
+/* ---- the station side ---------------------------------------------------------------------------------- */
+
+void
+redwood_sta_attach(const struct redwood_sta_ops *ops)
+{
+	thread_t thread;
+
+	if (ops == NULL) {
+		lck_mtx_lock(&sta_lock);
+		sta_ops = NULL;
+		asked_power = asked_scan = asked_join = asked_leave = false;
+		while (sta_calls || sta_reads != 0) {
+			lck_mtx_sleep(&sta_lock, LCK_SLEEP_DEFAULT, (event_t)&sta_calls, THREAD_UNINT);
+		}
+		heard_count = channel_count = 0;
+		lck_mtx_unlock(&sta_lock);
+		return;
+	}
+	if (heard == NULL) {
+		heard = kalloc_data(HEARD_MOST * sizeof(*heard), Z_WAITOK | Z_ZERO);
+	}
+	if (heard == NULL) {
+		redwood_wifi_tell("wifi: no memory for what a scan hears: nobody can ask the radio for a network\n");
+		return;
+	}
+	if (!sta_thread_made) {
+		if (kernel_thread_start(sta_runs, NULL, &thread) != KERN_SUCCESS) {
+			redwood_wifi_tell("wifi: no thread for the station: nobody can ask the radio for a network\n");
+			return;
+		}
+		thread_set_thread_name(thread, "wifi-station");
+		thread_deallocate(thread);
+		sta_thread_made = true;
+	}
+	channel_count = ops->channels(channels, CHANNELS_MOST);
+	lck_mtx_lock(&sta_lock);
+	sta_ops = ops;
+	sta_on = true;
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_ops);
+	redwood_apple80211_event(REDWOOD_STA_POWER, 1);
+}
+
+void
+redwood_sta_lost(int error)
+{
+	redwood_apple80211_event(REDWOOD_STA_LINK, error != 0 ? error : ECONNRESET);
+}
+
+/* ---- who wants a network ------------------------------------------------------------------------------- */
+
+bool
+redwood_sta_present(void)
+{
+	return sta_ops != NULL;
+}
+
+bool
+redwood_sta_powered(void)
+{
+	return sta_ops != NULL && sta_on;
+}
+
+bool
+redwood_sta_busy(void)
+{
+	bool busy;
+
+	lck_mtx_lock(&sta_lock);
+	busy = sta_ops != NULL && (sta_calls || asked_power || asked_leave || asked_join || asked_scan);
+	lck_mtx_unlock(&sta_lock);
+	return busy;
+}
+
+int
+redwood_sta_ask_power(bool on)
+{
+	lck_mtx_lock(&sta_lock);
+	if (sta_ops == NULL) {
+		lck_mtx_unlock(&sta_lock);
+		return ENXIO;
+	}
+	sta_on = on;
+	asked_power = true;
+	asked_power_on = on;
+	if (!on) {
+		asked_scan = asked_join = asked_leave = false;
+	}
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_ops);
+	return 0;
+}
+
+int
+redwood_sta_ask_scan(const struct redwood_sta_scan *what)
+{
+	lck_mtx_lock(&sta_lock);
+	if (sta_ops == NULL || !sta_on) {
+		lck_mtx_unlock(&sta_lock);
+		return sta_ops == NULL ? ENXIO : ENETDOWN;
+	}
+	asked_scan_what = *what;
+	asked_scan = true;
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_ops);
+	return 0;
+}
+
+int
+redwood_sta_ask_join_standing(const struct redwood_sta_join *what)
+{
+	int error = redwood_sta_ask_join(what);
+
+	lck_mtx_lock(&sta_lock);
+	if (error == 0) {
+		standing = *what;
+	}
+	lck_mtx_unlock(&sta_lock);
+	return error;
+}
+
+int
+redwood_sta_ask_join(const struct redwood_sta_join *what)
+{
+	lck_mtx_lock(&sta_lock);
+	if (sta_ops == NULL || !sta_on) {
+		lck_mtx_unlock(&sta_lock);
+		return sta_ops == NULL ? ENXIO : ENETDOWN;
+	}
+	if (standing.ssid_length != 0) {
+		fallback = standing;
+	}
+	bzero(&standing, sizeof(standing));     /* (whoever asks for a network now has the say) */
+	asked_join_what = *what;
+	asked_join = true;
+	asked_leave = false;
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_ops);
+	return 0;
+}
+
+int
+redwood_sta_ask_leave(void)
+{
+	lck_mtx_lock(&sta_lock);
+	if (sta_ops == NULL) {
+		lck_mtx_unlock(&sta_lock);
+		return ENXIO;
+	}
+	asked_leave = true;
+	asked_join = false;
+	bzero(&asked_join_what, sizeof(asked_join_what));
+	bzero(&fallback, sizeof(fallback));
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_ops);
+	return 0;
+}
+
+bool
+redwood_sta_heard(unsigned index, struct redwood_sta_bss *bss)
+{
+	bool there;
+
+	lck_mtx_lock(&sta_lock);
+	if ((there = index < heard_count)) {
+		*bss = heard[index];
+	}
+	lck_mtx_unlock(&sta_lock);
+	return there;
+}
+
+void
+redwood_sta_state(struct redwood_sta_state *state)
+{
+	const struct redwood_sta_ops *ops;
+
+	bzero(state, sizeof(*state));
+	lck_mtx_lock(&sta_lock);
+	if ((ops = sta_ops) != NULL) {
+		sta_reads++;
+	}
+	lck_mtx_unlock(&sta_lock);
+	if (ops != NULL) {
+		ops->state(state);
+		lck_mtx_lock(&sta_lock);
+		sta_reads--;
+		lck_mtx_unlock(&sta_lock);
+		thread_wakeup((event_t)&sta_calls);
+	}
+}
+
+unsigned
+redwood_sta_channels(struct redwood_sta_channel *out, unsigned most)
+{
+	unsigned count;
+
+	lck_mtx_lock(&sta_lock);
+	count = channel_count < most ? channel_count : most;
+	memcpy(out, channels, count * sizeof(*out));
+	lck_mtx_unlock(&sta_lock);
+	return count;
+}
+
+bool
+redwood_sta_address(uint8_t *address)
+{
+	const struct redwood_sta_ops *ops = sta_ops;
+
+	if (ops != NULL) {
+		memcpy(address, ops->address, 6);
+	}
+	return ops != NULL;
+}
diff --git a/bsd/dev/sweet_files.c b/bsd/dev/sweet_files.c
new file mode 100644
index 0000000..53f6a8d
--- /dev/null
+++ b/bsd/dev/sweet_files.c
@@ -0,0 +1,355 @@
+/*
+ * File server for the running iOS root, over USB Ethernet: TCP
+ * 192.168.7.2:2223 (on the Mac: 127.0.0.1:2223 through FlameBridge,
+ * tools/flame-files.py). One request per connection, a header line then
+ * data:
+ *
+ *   PUT <path> <mode-octal> <size>\n<size bytes>  -> "OK <size>\n"  (root:wheel)
+ *   GET <path>\n                                  -> "OK <size>\n<bytes>"
+ *   MKDIR <path> <mode-octal>\n                   -> "OK\n"
+ *   LINK <target> <path>\n                        -> "OK\n"  (symlink)
+ *   RM <path>\n                                   -> "OK\n"
+ *   CHMOD <path> <mode-octal>\n                   -> "OK\n"
+ *   SYNC\n                                        -> "OK\n"  (0168)
+ *
+ * Errors: "ERR <errno>\n". Paths have no spaces. Started with the USB
+ * gadget (sweet_usb.c) when the interface comes up.
+ *
+ * ios-sweet 0168 (from ios-flame/sunfish 0091, tools/flame-files.py): root file access to the running
+ * system over the USB cable only. Boot-arg sweetfiles=1 enables it; it binds 192.168.7.2 (ue0) instead
+ * of every address, so it is not reachable over Wi-Fi, and closes connections from outside
+ * 192.168.7.0/24.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/vnode.h>
+#include <sys/vnode_internal.h>
+#include <sys/kernel.h>
+#include <sys/kauth.h>
+#include <sys/proc_internal.h>
+#include <sys/kpi_socket.h>
+#include <sys/socket.h>
+#include <sys/uio.h>
+#include <netinet/in.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <libkern/libkern.h>
+#include <pexpert/pexpert.h>
+
+extern int sweet_vfs_mkdir(const char *path, int mode);
+extern int sweet_vfs_symlink(const char *target, const char *link);
+extern int sweet_vfs_unlink(const char *path);
+extern kern_return_t thread_terminate(thread_t);
+struct sync_args;
+extern int sync(proc_t p, struct sync_args *uap, int32_t *retval);
+void sweet_files_start(void);
+
+#define SF_BUF  (64 * 1024)
+
+static char *sf_buf;
+static int sf_chan;
+
+static void
+sf_sleep_ms(int ms)
+{
+	(void)tsleep(&sf_chan, PZERO, "sweetfiles", MAX(1, ms * hz / 1000));
+}
+
+static unsigned long long
+sf_dec(const char *p)
+{
+	unsigned long long v = 0;
+	while (*p == ' ') {
+		p++;
+	}
+	while (*p >= '0' && *p <= '9') {
+		v = v * 10 + (unsigned)(*p++ - '0');
+	}
+	return v;
+}
+
+static int
+sf_recv(socket_t so, void *buf, size_t len, size_t *got, int flags)
+{
+	struct iovec iov = { .iov_base = buf, .iov_len = len };
+	struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1 };
+	return sock_receive(so, &msg, flags, got);
+}
+
+static int
+sf_recv_all(socket_t so, void *buf, size_t len)
+{
+	size_t off = 0;
+	while (off < len) {
+		size_t got = 0;
+		int err = sf_recv(so, (char *)buf + off, len - off, &got, MSG_WAITALL);
+		if (err) {
+			return err;
+		}
+		if (got == 0) {
+			return ECONNRESET;
+		}
+		off += got;
+	}
+	return 0;
+}
+
+static int
+sf_send(socket_t so, const void *buf, size_t len)
+{
+	size_t off = 0;
+	while (off < len) {
+		struct iovec iov = { .iov_base = (char *)buf + off, .iov_len = len - off };
+		struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1 };
+		size_t sent = 0;
+		int err = sock_send(so, &msg, 0, &sent);
+		if (err) {
+			return err;
+		}
+		off += sent;
+	}
+	return 0;
+}
+
+static void
+sf_reply(socket_t so, int err, uint64_t n, bool with_n)
+{
+	char line[48];
+	int len = err ? snprintf(line, sizeof(line), "ERR %d\n", err) :
+	    with_n ? snprintf(line, sizeof(line), "OK %llu\n", n) : snprintf(line, sizeof(line), "OK\n");
+	(void)sf_send(so, line, (size_t)len);
+}
+
+/* Header line: up to '\n', read byte by byte so data after it stays queued. */
+static int
+sf_line(socket_t so, char *line, size_t max)
+{
+	size_t n = 0;
+	while (n + 1 < max) {
+		size_t got = 0;
+		int err = sf_recv(so, line + n, 1, &got, MSG_WAITALL);
+		if (err || got == 0) {
+			return err ? err : ECONNRESET;
+		}
+		if (line[n] == '\n') {
+			break;
+		}
+		n++;
+	}
+	line[n] = 0;
+	return 0;
+}
+
+static int
+sf_setattr(const char *path, int mode, bool owner)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int err = vnode_lookup(path, 0, &vp, ctx);
+	if (err) {
+		return err;
+	}
+	struct vnode_attr va;
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_mode, mode & 07777);
+	if (owner) {
+		VATTR_SET(&va, va_uid, 0);
+		VATTR_SET(&va, va_gid, 0);
+	}
+	err = vnode_setattr(vp, &va, ctx);
+	vnode_put(vp);
+	return err;
+}
+
+static int
+sf_put(socket_t so, const char *path, int mode, uint64_t size)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int err = vnode_open(path, O_CREAT | O_TRUNC | FWRITE, mode & 07777, 0, &vp, ctx);
+	uint64_t off = 0;
+	while (off < size) {
+		size_t chunk = (size_t)MIN((uint64_t)SF_BUF, size - off);
+		int rerr = sf_recv_all(so, sf_buf, chunk);
+		if (rerr) {
+			err = err ? err : rerr;
+			break;
+		}
+		if (!err) {
+			int resid = 0;
+			err = vn_rdwr(UIO_WRITE, vp, sf_buf, (int)chunk, (off_t)off, UIO_SYSSPACE, IO_UNIT,
+			    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+			if (!err && resid) {
+				err = EIO;
+			}
+		}
+		off += chunk;
+	}
+	if (vp != NULLVP) {
+		vnode_close(vp, FWRITE, ctx);
+	}
+	if (!err) {
+		err = sf_setattr(path, mode, true);
+	}
+	return err;
+}
+
+static int
+sf_get(socket_t so, const char *path)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	off_t size = 0;
+	int err = vnode_open(path, FREAD, 0, 0, &vp, ctx);
+	if (!err) {
+		err = vnode_size(vp, &size, ctx);
+	}
+	if (err) {
+		if (vp != NULLVP) {
+			vnode_close(vp, FREAD, ctx);
+		}
+		sf_reply(so, err, 0, false);
+		return err;
+	}
+	sf_reply(so, 0, (uint64_t)size, true);
+	for (off_t off = 0; off < size && !err;) {
+		int chunk = (int)MIN((off_t)SF_BUF, size - off), resid = 0;
+		err = vn_rdwr(UIO_READ, vp, sf_buf, chunk, off, UIO_SYSSPACE, IO_UNIT,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (!err) {
+			err = sf_send(so, sf_buf, (size_t)(chunk - resid));
+		}
+		off += chunk;
+	}
+	vnode_close(vp, FREAD, ctx);
+	return err;
+}
+
+static void
+sf_handle(socket_t so)
+{
+	static char line[1100];
+	char a[512], b[512];
+	unsigned long long n = 0;
+	int err = sf_line(so, line, sizeof(line));
+	if (err) {
+		return;
+	}
+	a[0] = b[0] = 0;
+	if (!strncmp(line, "PUT ", 4)) {
+		unsigned mode = 0644;
+		char *p = line + 4, *sp = strchr(p, ' ');
+		if (!sp || (size_t)(sp - p) >= sizeof(a)) {
+			sf_reply(so, EINVAL, 0, false);
+			return;
+		}
+		memcpy(a, p, (size_t)(sp - p));
+		a[sp - p] = 0;
+		mode = (unsigned)strtoul(sp + 1, &p, 8);
+		n = sf_dec(p);
+		err = sf_put(so, a, (int)mode, n);
+		printf("SWEET FILES: PUT %s %o %llu -> %d\n", a, mode, n, err);
+		sf_reply(so, err, n, true);
+		return;
+	}
+	if (!strncmp(line, "GET ", 4)) {
+		err = sf_get(so, line + 4);
+		printf("SWEET FILES: GET %s -> %d\n", line + 4, err);
+		return;
+	}
+	if (!strcmp(line, "SYNC")) {
+		/* flush written files before a forced reboot (0168) */
+		int32_t rv = 0;
+		err = sync(kernproc, NULL, &rv);
+		printf("SWEET FILES: SYNC -> %d\n", err);
+		sf_reply(so, err, 0, false);
+		return;
+	}
+	char *sp = strchr(line, ' ');
+	if (!sp) {
+		sf_reply(so, EINVAL, 0, false);
+		return;
+	}
+	*sp = 0;
+	char *arg1 = sp + 1, *arg2 = strchr(arg1, ' ');
+	if (arg2) {
+		*arg2++ = 0;
+	}
+	if (!strcmp(line, "MKDIR")) {
+		err = sweet_vfs_mkdir(arg1, arg2 ? (int)strtoul(arg2, NULL, 8) : 0755);
+		if (err == EEXIST) {
+			err = 0;
+		}
+	} else if (!strcmp(line, "LINK") && arg2) {
+		err = sweet_vfs_symlink(arg1, arg2);
+	} else if (!strcmp(line, "RM")) {
+		err = sweet_vfs_unlink(arg1);
+	} else if (!strcmp(line, "CHMOD") && arg2) {
+		err = sf_setattr(arg1, (int)strtoul(arg2, NULL, 8), false);
+	} else {
+		err = EINVAL;
+	}
+	printf("SWEET FILES: %s %s %s -> %d\n", line, arg1, arg2 ? arg2 : "", err);
+	sf_reply(so, err, 0, false);
+}
+
+static void
+sf_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	socket_t ls = NULL;
+	struct sockaddr_in me;
+	int one = 1;
+
+	sf_buf = kalloc_data(SF_BUF, Z_WAITOK);
+	for (;;) {
+		if (sock_socket(PF_INET, SOCK_STREAM, IPPROTO_TCP, NULL, NULL, &ls) == 0) {
+			(void)sock_setsockopt(ls, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+			bzero(&me, sizeof(me));
+			me.sin_len = sizeof(me);
+			me.sin_family = AF_INET;
+			me.sin_port = htons(2223);
+			me.sin_addr.s_addr = htonl(0xc0a80702);   /* 192.168.7.2: ue0 only */
+			if (sock_bind(ls, (struct sockaddr *)&me) == 0 && sock_listen(ls, 4) == 0) {
+				break;
+			}
+			sock_close(ls);
+		}
+		ls = NULL;
+		sf_sleep_ms(1000);
+	}
+	printf("SWEET FILES: listening on tcp 2223\n");
+	for (;;) {
+		socket_t c = NULL;
+		struct sockaddr_in peer;
+		bzero(&peer, sizeof(peer));
+		if (sock_accept(ls, (struct sockaddr *)&peer, sizeof(peer), 0, NULL, NULL, &c) != 0 || c == NULL) {
+			sf_sleep_ms(100);
+			continue;
+		}
+		if (peer.sin_family != AF_INET || (ntohl(peer.sin_addr.s_addr) & 0xffffff00u) != 0xc0a80700u) {
+			printf("SWEET FILES: refused a connection from outside 192.168.7.0/24\n");
+			sock_close(c);
+			continue;
+		}
+		sf_handle(c);
+		sock_close(c);
+	}
+}
+
+void
+sweet_files_start(void)
+{
+	int on = 0;
+	PE_parse_boot_argn("sweetfiles", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	thread_t thread;
+	if (kernel_thread_start(sf_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_pmem.c b/bsd/dev/sweet_pmem.c
new file mode 100644
index 0000000..e06ae75
--- /dev/null
+++ b/bsd/dev/sweet_pmem.c
@@ -0,0 +1,417 @@
+/*
+ * /dev/pmem: physical memory for userland hardware experiments (the GPU
+ * bring-up in work/userland/gpu runs on it over SSH, no reboot per try).
+ * Root only (0600); Sweet creates the node only with boot-arg sweetpmem=1.
+ *
+ *   pread/pwrite at offset = physical address.
+ *     Managed DRAM goes through the physical aperture with the lines
+ *     cleaned+invalidated to the point of coherency before and after, so
+ *     data a device wrote is seen and CPU writes reach memory (IO is not
+ *     coherent here). Anything else (MMIO, carve-outs such as the panel
+ *     framebuffer) is mapped as device memory and accessed with 32-bit
+ *     loads/stores only: offset and length must be multiples of 4.
+ *     Reading an unclocked block hangs the SoC, as with poke scripts.
+ *   ioctl PMEM_ALLOC   {size, align} -> {pa}: zeroed, physically contiguous
+ *                      kernel memory (stays until PMEM_FREE, survives exit)
+ *   ioctl PMEM_FREE    {pa}
+ *   ioctl PMEM_SMC     x0..x7 in, x0..x3 out (SMCCC; e.g. SCM PAS calls)
+ *   ioctl PMEM_LIST    allocation table, for tools that lost their state
+ *
+ * Userland side: work/userland/gpu/pmem.h (same structs and numbers).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <mach/mach_time.h>
+#include <kern/clock.h>
+#include <sys/systm.h>
+#include <sys/conf.h>
+#include <sys/errno.h>
+#include <sys/ioccom.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern boolean_t pmap_valid_address(uint64_t pa);
+extern vm_map_address_t phystokv(uint64_t pa);
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, unsigned int flags);
+extern void ml_io_unmap(vm_offset_t addr, vm_size_t sz);
+extern void _disable_preemption(void);
+extern void _enable_preemption(void);
+void sweet_pmem_init(void);
+
+struct pmem_alloc {
+	uint64_t size;          /* in: bytes (rounded up to pages) */
+	uint64_t align;         /* in: bytes, power of 2, 0 = page */
+	uint64_t pa;            /* out */
+};
+struct pmem_smc {
+	uint64_t x[8];
+};
+#define PMEM_LIST_MAX   64
+struct pmem_list {
+	uint32_t count;
+	uint32_t pad;
+	struct {
+		uint64_t pa, size;
+	} ent[PMEM_LIST_MAX];
+};
+#define PMEM_ALLOC      _IOWR('P', 1, struct pmem_alloc)
+#define PMEM_FREE       _IOW('P', 2, uint64_t)
+#define PMEM_SMC        _IOWR('P', 3, struct pmem_smc)
+#define PMEM_LIST       _IOR('P', 4, struct pmem_list)
+/* ios-flame 0102: one RPMh active vote for wland (bsd/dev/sweet_rpmh.c checks it). */
+struct pmem_rpmh {
+	char res[16];           /* cmd-db name */
+	uint32_t n;             /* 1..4 commands */
+	uint32_t offset[4];     /* from the resource address */
+	uint32_t value[4];
+};
+#define PMEM_RPMH       _IOW('P', 5, struct pmem_rpmh)
+extern int sweet_rpmh_write(const char *res, unsigned n, const uint32_t *offsets, const uint32_t *values);
+
+#define PMEM_MAPS       16              /* 2 MB device windows, round robin */
+#define PMEM_WIN        0x200000ULL
+
+static struct {
+	vm_offset_t va;
+	uint64_t pa, size;
+} pm_alloc[PMEM_LIST_MAX];
+static struct {
+	vm_offset_t va;
+	uint64_t win;
+} pm_map[PMEM_MAPS];
+static unsigned pm_map_next;
+static uint32_t pm_bounce[PAGE_SIZE / 4];
+
+static LCK_GRP_DECLARE(sweet_pmem_grp, "sweet_pmem");
+static LCK_MTX_DECLARE(sweet_pmem_lock, &sweet_pmem_grp);
+
+/*
+ * Device mapping of the 2 MB window holding pa, from a small round-robin
+ * cache. ml_io_map's mappings are permanent (unmapping one panics) and come
+ * from the small io_submap (a 2 MB one panicked "kmem_alloc failed"), so
+ * windows use ml_io_map_unmappable: kernel_map, freed by ml_io_unmap.
+ */
+static volatile uint32_t *
+pm_io(uint64_t pa)
+{
+	uint64_t win = pa & ~(PMEM_WIN - 1);
+	for (unsigned i = 0; i < PMEM_MAPS; i++) {
+		if (pm_map[i].va && pm_map[i].win == win) {
+			return (volatile uint32_t *)(pm_map[i].va + (pa - win));
+		}
+	}
+	unsigned i = pm_map_next++ % PMEM_MAPS;
+	if (pm_map[i].va) {
+		ml_io_unmap(pm_map[i].va, PMEM_WIN);
+	}
+	pm_map[i].va = ml_io_map_unmappable((vm_offset_t)win, PMEM_WIN, VM_WIMG_IO);
+	pm_map[i].win = win;
+	return pm_map[i].va ? (volatile uint32_t *)(pm_map[i].va + (pa - win)) : NULL;
+}
+
+/* 0151: 0131/0140 wland stopped on its first apps-SMMU read through here while
+ * the kernel's own read of the same registers (0149/0150) worked. Trace the
+ * first device accesses: CPU, address, and the value once the access returned. */
+static unsigned pm_traced;
+extern int cpu_number(void);
+
+/* The probe's read through this exact path (window cache + mapping). */
+uint32_t sweet_pmem_probe_read(uint64_t pa);
+uint32_t
+sweet_pmem_probe_read(uint64_t pa)
+{
+	lck_mtx_lock(&sweet_pmem_lock);
+	volatile uint32_t *r = pm_io(pa);
+	const uint32_t v = r ? *r : 0xdeadbeef;
+	lck_mtx_unlock(&sweet_pmem_lock);
+	return v;
+}
+
+static int
+pm_rw(struct uio *uio, bool write)
+{
+	int err = 0;
+	lck_mtx_lock(&sweet_pmem_lock);
+	while (!err && uio_resid(uio) > 0) {
+		uint64_t pa = (uint64_t)uio_offset(uio);
+		uint64_t off = pa & PAGE_MASK;
+		unsigned n = (unsigned)MIN((user_ssize_t)(PAGE_SIZE - off), uio_resid(uio));
+		if (pmap_valid_address(pa)) {
+			caddr_t va = (caddr_t)phystokv(pa);
+			flush_dcache64((addr64_t)pa, n, TRUE);
+			err = uiomove(va, (int)n, uio);
+			flush_dcache64((addr64_t)pa, n, TRUE);
+			continue;
+		}
+		if ((pa | n) & 3) {
+			err = EINVAL;
+			break;
+		}
+		/* 0152: 0141 hardware: wland's first apps-SMMU load stalled CPU2 on the
+		 * very mapping the kernel probe had read through 20 s earlier. The SN15/CN0
+		 * votes went to RPMh's active set only; recast them (at most every 50 ms)
+		 * right before an access to the SMMU's window. */
+		if (pa >= 0x15000000ULL && pa < 0x15200000ULL) {
+			extern int sweet_rpmh_bcm_vote(const char *res, uint32_t x, uint32_t y);
+			static uint64_t voted_at;
+			uint64_t now = mach_absolute_time(), ns = 0;
+			absolutetime_to_nanoseconds(now - voted_at, &ns);
+			if (!voted_at || ns > 50 * NSEC_PER_MSEC) {
+				const int sn = sweet_rpmh_bcm_vote("SN15", 1, 1), cn = sweet_rpmh_bcm_vote("CN0", 1, 1);
+				static unsigned revotes;
+				if (++revotes <= 8 || sn || cn) {
+					printf("SWEET PMEM: apps SMMU access: recast SN15=%d CN0=%d (%u)\n", sn, cn, revotes);
+				}
+				voted_at = now;
+			}
+		}
+		const bool trace = pm_traced < 48;
+		if (trace) {
+			pm_traced++;
+			printf("SWEET PMEM: cpu%d %s %u at %#llx (%s)\n", cpu_number(), write ? "write" : "read", n,
+			    (unsigned long long)pa, proc_best_name(current_proc()));
+		}
+		volatile uint32_t *r = pm_io(pa);
+		if (r == NULL) {
+			err = ENOMEM;
+			break;
+		}
+		if (trace) {
+			printf("SWEET PMEM: mapped %#llx at %p\n", (unsigned long long)pa, (void *)(uintptr_t)r);
+		}
+		if (write) {
+			err = uiomove((caddr_t)pm_bounce, (int)n, uio);
+			__asm__ volatile ("dmb oshst" ::: "memory");
+			for (unsigned i = 0; !err && i < n / 4; i++) {
+				r[i] = pm_bounce[i];
+			}
+			__asm__ volatile ("dsb osh" ::: "memory");
+		} else {
+			for (unsigned i = 0; i < n / 4; i++) {
+				pm_bounce[i] = r[i];
+			}
+			__asm__ volatile ("dmb oshld" ::: "memory");
+			if (trace) {
+				printf("SWEET PMEM: read %#llx -> %#x\n", (unsigned long long)pa, pm_bounce[0]);
+			}
+			err = uiomove((caddr_t)pm_bounce, (int)n, uio);
+		}
+	}
+	lck_mtx_unlock(&sweet_pmem_lock);
+	return err;
+}
