+			break;
+		}
+		level[i] = value + 1;
+		if (i > 0 && level[i] < level[i - 1]) {
+			printf("SWEET RPMH: non-monotonic ARC table index=%u\n", i);
+			return EINVAL;
+		}
+	}
+	if (used == 0 || level[used - 1] == 0) {
+		return EINVAL;
+	}
+	*count = used;
+	return 0;
