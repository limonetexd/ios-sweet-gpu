+/*
+ * One GPU performance level's wire vote, as Linux a6xx_gmu_rpmh_arc_votes_init:
+ * the first gfx.lvl entry at or above the OPP's raw level is primary; the
+ * first mx.lvl entry at or above it is secondary, else the highest nonzero
+ * one. *mx_level returns that secondary level for an APPS raise-only floor.
+ */
+int sweet_rpmh_adreno_level_vote(unsigned level, uint32_t *vote, unsigned *mx_level);
+int
+sweet_rpmh_adreno_level_vote(unsigned level, uint32_t *vote, unsigned *mx_level)
+{
+ if (!vote || !mx_level || !level) return EINVAL;
+ *vote = 0; *mx_level = 0;
+ if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) return EBUSY;
+ const char *names[] = {"gfx.lvl", "mx.lvl"};
+ const uint32_t address[] = {0x30050, 0x30010};
+ uint32_t levels[2][RH_ARC_MAX_LEVELS] = {{0}};
+ unsigned counts[2] = {0}, index[2] = {0};
+ bool found[2] = {false, false};
+ int error = rh_map();
+ for (unsigned r = 0; !error && r < 2; ++r) {
+  struct rh_res resource = {0};
+  error = rh_lookup(names[r], RH_ARC, &resource);
+  if (!error && resource.addr != address[r]) error = ENODEV;
+  if (!error) error = rh_arc_levels(&resource, levels[r], &counts[r]);
+  if (error) break;
+  for (unsigned i = 0; i < counts[r]; ++i) {
+   --levels[r][i];
+   if (!found[r] && levels[r][i] >= level) { index[r] = i; found[r] = true; }
+   else if (!found[r] && r == 1 && levels[r][i]) index[r] = i;
+  }
+  if (levels[r][0] != 0) error = ERANGE;
+ }
