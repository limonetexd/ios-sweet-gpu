+/*
+ * 0141: one layer's copy into the panel, cut into bands of rows taken in order, top first, by
+ * whoever does the copy (the vsync tick; with 0142 helper threads too). A band is pushed out of
+ * the caches (when the GPU drew it) just before it is read, by whoever copies it.
+ */
+#define SWEET_FB_BAND_ROWS      64      /* ~290 KB of source a band at 1125x2436 */
+
+struct SweetCopyJob {
+	uintptr_t srcRows;              /* source: start of its first row */
+	uintptr_t dst;                  /* panel: first byte written */
+	uint32_t  srcColumn;            /* bytes into a source row the copy begins at */
+	uint32_t  srcRowBytes, dstRowBytes;
+	uint32_t  bytes;                /* bytes of each row */
+	uint32_t  rows, bands;
+	int32_t   dy;                   /* panel row of the first row */
+	bool      invalidate;           /* dc civac each band first */
+	uint32_t  next;                 /* next band to take (atomic) */
+};
+
+static void
+sweet_fb_copy_band(const SweetCopyJob *job, uint32_t band)
+{
+	uint32_t y0 = band * SWEET_FB_BAND_ROWS;
+	uint32_t y1 = y0 + SWEET_FB_BAND_ROWS < job->rows ? y0 + SWEET_FB_BAND_ROWS : job->rows;
+	uintptr_t src = job->srcRows + (uint64_t)y0 * job->srcRowBytes;
+	uintptr_t dst = job->dst + (uint64_t)y0 * job->dstRowBytes;
+
+	if (job->invalidate) {
+		redwood_gpu_to_memory((void *)src, (uint64_t)(y1 - y0) * job->srcRowBytes);
+	}
+	for (uint32_t y = y0; y < y1; y++) {
+		memcpy((void *)dst, (const void *)(src + job->srcColumn), job->bytes);
+		src += job->srcRowBytes;
+		dst += job->dstRowBytes;
+	}
+}
+
+/* Takes bands until none is left; returns how many this processor did. */
+static uint32_t
+sweet_fb_copy_bands(SweetCopyJob *job)
+{
+	uint32_t done = 0, band;
+
+	while ((band = __atomic_fetch_add(&job->next, 1, __ATOMIC_RELAXED)) < job->bands) {
+		sweet_fb_copy_band(job, band);
+		done++;
+	}
+	/* the panel is write-combined memory: this processor's writes out of its buffers */
+	__asm__ volatile ("dsb st" ::: "memory");
+	return done;
+}
+
+void
+AppleCLCD::copy(SweetCopyJob *job)
+{
+	(void)sweet_fb_copy_bands(job);
+}
