+/* A frame put on the panel (or left as it was: copied false), or one the GPU was not done with. */
+void
+AppleCLCD::notePresent(bool drawn, bool copied, uint64_t began)
+{
+	if (fStatLock != NULL) {
+		uint64_t ns = 0;
+		absolutetime_to_nanoseconds(mach_absolute_time() - began, &ns);
+		IOLockLock(fStatLock);
+		if (drawn && !copied) {
+			fStatRepeats++;
+		} else if (drawn) {
+			fStatPresents++;
+			fStatPresentSum += ns;
+			if (ns > fStatPresentMax) {
+				fStatPresentMax = ns;
+			}
+		} else {
+			fStatStale++;
+		}
+		IOLockUnlock(fStatLock);
+	}
+}
+
+void
+AppleCLCD::presenterMain(void *self, wait_result_t result __unused)
+{
+	((AppleCLCD *)self)->presenter();
+}
+
+/* 0145: puts each frame handed over on the panel (from generation 1: none is missed at start). */
+void
+AppleCLCD::presenter(void)
+{
+	uint8_t rec[SWEET_FB_SWAP_REC_SIZE];
+	uint32_t seen = 0;
+
+	for (;;) {
+		IOLockLock(fLock);
+		while (fPresentGeneration == seen) {
+			IOLockSleep(fLock, &fPresentGeneration, THREAD_UNINT);
+		}
+		seen = fPresentGeneration;
+		memcpy(rec, fPresentRec, sizeof(rec));
+		IOLockUnlock(fLock);
+		uint64_t began = mach_absolute_time();
+		bool copied = present(rec);
+		notePresent(true, copied, began);
+		IOLockLock(fLock);
+		fPresentBusy = false;
+		IOLockUnlock(fLock);
+	}
+}
