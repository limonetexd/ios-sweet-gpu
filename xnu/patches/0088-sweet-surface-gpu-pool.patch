+/*
+ * (ios-topaz 0924/0927/0929) backboardd's screen-sized surfaces come from the GPU pool
+ * (SweetAdreno.cpp): RAM XNU does not manage, mapped write-combined everywhere, so the GPU
+ * draws into them with no cache maintenance (an 11 MB dc civac per submission was ~45 ms).
+ * Boot-arg sweetgpu>=2 (the GPU is ours); sweet_fbpool=0 turns it off.
+ */
+static bool
+sweet_gpu_pool_eligible(const SweetSurface *s)
+{
+	static int on = -1;
+	if (on < 0) {
+		int gpu = 0, pool = 1;
+		(void)PE_parse_boot_argn("sweetgpu", &gpu, sizeof(gpu));
+		(void)PE_parse_boot_argn("sweet_fbpool", &pool, sizeof(pool));
+		on = gpu >= 2 && pool != 0;
+	}
+	if (!on || s->pixelFormat != 0x42475241u || s->bytesPerElement != 4 || s->planeCount > 1 ||
+	    s->elementWidth != 1 || s->elementHeight != 1 || s->width < 1000 || s->height < 2000) {
+		return false;
+	}
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	return strcmp(name, "backboardd") == 0;
+}
+
+/* Memory for s from the GPU pool, zeroed; false when there is none (ordinary memory then). */
+static bool
+sweet_surface_use_gpu_pool(SweetSurface *s)
+{
+	uint64_t pa = sweet_gpu_pool_surface(s->allocSize);
+	if (pa == 0) {
+		return false;
+	}
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(pa, round_page_64(s->allocSize), kIODirectionInOut);
+	IOMemoryMap *map = md != NULL ? md->map(kIOMapWriteCombineCache) : NULL;
+	if (map == NULL) {
+		OSSafeReleaseNULL(md);
+		sweet_gpu_pool_surface_free(pa);
+		return false;
+	}
+	volatile uint64_t *p = (volatile uint64_t *)map->getVirtualAddress();
+	for (uint64_t i = 0; i < round_page_64(s->allocSize) / 8; i++) {
+		p[i] = 0;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	s->memory = md;
+	s->kernelMap = map;
+	s->gpuPool = true;
+	s->poolPhys = pa;
+	s->mapCache = kIOMapWriteCombineCache;
+	return true;
+}
