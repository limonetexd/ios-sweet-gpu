+/*
+ * (ios-sailfish 0182) Push out of the cache only the pages the processor has written since the
+ * last time: the pmap's modified bit is set by the first write through a user mapping after
+ * pmap_clear_modify. The first time, the whole buffer (the kernel's zero-fill does not set the
+ * bit). Flushing every page of the screen surface at every submission was ~28 ms (run 0094g).
+ * Returns the bytes pushed.
+ */
+static uint64_t
+toMemoryWritten(struct gpu_buffer * b)
+{
+	uint64_t pushed = 0;
+
+	for (uint64_t off = 0; off < b->size; off += PAGE_SIZE) {
+		IOByteCount len = 0;
+		addr64_t pa = b->memory->getPhysicalSegment(off, &len, kIOMemoryMapperNone);
+		ppnum_t pn = (ppnum_t) (pa >> PAGE_SHIFT);
+		uint64_t n = b->size - off < PAGE_SIZE ? b->size - off : PAGE_SIZE;
+
+		if (pa == 0 || !pmap_valid_page(pn)) {
+			if (!b->whole) {
+				redwood_gpu_to_memory(b->kernel + off, n);
+				pushed += n;
+			}
+			continue;
+		}
+		if (!b->whole || pmap_is_modified(pn)) {
+			pmap_clear_modify(pn);
+			redwood_gpu_to_memory(b->kernel + off, n);
+			pushed += n;
+		}
+	}
+	b->whole = true;
+	return pushed;
+}
