+/*
+ * 0097: what the last second looked like. This thread runs even when swaps and
+ * vsyncs stop, so the last line before a freeze says whether the kernel was
+ * still scheduling (and how long the GPU had been stuck), or whether the
+ * machine itself stopped.
+ */
+void
+AppleCLCD::statsMain(void *self, wait_result_t result __unused)
+{
+	((AppleCLCD *)self)->statsReport();
+}
+
+void
+AppleCLCD::statsReport(void)
+{
+	for (;;) {
+		IOSleep(1000);
+		uint64_t now = mach_absolute_time();
+		uint64_t window = 0, swapgap, vsyncgap, psum, pmax;
+		uint32_t swaps, late, presents, stale, stalls;
+		uint64_t wired = 0;
+		uint32_t live = 0, zombies = 0, failed = 0;
+
+		if (fStatLock == NULL) {
+			continue;
+		}
+		IOLockLock(fStatLock);
+		absolutetime_to_nanoseconds(now - fStatWindow, &window);
+		swapgap = fStatSwapGapMax;
+		vsyncgap = fStatVsyncGapMax;
+		psum = fStatPresentSum;
+		pmax = fStatPresentMax;
+		swaps = fStatSwaps;
+		late = fStatLateSwaps;
+		presents = fStatPresents;
+		stale = fStatStale;
+		fStatWindow = now;
+		fStatSwapGapMax = 0;
+		fStatVsyncGapMax = 0;
+		fStatPresentSum = 0;
+		fStatPresentMax = 0;
+		fStatSwaps = 0;
+		fStatLateSwaps = 0;
+		fStatPresents = 0;
+		fStatStale = 0;
+		IOLockUnlock(fStatLock);
+		sweet_surface_stats(&wired, &live, &zombies, &failed);
+		uint32_t pending = redwood_gpu_pending_ms();
+		IOLog("SWEET FPS: %u swaps in %llu ms (%llu ms longest, %u late), %u presents (%llu us average, "
+		    "%llu us longest, %u waited for the GPU), vsync timer %llu ms longest; GPU %u ms pending (fence %u); "
+		    "%u surfaces, %u zombies, %llu MB wired, %u creates failed\n", swaps, window / 1000000,
+		    swapgap / 1000000, late, presents, presents ? psum / 1000 / presents : 0, pmax / 1000, stale,
+		    vsyncgap / 1000000, pending, redwood_gpu_last(), live, zombies, wired >> 20, failed);
+		if (pending > 1000) {
+			IOLockLock(fStatLock);
+			stalls = ++fStatStalls;
+			IOLockUnlock(fStatLock);
+			if (stalls <= 5 || (stalls % 10) == 0) {
+				redwood_gpu_report("no answer (statistics)");
+			}
+		}
+		/*
+		 * Nothing put on the panel this second while a swap waits: say what it
+		 * names and how far the GPU got with it (the freeze, in one line).
+		 */
+		if (presents == 0 && stale != 0) {
+			uint8_t rec[SWEET_FB_SWAP_REC_SIZE];
+			bool dirty;
+			IOLockLock(fLock);
+			dirty = fDirty;
+			memcpy(rec, fPending, sizeof(rec));
+			IOLockUnlock(fLock);
+			if (dirty) {
+				uint32_t mask = get32(rec, 0x104);
+				for (uint32_t layer = 0; layer < SWEET_FB_LAYERS; layer++) {
+					uint32_t id = get32(rec, 0x54 + 4 * layer);
+					SweetSurface *s;
+					if (!(mask & (1u << layer)) || id == 0) {
+						continue;
+					}
+					s = sweet_surface_copy(id);
+					IOLog("SWEET FB: waiting swap %u layer %u surface %u: GPU fence %u, %s, %ux%u bpr %u\n",
+					    get32(rec, 0x50), layer, id, s != NULL ? s->drawn : 0,
+					    s != NULL && s->gpuPool ? "GPU pool" : "ordinary memory",
+					    s != NULL ? s->width : 0, s != NULL ? s->height : 0,
+					    s != NULL ? s->bytesPerRow : 0);
+					OSSafeReleaseNULL(s);
+				}
+			}
+		}
+	}
+}
