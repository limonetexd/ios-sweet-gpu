+/*
+ * 0097: how long the newest submission has been waiting, without logging
+ * (redwood_gpu_done() says it once, at 100 ms). The display's once-a-second
+ * line asks this: a number that keeps growing while frames are swapped is a
+ * GPU that has stopped, not an idle one.
+ */
+uint32_t
+redwood_gpu_pending_ms(void)
+{
+	if (shared == NULL || seqno == 0) {
+		return 0;
+	}
+	if ((int32_t)(*fence_word() - seqno) >= 0) {
+		return 0;
+	}
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time() - submitted_at[seqno % TIMED], &ns);
+	return (uint32_t)(ns / NSEC_PER_MSEC);
+}
