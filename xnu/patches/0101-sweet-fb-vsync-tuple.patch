diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 632db56..a21b517 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -290,10 +290,16 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 		fb->fStatLastVsync = now;
 		IOLockUnlock(fb->fStatLock);
 	}
+	/*
+	 * 0101 (ios-topaz 0945, HackiOS MiniIOMobileFramebuffer): QuartzCore reads three
+	 * 64-bit numbers as six 32-bit halves -- the time of this refresh, the time it was
+	 * presented, and a counter. The counter came first here: with CA_FORCE_TIMER its
+	 * frame clock took the count for a time and paced frames ~24 a second.
+	 */
 	uint64_t values[6] = {
-		(uint32_t)count, (uint32_t)(count >> 32),
 		(uint32_t)now, (uint32_t)(now >> 32),
-		0, 0,
+		(uint32_t)now, (uint32_t)(now >> 32),
+		(uint32_t)count, (uint32_t)(count >> 32),
 	};
 
 	IOLockLock(fb->fLock);
