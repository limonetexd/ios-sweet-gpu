+/*
+ * 0142: the copy shared with the helpers that wait for one: each takes bands until none is left,
+ * this thread too; done when every helper counted in is back (the job is on this stack).
+ */
 void
 AppleCLCD::copy(SweetCopyJob *job)
 {
+	if (fCopyLock == NULL || job->bands < 2) {
+		(void)sweet_fb_copy_bands(job);
+		return;
+	}
+	IOLockLock(fCopyLock);
+	if (fCopyHelpers == 0) {
+		IOLockUnlock(fCopyLock);
+		(void)sweet_fb_copy_bands(job);
+		return;
+	}
+	fCopyJob = job;
+	fCopyBusy = fCopyHelpers;
+	fCopyGeneration++;
+	IOLockWakeup(fCopyLock, &fCopyGeneration, false);
+	IOLockUnlock(fCopyLock);
 	(void)sweet_fb_copy_bands(job);
+	IOLockLock(fCopyLock);
+	while (fCopyBusy != 0) {
+		IOLockSleep(fCopyLock, &fCopyBusy, THREAD_UNINT);
+	}
+	fCopyJob = NULL;
+	IOLockUnlock(fCopyLock);
+}
+
+void
+AppleCLCD::copyHelperMain(void *self, wait_result_t result __unused)
+{
+	((AppleCLCD *)self)->copyHelper();
+}
+
+/* 0142: a helper of the copy; counted in from the next copy shared out after it started. */
+void
+AppleCLCD::copyHelper(void)
+{
+	IOLockLock(fCopyLock);
+	uint32_t seen = fCopyGeneration;
+	fCopyHelpers++;
+	for (;;) {
+		while (fCopyGeneration == seen) {
+			IOLockSleep(fCopyLock, &fCopyGeneration, THREAD_UNINT);
+		}
+		seen = fCopyGeneration;
+		SweetCopyJob *job = fCopyJob;
+		IOLockUnlock(fCopyLock);
+		if (job != NULL) {
+			(void)sweet_fb_copy_bands(job);
+		}
+		IOLockLock(fCopyLock);
+		if (fCopyBusy != 0 && --fCopyBusy == 0) {
+			IOLockWakeup(fCopyLock, &fCopyBusy, true);
+		}
+	}
 }
 
