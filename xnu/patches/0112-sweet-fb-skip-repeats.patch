+/*
+ * 0143: whether the swap shows what the panel has already: the same layers, rectangles and
+ * surfaces, each drawn by the GPU (a CPU drawing gives no sign of a change but its unlock seed)
+ * with neither a GPU submission naming it nor a write unlock since. The key is kept for the next.
+ */
+bool
+AppleCLCD::shownAgain(const uint8_t *rec)
+{
+	uint8_t key[sizeof(fShown)];
+	uint32_t mask = get32(rec, 0x104) & ((1u << SWEET_FB_LAYERS) - 1);
+	bool usable = fSkipRepeats, again;
+
+	bzero(key, sizeof(key));
+	memcpy(key, &mask, 4);
+	for (uint32_t layer = 0; layer < SWEET_FB_LAYERS && usable; layer++) {
+		uint8_t *k = key + 4 + 44 * layer;
+		uint32_t id = get32(rec, 0x54 + 4 * layer), fence, seed;
+		if (!(mask & (1u << layer)) || id == 0) {
+			continue;
+		}
+		SweetSurface *s = sweet_surface_copy(id);
+		if (s == NULL || s == fSurface || s->drawn == 0 || s->state == NULL) {
+			usable = false;
+		} else {
+			fence = s->drawn;
+			/* SWEET_SURFACE_STATE_SEED: bumped by every unlock for writing (SweetSurface.cpp) */
+			seed = *(volatile uint32_t *)((uint8_t *)s->state->getBytesNoCopy() + 0xc);
+			memcpy(k, &id, 4);
+			memcpy(k + 4, &fence, 4);
+			memcpy(k + 8, &seed, 4);
+			memcpy(k + 12, rec + 0x64 + 16 * layer, 16);
+			memcpy(k + 28, rec + 0xc4 + 16 * layer, 16);
+		}
+		OSSafeReleaseNULL(s);
+	}
+	IOLockLock(fLock);
+	again = usable && fShownValid && memcmp(key, fShown, sizeof(key)) == 0;
+	memcpy(fShown, key, sizeof(key));
+	fShownValid = usable;
+	IOLockUnlock(fLock);
+	return again;
+}
