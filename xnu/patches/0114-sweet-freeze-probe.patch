+/*
+ * 0120 (freeze probe): what is under way in here, for the display's once-a-second line
+ * (SweetFramebuffer.cpp): every request of a program's from its start to its end, the step
+ * of a buffer's making it is at, and who holds gGPULock since when. backboardd's CoreAnimation
+ * thread was found inside GEM_NEW (glTexImage2D -> msm_bo_new) 56 s into a freeze with the GPU
+ * idle (logs/xnu-0101s0-freeze.txt, sample 1): a request that stays in here for seconds is
+ * named, with its thread's kernel backtrace (sweet_thread_dump(), osfmk/kern/exception.c).
+ */
+#define GPU_INFLIGHT            16
+struct gpu_inflight {
+	thread_t thread;
+	uint32_t selector, stage;
+	uint64_t began, size;
+};
+static struct gpu_inflight gInflight[GPU_INFLIGHT];
+static IOLock * gInflightLock;                  /* around gInflight[] slots being taken and given back */
+static thread_t volatile gGPULockOwner;
+static uint64_t volatile gGPULockSince;
+static const char * const gStageNames[] = {
+	"the request", "a kept buffer (gGPULock)", "a GPU pool range", "zeroing the pool range",
+	"the pool buffer into the GPU (gGPULock)", "IOBufferMemoryDescriptor", "cleaning it out of the cache",
+	"the buffer into the GPU (gGPULock)", "waiting for the GPU", "mapping a buffer (gGPULock)",
+};
+extern "C" void sweet_thread_dump(const char * tag, thread_t thread);    /* osfmk/kern/exception.c */
+extern "C" uint32_t redwood_gpu_inflight_ms(void);
+extern "C" void redwood_gpu_inflight_report(uint64_t min_ms);
+
+static void
+gpuLock(void)
+{
+	IOLockLock(gGPULock);
+	gGPULockOwner = IOThreadSelf();
+	gGPULockSince = mach_absolute_time();
+}
+
+static void
+gpuUnlock(void)
+{
+	gGPULockOwner = NULL;
+	IOLockUnlock(gGPULock);
+}
+
+static int
+inflightBegin(uint32_t selector, uint64_t size)
+{
+	int slot = -1;
+
+	if (gInflightLock == NULL) {
+		return -1;
+	}
+	IOLockLock(gInflightLock);
+	for (int i = 0; i < GPU_INFLIGHT; i++) {
+		if (gInflight[i].thread == NULL) {
+			gInflight[i].selector = selector;
+			gInflight[i].stage = 0;
+			gInflight[i].size = size;
+			gInflight[i].began = mach_absolute_time();
+			gInflight[i].thread = IOThreadSelf();
+			slot = i;
+			break;
+		}
+	}
+	IOLockUnlock(gInflightLock);
+	return slot;
+}
+
+static void
+inflightEnd(int slot)
+{
+	if (slot >= 0) {
+		IOLockLock(gInflightLock);
+		gInflight[slot].thread = NULL;
+		IOLockUnlock(gInflightLock);
+	}
+}
+
+/* the step this thread's request is at (its own slot: no lock) */
+static void
+inflightStage(uint32_t stage)
+{
+	thread_t self = IOThreadSelf();
+
+	for (int i = 0; i < GPU_INFLIGHT; i++) {
+		if (gInflight[i].thread == self) {
+			gInflight[i].stage = stage;
+			return;
+		}
+	}
+}
+
+static const char *
+requestName(uint32_t selector)
+{
+	switch (selector) {
+	case 0x09: return "GEM_CLOSE";
+	case 0x40: return "GET_PARAM";
+	case 0x42: return "GEM_NEW";
+	case 0x43: return "GEM_INFO";
+	case 0x44: return "GEM_CPU_PREP";
+	case 0x46: return "GEM_SUBMIT";
+	case 0x47: return "WAIT_FENCE";
+	case 0x7e: return "SURFACE";
+	case 0x1000: return "map";
+	default: return "other";
+	}
+}
+
+/* 0120: how long the oldest request still in here has been (ms; 0: none) */
+uint32_t
+redwood_gpu_inflight_ms(void)
+{
+	uint64_t now = mach_absolute_time(), oldest = 0, ns;
+
+	for (int i = 0; i < GPU_INFLIGHT; i++) {
+		uint64_t began = gInflight[i].began;
+		if (gInflight[i].thread != NULL && now > began && now - began > oldest) {
+			oldest = now - began;
+		}
+	}
+	absolutetime_to_nanoseconds(oldest, &ns);
+	return (uint32_t)(ns / NSEC_PER_MSEC);
+}
+
+/* 0120: every request in here for min_ms or longer, with its thread's backtraces; and gGPULock's holder */
+void
+redwood_gpu_inflight_report(uint64_t min_ms)
+{
+	uint64_t now = mach_absolute_time(), ns;
+	thread_t owner = gGPULockOwner;
+	bool owner_told = owner == NULL;
+
+	if (gInflightLock == NULL) {
+		return;
+	}
+	IOLockLock(gInflightLock);
+	for (int i = 0; i < GPU_INFLIGHT; i++) {
+		struct gpu_inflight * f = &gInflight[i];
+		if (f->thread == NULL) {
+			continue;
+		}
+		absolutetime_to_nanoseconds(now - f->began, &ns);
+		if (ns / NSEC_PER_MSEC < min_ms) {
+			continue;
+		}
+		IOLog("SWEET FREEZE: RedwoodGPU %s (%#x, %llu bytes) in here for %llu ms, at %s; thread %#llx%s\n",
+		    requestName(f->selector), f->selector, f->size, ns / NSEC_PER_MSEC,
+		    f->stage < sizeof(gStageNames) / sizeof(gStageNames[0]) ? gStageNames[f->stage] : "?",
+		    (uint64_t)(uintptr_t)f->thread, f->thread == owner ? ", holds gGPULock" : "");
+		sweet_thread_dump("FRZ gpu", f->thread);
+		owner_told = owner_told || f->thread == owner;
+	}
+	IOLockUnlock(gInflightLock);
+	if (owner != NULL) {
+		absolutetime_to_nanoseconds(now - gGPULockSince, &ns);
+		IOLog("SWEET FREEZE: gGPULock %#llx held for %llu ms by thread %#llx%s\n", (uint64_t)(uintptr_t)gGPULock,
+		    ns / NSEC_PER_MSEC, (uint64_t)(uintptr_t)owner, owner_told ? "" : " (not a request of a program's)");
+	} else {
+		IOLog("SWEET FREEZE: gGPULock %#llx free\n", (uint64_t)(uintptr_t)gGPULock);
+	}
+}
