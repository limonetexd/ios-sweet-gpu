 #include <kern/thread.h>
 #include <pexpert/pexpert.h>
+#include <libkern/OSAtomic.h>
 
 extern task_t proc_task(proc_t);
 extern int hz;
@@ -86,3 +87,83 @@ sweet_sample_start(void)
 		thread_deallocate(thread);
 	}
 }
+
+/*
+ * 0120 freeze probe: SweetFramebuffer.cpp's once-a-second line saw no frame for seconds while the
+ * screen was touched, or RedwoodGPU has had a request in it for seconds. On a thread of its own
+ * (a process walk can wait on a process in exec; the display's thread must not): RedwoodGPU's
+ * requests in flight with their threads, then every thread of the processes in boot-arg
+ * sweetfreeze_names (default "backboardd,SpringBoard"), user and kernel backtraces ("FRZ").
+ */
+extern void sweet_freeze_task(const char *name, int pid, task_t task);  /* osfmk/kern/exception.c */
+extern void redwood_gpu_inflight_report(uint64_t min_ms);              /* iokit/Kernel/arm/RedwoodGPU.cpp */
+extern void sweet_freeze_dump(const char *why);
+
+static char sweet_freeze_names[128];
+static char sweet_freeze_why[96];
+static volatile SInt32 sweet_freeze_busy;
+static int sweet_freeze_count;
+
+static bool
+sweet_freeze_wanted(const char *name)
+{
+	size_t n = strlen(name);
+	for (const char *t = sweet_freeze_names; *t;) {
+		const char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+		if (tl == n && n > 0 && strncmp(t, name, n) == 0) {
+			return true;
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+	return false;
+}
+
+static int
+sweet_freeze_proc(proc_t p, __unused void *arg)
+{
+	char name[32];
+	proc_name(proc_pid(p), name, sizeof(name));
+	if (sweet_freeze_wanted(name)) {
+		task_t task = proc_task(p);
+		if (task != TASK_NULL) {
+			sweet_freeze_task(name, proc_pid(p), task);
+		}
+	}
+	return PROC_RETURNED;
+}
+
+static void
+sweet_freeze_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	printf("FRZ --- dump %d: %s\n", sweet_freeze_count, sweet_freeze_why);
+	redwood_gpu_inflight_report(500);
+	proc_iterate(PROC_ALLPROCLIST, sweet_freeze_proc, NULL, NULL, NULL);
+	printf("FRZ --- dump %d done\n", sweet_freeze_count);
+	OSCompareAndSwap(1, 0, (volatile UInt32 *)&sweet_freeze_busy);
+}
+
+void
+sweet_freeze_dump(const char *why)
+{
+	thread_t thread;
+
+	if (sweet_freeze_names[0] == 0 &&
+	    !PE_parse_boot_argn("sweetfreeze_names", sweet_freeze_names, sizeof(sweet_freeze_names))) {
+		strlcpy(sweet_freeze_names, "backboardd,SpringBoard", sizeof(sweet_freeze_names));
+	}
+	if (!OSCompareAndSwap(0, 1, (volatile UInt32 *)&sweet_freeze_busy)) {
+		printf("FRZ: a dump is still being made (it waits on something itself)\n");
+		return;
+	}
+	sweet_freeze_count++;
+	strlcpy(sweet_freeze_why, why, sizeof(sweet_freeze_why));
+	if (kernel_thread_start(sweet_freeze_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		sweet_freeze_busy = 0;
+	}
+}
--- a/iokit/Kernel/arm/RedwoodGPU.cpp
+++ b/iokit/Kernel/arm/RedwoodGPU.cpp
@@ -200,6 +200,167 @@ static struct {
 	uint64_t making;                        /* ... and the time it took to make the others */
