+/*
+ * 0120 freeze probe: one thread as it is now -- scheduler state, what it waits on, the user
+ * pc/lr and frame-pointer backtrace from its saved user state, and, when it is off core in
+ * the kernel, the kernel backtrace from its saved kernel context (addresses unslid, for
+ * llvm-symbolizer / nm against kernel.development.sweet). Lines "FRZ TAG ...". The caller
+ * keeps the thread from going away (its task's lock, or RedwoodGPU's request table).
+ */
+void sweet_thread_dump(const char *tag, thread_t thread);
+void sweet_freeze_task(const char *name, int pid, task_t task);
+
+void
+sweet_thread_dump(const char *tag, thread_t thread)
+{
+	char line[200];
+	int n;
+	task_t task = get_threadtask(thread);
+	vm_map_t map = task != TASK_NULL ? get_task_map(task) : VM_MAP_NULL;
+	arm_saved_state_t *ss = task != kernel_task ? find_user_regs(thread) : NULL;
+
+	printf("FRZ %s thread 0x%llx tid %llu state 0x%x hint %d event 0x%llx pri %d%s\n", tag,
+	    (uint64_t)(uintptr_t)thread, thread_tid(thread), thread->state, (int)thread->block_hint,
+	    (uint64_t)thread->wait_event, (int)thread->sched_pri, thread == current_thread() ? " (this one)" : "");
+	if (ss != NULL && is_saved_state64(ss) && map != VM_MAP_NULL) {
+		uint64_t fp = get_saved_state_fp(ss);
+		n = snprintf(line, sizeof(line), "FRZ %s user pc 0x%llx lr 0x%llx bt", tag, get_saved_state_pc(ss),
+		    get_saved_state_lr(ss));
+		for (int i = 0; i < 24 && fp != 0 && (fp & 7) == 0; i++) {
+			uint64_t frame[2];
+			if (vm_map_read_user(map, fp, frame, sizeof(frame)) != KERN_SUCCESS) {
+				break;
+			}
+			if (n > (int)sizeof(line) - 24) {
+				printf("%s\n", line);
+				n = snprintf(line, sizeof(line), "FRZ %s user bt+", tag);
+			}
+			n += snprintf(line + n, sizeof(line) - n, " 0x%llx", frame[1]);
+			if (frame[0] <= fp) {
+				break;
+			}
+			fp = frame[0];
+		}
+		printf("%s\n", line);
+	}
+	if (thread == current_thread()) {
+		return;
+	}
+	if (thread->kernel_stack == 0) {
+		printf("FRZ %s kernel: no stack, continuation 0x%lx\n", tag, VM_KERNEL_UNSLIDE((vm_offset_t)thread->continuation));
+		return;
+	}
+	if (thread->machine.kstackptr == 0) {
+		return;
+	}
+	arm_kernel_saved_state_t *ks = &((thread_kernel_state_t)thread->machine.kstackptr)->machine.ss;
+	vm_offset_t lo = thread->kernel_stack, hi = thread->kernel_stack + kernel_stack_size;
+	uint64_t fp = ks->fp;
+	n = snprintf(line, sizeof(line), "FRZ %s kernel%s lr 0x%lx bt", tag, (thread->state & TH_RUN) ? " (on core?)" : "",
+	    VM_KERNEL_UNSLIDE((vm_offset_t)ks->lr));
+	for (int i = 0; i < 24 && fp >= lo && fp + 16 <= hi && (fp & 7) == 0; i++) {
+		uint64_t *frame = (uint64_t *)fp;
+		if (n > (int)sizeof(line) - 24) {
+			printf("%s\n", line);
+			n = snprintf(line, sizeof(line), "FRZ %s kernel bt+", tag);
+		}
+		n += snprintf(line + n, sizeof(line) - n, " 0x%lx", VM_KERNEL_UNSLIDE((vm_offset_t)frame[1]));
+		if (frame[0] <= fp) {
+			break;
+		}
+		fp = frame[0];
+	}
+	printf("%s\n", line);
+}
+
+/* 0120: every thread of a task (task_lock_try: a task whose lock is held is said so, not waited for) */
+void
+sweet_freeze_task(const char *name, int pid, task_t task)
+{
+	vm_shared_region_t sr = vm_shared_region_get(task);
+	uint64_t slide = 0;
+	int tn = 0;
+	thread_t thread;
+
+	if (sr != NULL) {
+		slide = sr->sr_slide;
+		vm_shared_region_deallocate(sr);
+	}
+	printf("FRZ %s[%d] slide 0x%llx mh 0x%llx kernel slide 0x%lx\n", name, pid, slide, task->mach_header_vm_address,
+	    vm_kernel_slide);
+	if (!task_lock_try(task)) {
+		printf("FRZ %s[%d]: its task lock is held: threads not walked\n", name, pid);
+		return;
+	}
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		char tag[40];
+		snprintf(tag, sizeof(tag), "%s t%d", name, tn++);
+		sweet_thread_dump(tag, thread);
+	}
+	task_unlock(task);
+}
