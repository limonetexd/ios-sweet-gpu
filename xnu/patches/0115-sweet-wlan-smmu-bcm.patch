diff --git a/bsd/dev/sweet_rpmh.c b/bsd/dev/sweet_rpmh.c
index 1ae3874..df06555 100644
--- a/bsd/dev/sweet_rpmh.c
+++ b/bsd/dev/sweet_rpmh.c
@@ -602,4 +602,45 @@ out:
 	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
 	return error;
 }
+
+/*
+ * Wi-Fi port 0132 (DC28088 0149): a bus (BCM) vote from the kernel. The apps
+ * SMMU (0x15000000) sits behind the path its downstream node votes (msm-bus
+ * 161 -> 627 = BCMs SN15 and CN0, active-only, 1000 KBps). Command:
+ * commit|valid|x<<14|y as Linux's BCM_TCS_CMD. Only those two BCMs and only
+ * small nonzero levels; called by sweet_wlan_smmu.c (sweetsmmuwlan=1|2) and
+ * by /dev/pmem before an apps-SMMU access.
+ */
+int sweet_rpmh_bcm_vote(const char *res, uint32_t x, uint32_t y);
+int
+sweet_rpmh_bcm_vote(const char *res, uint32_t x, uint32_t y)
+{
+	if (!res || (strcmp(res, "SN15") && strcmp(res, "CN0")) || x > 16 || y > 16 || (!x && !y)) {
+		return EPERM;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	unsigned aux_len = 0;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing BCM vote\n");
+	} else {
+		error = rh_map();
+		if (!error) {
+			error = rh_lookup_ex(res, RH_BCM, &address, &aux_len);
+		}
+		if (!error) {
+			const uint32_t offset = 0, value = (1u << 30) | (1u << 29) | (x << 14) | y;
+			static unsigned bcm_logged;
+			error = rh_send_n(address, 3u, 1, &offset, &value, RH_TIMEOUT_US);
+			if (error || ++bcm_logged <= 4) {
+				printf("SWEET RPMH: BCM %s addr=%#x vote %#x -> %d\n", res, address, value, error);
+			}
+		}
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
