diff --git a/bsd/dev/sweet_wlan_smmu.c b/bsd/dev/sweet_wlan_smmu.c
new file mode 100644
index 0000000..d306c27
--- /dev/null
+++ b/bsd/dev/sweet_wlan_smmu.c
@@ -0,0 +1,182 @@
+/*
+ * WCN3990 (WLAN) SMMU stream, programmed by the kernel at boot (Wi-Fi port
+ * 0132, behaviour from DC28088 0149/0150/0152/0153).
+ *
+ * Why in the kernel: the apps SMMU (0x15000000) sits behind the bus path
+ * SN15+CN0 (msm-bus 161 -> 627). Without an active-only BCM vote on those two
+ * BCMs the FIRST read of an apps-SMMU register stalls the CPU for good (and
+ * every per-CPU timer queued on it never fires). With the votes held, the
+ * kernel can read the ID registers and program the stream, so wland (told by
+ * the same boot-arg) never touches the SMMU.
+ *
+ * RISKY, so OFF by default:
+ *   sweetsmmuwlan=1   BCM votes at boot, then (thread, 1 s later) program
+ *                     SID 0x240 mask 1 -> lowest free SMR -> free context bank
+ *                     (translation off, like ABL's banks)
+ *   sweetsmmuwlan=2   BCM votes only (bisect aid: no SMMU register is touched)
+ * The GPU's streams (programmed by the shim; GPU 0, GMU 5, exact IDs, mask 0)
+ * are never modified: a used SMR/bank is skipped, a matching SMR is reused.
+ * Liveness check on a test boot: "SWEET FPS" keeps ticking and touch works.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+extern void IOSleep(unsigned);
+extern int sweet_rpmh_bcm_vote(const char *res, uint32_t x, uint32_t y);
+void sweet_wlan_smmu_start(void);
+
+#define SMMU_PA         0x15000000u
+#define SMMU_WLAN_SID   0x240u
+#define SMMU_WLAN_MASK  0x1u
+
+static bool
+smmu_sid_match(uint32_t smr, uint32_t sid, uint32_t mask)
+{
+	uint32_t id = smr & 0x7fff, m = (smr >> 16) & 0x7fff;
+	return ((id ^ sid) & ~(m | mask) & 0x7fff) == 0;
+}
+
+/*
+ * wland's smmu_wlan_identity() done here: lowest free SMR, a context bank no
+ * valid SMR points at with CBAR == 0 and SCTLR.M == 0; CBAR 0x1f000 (S1
+ * translate, S2 bypass as ABL's banks), CBA2R AArch64, SCTLR 0xe0 (fault
+ * reporting, M=0, i.e. translation off); S2CR type 0 -> that bank.
+ */
+static void
+sweet_smmu_wlan_stream(volatile uint32_t *gr0, uint32_t id0, uint32_t id1)
+{
+	const uint32_t nsmr = id0 & 0xff, ncb = id1 & 0xff;
+	const uint64_t psize = (id1 >> 31) ? 0x10000 : 0x1000, npage = 1ull << (((id1 >> 28) & 7) + 1);
+	if (psize != 0x1000 || nsmr > 128 || ncb > 128 || (npage + ncb) * psize > 0x100000) {
+		printf("SWEET SMMU: WLAN stream: unexpected geometry smr=%u cb=%u page=%#llx x %llu\n",
+		    nsmr, ncb, psize, npage);
+		return;
+	}
+	volatile uint32_t *gr1 = (volatile uint32_t *)ml_io_map(SMMU_PA + psize, psize);
+	if (!gr1) {
+		printf("SWEET SMMU: WLAN stream: GR1 map failed\n");
+		return;
+	}
+	uint64_t used[2] = {0, 0};
+	int slot = -1;
+	for (uint32_t i = 0; i < nsmr; i++) {
+		const uint32_t smr = gr0[(0x800 + 4 * i) / 4], s2cr = gr0[(0xc00 + 4 * i) / 4];
+		if (!(smr >> 31)) {
+			if (slot < 0) {
+				slot = (int)i;
+			}
+			continue;
+		}
+		if (((s2cr >> 16) & 3) == 0) {
+			used[(s2cr & 0xff) / 64] |= 1ull << ((s2cr & 0xff) % 64);
+		}
+		if (smmu_sid_match(smr, SMMU_WLAN_SID, SMMU_WLAN_MASK)) {
+			printf("SWEET SMMU: WLAN stream: SMR%u %#x already matches (S2CR %#x)\n", i, smr, s2cr);
+			return;
+		}
+	}
+	int cb = -1;
+	volatile uint32_t *cbp = NULL;
+	for (uint32_t c = 0; c < ncb && cb < 0; c++) {
+		if ((used[c / 64] & (1ull << (c % 64))) || gr1[c] != 0) {
+			continue;
+		}
+		volatile uint32_t *page = (volatile uint32_t *)ml_io_map(SMMU_PA + (npage + c) * psize, psize);
+		if (page && !(page[0] & 1)) {
+			cb = (int)c;
+			cbp = page;
+		}
+	}
+	if (slot < 0 || cb < 0) {
+		printf("SWEET SMMU: WLAN stream: no free SMR/bank (SMR %d, bank %d)\n", slot, cb);
+		return;
+	}
+	cbp[0x58 / 4] = 0xffffffff;     /* FSR clear */
+	cbp[0x20 / 4] = 0;              /* TTBR0 */
+	cbp[0x24 / 4] = 0;
+	cbp[0x30 / 4] = 0;              /* TCR */
+	cbp[0x10 / 4] = 0;              /* TCR2 */
+	cbp[0x38 / 4] = 0;              /* MAIR */
+	cbp[0x3c / 4] = 0;
+	gr1[(0x800 + 4 * cb) / 4] = 0x00000001;          /* CBA2R: AArch64 */
+	gr1[cb] = 0x0001f000;                             /* CBAR */
+	cbp[0] = 0x000000e0;                              /* SCTLR last */
+	gr0[(0xc00 + 4 * slot) / 4] = (uint32_t)cb;       /* S2CR: translate via the bank */
+	gr0[(0x800 + 4 * slot) / 4] = (1u << 31) | (SMMU_WLAN_MASK << 16) | SMMU_WLAN_SID;
+	gr0[0x70 / 4] = 0;                                /* sTLBGSYNC */
+	for (int i = 0; i < 1000 && (gr0[0x74 / 4] & 1); i++) {
+		delay(1000);
+	}
+	const uint32_t smr = gr0[(0x800 + 4 * slot) / 4], s2cr = gr0[(0xc00 + 4 * slot) / 4];
+	const bool ok = (smr >> 31) && smmu_sid_match(smr, SMMU_WLAN_SID, SMMU_WLAN_MASK) &&
+	    ((s2cr >> 16) & 3) == 0 && (s2cr & 0xff) == (uint32_t)cb;
+	printf("SWEET SMMU: WLAN %#x/%#x -> CB%d via SMR%d: SMR %#x S2CR %#x SCTLR %#x CBAR %#x -> %s\n",
+	    SMMU_WLAN_SID, SMMU_WLAN_MASK, cb, slot, smr, s2cr, cbp[0], gr1[cb], ok ? "ok" : "NOT as written");
+}
+
+static void
+sweet_wlan_smmu_thread(void *arg, wait_result_t wr)
+{
+	(void)wr;
+	const int votes_failed = (int)(uintptr_t)arg;
+	IOSleep(1000);
+	if (votes_failed) {
+		printf("SWEET SMMU: BCM votes failed; apps SMMU NOT touched\n");
+		return;
+	}
+	volatile uint32_t *smmu = (volatile uint32_t *)ml_io_map(SMMU_PA, 0x1000);
+	if (!smmu) {
+		printf("SWEET SMMU: map failed\n");
+		return;
+	}
+	printf("SWEET SMMU: reading apps SMMU sCR0/ID0/ID1 next (a stall here = votes not effective)\n");
+	const uint32_t scr0 = smmu[0];
+	printf("SWEET SMMU: sCR0=%#x\n", scr0);
+	const uint32_t id0 = smmu[0x20 / 4], id1 = smmu[0x24 / 4];
+	printf("SWEET SMMU: ID0=%#x ID1=%#x: %u SMRs, %u context banks\n", id0, id1, id0 & 0xff, id1 & 0xff);
+	sweet_smmu_wlan_stream(smmu, id0, id1);
+}
+
+static int
+vote_retry(const char *res)
+{
+	int err = EBUSY;
+	for (int i = 0; i < 5 && err == EBUSY; i++) {
+		err = sweet_rpmh_bcm_vote(res, 1, 1);
+		if (err == EBUSY) {
+			delay(20000);
+		}
+	}
+	return err;
+}
+
+void
+sweet_wlan_smmu_start(void)
+{
+	int mode = 0;
+	PE_parse_boot_argn("sweetsmmuwlan", &mode, sizeof(mode));
+	if (mode != 1 && mode != 2) {
+		return;
+	}
+	/* In bsd init, so the path is up long before launchd can start wland. */
+	const int sn = vote_retry("SN15"), cn = vote_retry("CN0");
+	printf("SWEET SMMU: BCM votes SN15=%d CN0=%d (sweetsmmuwlan=%d)\n", sn, cn, mode);
+	if (mode != 1) {
+		return;
+	}
+	thread_t thread = THREAD_NULL;
+	if (kernel_thread_start(sweet_wlan_smmu_thread, (void *)(uintptr_t)(sn || cn), &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+		printf("SWEET SMMU: WLAN stream thread armed (1 s)\n");
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
