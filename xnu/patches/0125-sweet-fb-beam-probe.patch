 void
+AppleCLCD::beamProbeMain(void *self, wait_result_t result __unused)
+{
+	((AppleCLCD *)self)->beamProbe();
+}
+
+/* 0144: which interface scans the panel out, and whether its counters count as they should. */
+void
+AppleCLCD::beamProbe(void)
+{
+	uint64_t named = 0, candidates[2] = { SWEET_INTF1_PA, SWEET_INTF2_PA };
+	unsigned count = 2;
+
+	IOSleep(10000);
+	if (PE_parse_boot_argn("sweetfb_intf", &named, sizeof(named)) && named != 0) {
+		candidates[0] = named;
+		count = 1;
+	}
+	for (unsigned i = 0; i < count; i++) {
+		uint64_t pa = candidates[i];
+		vm_offset_t base = ml_io_map((vm_offset_t)(pa & ~(SWEET_INTF_WINDOW - 1)), (vm_size_t)SWEET_INTF_WINDOW);
+		if (base == 0) {
+			IOLog("SWEET BEAM: no mapping for 0x%llx\n", pa);
+			continue;
+		}
+		vm_offset_t intf = base + (vm_offset_t)(pa & (SWEET_INTF_WINDOW - 1));
+		uint32_t on = *(volatile uint32_t *)(intf + INTF_TIMING_ENGINE_EN);
+		IOLog("SWEET BEAM: INTF 0x%llx: timing engine 0x%x, count enable 0x%x, frame %u, line %u\n", pa, on,
+		    *(volatile uint32_t *)(intf + INTF_FRAME_LINE_COUNT_EN), *(volatile uint32_t *)(intf + INTF_FRAME_COUNT),
+		    *(volatile uint32_t *)(intf + INTF_LINE_COUNT));
+		if ((on & 1) && beamMeasure(intf)) {
+			return;
+		}
+	}
+	IOLog("SWEET BEAM: no interface counts the panel's scan: frames stay on the vsync timer\n");
+}
+
+/*
+ * 0144: lines a scan (the largest line seen in 50 ms, at least the panel's height, less than
+ * twice it) and the scan's length (from frame counts over half a second); the interface is
+ * used (fBeamIntf) only with sweetfb_beam=2 and only if both look right.
+ */
+bool
+AppleCLCD::beamMeasure(vm_offset_t intf)
+{
+	uint32_t first, frames, line, lines = 0, smallest = ~0u;
+	uint64_t began, ended, until, ns;
+
+	first = *(volatile uint32_t *)(intf + INTF_FRAME_COUNT);
+	nanoseconds_to_absolutetime(100 * NSEC_PER_MSEC, &until);
+	until += mach_absolute_time();
+	while (*(volatile uint32_t *)(intf + INTF_FRAME_COUNT) == first && mach_absolute_time() < until) {
+	}
+	began = mach_absolute_time();
+	first = *(volatile uint32_t *)(intf + INTF_FRAME_COUNT);
+	nanoseconds_to_absolutetime(50 * NSEC_PER_MSEC, &until);
+	until += began;
+	while (mach_absolute_time() < until) {
+		line = *(volatile uint32_t *)(intf + INTF_LINE_COUNT);
+		lines = line > lines ? line : lines;
+		smallest = line < smallest ? line : smallest;
+	}
+	IOSleep(450);
+	frames = *(volatile uint32_t *)(intf + INTF_FRAME_COUNT);
+	nanoseconds_to_absolutetime(100 * NSEC_PER_MSEC, &until);
+	until += mach_absolute_time();
+	while (*(volatile uint32_t *)(intf + INTF_FRAME_COUNT) == frames && mach_absolute_time() < until) {
+	}
+	ended = mach_absolute_time();
+	frames = *(volatile uint32_t *)(intf + INTF_FRAME_COUNT) - first;
+	if (frames == 0 || lines < fHeight || lines >= fHeight * 2 || smallest > fHeight / 4) {
+		IOLog("SWEET BEAM: counters do not count a scan (%u frames, lines %u to %u)\n", frames, smallest, lines);
+		return false;
+	}
+	fBeamLines = lines + 1;
+	fBeamPeriod = (ended - began) / frames;
+	absolutetime_to_nanoseconds(fBeamPeriod, &ns);
+	IOLog("SWEET BEAM: the panel's scan is %u lines, %llu us (%llu.%01llu Hz)%s\n", fBeamLines, ns / 1000,
+	    ns ? 1000000000ULL / ns : 0, ns ? (10000000000ULL / ns) % 10 : 0,
+	    fBeamMode >= 2 ? ": frames are written behind it from now on" : "");
+	if (fBeamMode >= 2) {
+		__atomic_thread_fence(__ATOMIC_RELEASE);
+		fBeamIntf = intf;
+	}
+	return true;
+}
