From: HakiOS
Subject: [PATCH 0125] sweet: probe the panel interface's scan counters (beam, 0144)

Reads INTF_1/INTF_2's frame and line counters (sweet's DT: qcom,sde-intf-off
0x6b800 for DSI0) and measures the scan period; read-only unless
sweetfb_beam=2. Enables the beam-aware copy of 0127. Log: "SWEET BEAM: INTF
0x...: timing engine ..., frame ..., line ...".
---
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -45,6 +45,22 @@
 extern "C" void redwood_gpu_report(const char *why);
 
 extern "C" int sweet_console_muted;     /* osfmk/console/serial_console.c */
+extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+/*
+ * 0144: the display interface the panel is scanned out through (read only). sweet's DT (LineageOS
+ * boot.img): mdss_mdp@ae00000, qcom,sde-intf-off = <0x6b000 0x6b800 0x6c000 0x6c800>, types
+ * "dp", "dsi", "dsi", "dp": INTF_1 (DSI0) at 0x0ae6b800, INTF_2 (DSI1) at 0x0ae6c000. Register
+ * offsets as Linux's dpu_hw_intf.c / downstream sde_hw_intf.c. The panel is a DSC video-mode one
+ * (NOTES.md), so the timing engine left on by ABL counts frames and lines by itself.
+ */
+#define SWEET_INTF1_PA                  0x0ae6b800ULL
+#define SWEET_INTF2_PA                  0x0ae6c000ULL
+#define SWEET_INTF_WINDOW               0x4000ULL       /* one 16 KiB page per interface */
+#define INTF_TIMING_ENGINE_EN           0x000
+#define INTF_FRAME_LINE_COUNT_EN        0x0a8
+#define INTF_FRAME_COUNT                0x0ac
+#define INTF_LINE_COUNT                 0x0b0
 
 /*
  * 0152: osfmk/kern/sched_prim.c, osfmk/arm/cpu_common.c, osfmk/arm/machine_routines.h. The
@@ -145,6 +161,9 @@
 	void statsReport(void);
 	static void copyHelperMain(void *self, wait_result_t result);
 	void copyHelper(void);
+	static void beamProbeMain(void *self, wait_result_t result);
+	void beamProbe(void);
+	bool beamMeasure(vm_offset_t intf);
 
 public:
 	uint64_t      fPhys;
@@ -191,6 +210,11 @@
 	bool          fShownValid;            /* fShown is on the panel (false before any, after a fade) */
 	uint8_t       fShown[4 + SWEET_FB_LAYERS * 44];
 	uint32_t      fStatRepeats;           /* swaps left uncopied: the panel had them already */
+	/* 0144: the panel's scan, from the display interface's counters (boot-arg sweetfb_beam) */
+	uint32_t      fBeamMode;              /* 0 off, 1 measure and log only, 2 also write behind the scan (0146) */
+	vm_offset_t   fBeamIntf;              /* the interface's registers, once they were seen to count; else 0 */
+	uint32_t      fBeamLines;             /* lines a scan, blanking included */
+	uint64_t      fBeamPeriod;            /* mach ticks a scan */
 
 	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
 	void addClient(IOMobileFramebufferUserClient *client);
@@ -337,6 +361,18 @@
 	}
 
 	/*
+	 * 0144: boot-arg sweetfb_beam=1 reads the display interface's frame and line counters once,
+	 * ten seconds after start, and logs the panel's real refresh rate and lines ("SWEET BEAM:");
+	 * reads only. sweetfb_intf=PHYS names the interface's registers instead of INTF_1/INTF_2.
+	 */
+	PE_parse_boot_argn("sweetfb_beam", &fBeamMode, sizeof(fBeamMode));
+	if (fBeamMode != 0) {
+		thread_t thread;
+		if (kernel_thread_start(&AppleCLCD::beamProbeMain, this, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		}
+	}
+	/*
 	 * 0143: boot-arg sweetfb_skip=0 copies every swap; by default a swap of exactly the frame the
 	 * panel shows already (same GPU-drawn surfaces, fences, unlock seeds and rectangles) is not.
 	 */
