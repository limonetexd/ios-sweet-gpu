From: HakiOS
Subject: [PATCH 0138] sweet: the frame size follows the device tree again (native 1125x2436 by default)

0129 made the 750x1624 scaled frame the default through boot-arg sweetfb_scale (default 2),
whatever the device tree said, and tools/mkadt.py was switched to display-scale 2 / canvas
750x1624 at the same time. Every image built from main therefore booted the @2x UI on root
images made for the iPhone X's 1125x2436 @3x, and the 750 layout was never checked on the
phone. AppleCLCD and the touch digitizer now read /arm-io/disp0's canvas-width/height (what
IOMobileFramebuffer.framework reads too): 750x1624 (mkadt.py --scale2) selects 0129's scaled
path, anything else the native 1125x2436. mkadt.py's default is display-scale 3 / 1125x2436
again, so the kernel and the userland can no longer disagree. Boot-arg sweetfb_scale is gone.
---
diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index ed36d9c..01f0dc7 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -277,6 +277,19 @@ public:
 
 OSDefineMetaClassAndStructors(IOMobileFramebufferUserClient, IOUserClient);
 
+/* 0138: a u32 property of a device tree node (0: none) */
+static uint32_t
+sweet_dt_u32(IORegistryEntry *entry, const char *key)
+{
+	OSData *data = entry != NULL ? OSDynamicCast(OSData, entry->getProperty(key)) : NULL;
+	uint32_t value = 0;
+
+	if (data != NULL && data->getLength() >= sizeof(value)) {
+		memcpy(&value, data->getBytesNoCopy(), sizeof(value));
+	}
+	return value;
+}
+
 bool
 AppleCLCD::start(IOService *provider)
 {
@@ -308,9 +321,16 @@ AppleCLCD::start(IOService *provider)
 	fSrcX = fSrcY = 0;
 	fSrcW = fLogicalW;
 	fSrcH = fLogicalH;
-	uint32_t scale = 2;
-	PE_parse_boot_argn("sweetfb_scale", &scale, sizeof(scale));
-	if (scale >= 2 && !native && fWidth <= 1080 && fHeight <= 2400) {
+	/*
+	 * 0138: the frame size follows the device tree, as IOMobileFramebuffer.framework does: the
+	 * canvas-width/height of our provider (/arm-io/disp0, tools/mkadt.py). 750x1624 (mkadt.py
+	 * --scale2, display-scale 2) selects 0129's scaled path; anything else the iPhone X's own
+	 * 1125x2436 (display-scale 3, what the root images were made with). 0129 had made the scaled
+	 * path the default through boot-arg sweetfb_scale, whatever the device tree said.
+	 */
+	uint32_t canvasW = sweet_dt_u32(provider, "canvas-width");
+	uint32_t canvasH = sweet_dt_u32(provider, "canvas-height");
+	if (canvasW == 750 && canvasH == 1624 && !native && fWidth <= 1080 && fHeight <= 2400) {
 		/* 0129: iPhone X @2x in points, cropped 720x1600 and scaled 1.5x to the panel */
 		fLogicalW = 750;
 		fLogicalH = 1624;
@@ -321,6 +341,8 @@ AppleCLCD::start(IOService *provider)
 		fSrcW = 720;
 		fSrcH = 1600;
 	}
+	IOLog("SWEET FB: device tree canvas %ux%u: %ux%u frames%s\n", canvasW, canvasH, fLogicalW, fLogicalH,
+	    fScale ? ", cropped 720x1600 and scaled to the panel" : "");
 	fLock = IOLockAlloc();
 	fClients = OSArray::withCapacity(4);
 	fSurface = sweet_surface_create_physical(fPhys, fWidth, fHeight, fRowBytes, SWEET_FB_FORMAT_BGRA);
diff --git a/iokit/Kernel/arm/hid/SweetHID.cpp b/iokit/Kernel/arm/hid/SweetHID.cpp
index 85ecf3b..265f620 100644
--- a/iokit/Kernel/arm/hid/SweetHID.cpp
+++ b/iokit/Kernel/arm/hid/SweetHID.cpp
@@ -19,6 +19,7 @@
 #include <IOKit/IOLib.h>
 #include <IOKit/IOService.h>
 #include <IOKit/IOTimerEventSource.h>
+#include <IOKit/IODeviceTreeSupport.h>
 #include <libkern/c++/OSArray.h>
 #include <pexpert/pexpert.h>
 
@@ -435,9 +436,22 @@ SweetHIDTouch::start(IOService *provider)
 	}
 	int native = 0;
 	PE_parse_boot_argn("sweetfb_native", &native, sizeof(native));
-	int scale = 2;
-	PE_parse_boot_argn("sweetfb_scale", &scale, sizeof(scale));
-	fScale = scale >= 2 && !native;
+	/*
+	 * 0138: the frame size AppleCLCD uses, from the same device tree node (/arm-io/disp0's
+	 * canvas): 750x1624 is 0129's scaled frame, anything else the iPhone X's 1125x2436.
+	 */
+	uint32_t canvas[2] = { 0, 0 };
+	IORegistryEntry *disp = IORegistryEntry::fromPath("/arm-io/disp0", gIODTPlane);
+	if (disp != NULL) {
+		OSData *w = OSDynamicCast(OSData, disp->getProperty("canvas-width"));
+		OSData *h = OSDynamicCast(OSData, disp->getProperty("canvas-height"));
+		if (w != NULL && h != NULL && w->getLength() >= 4 && h->getLength() >= 4) {
+			memcpy(&canvas[0], w->getBytesNoCopy(), 4);
+			memcpy(&canvas[1], h->getBytesNoCopy(), 4);
+		}
+		disp->release();
+	}
+	fScale = canvas[0] == 750 && canvas[1] == 1624 && !native;
 	fLogicalW = fScale ? 750 : (native ? 1080 : 1125);
 	fLogicalH = fScale ? 1624 : (native ? 2400 : 2436);
 	fOffX = fScale ? 0 : (fLogicalW - 1080) / 2;
@@ -448,7 +462,7 @@ SweetHIDTouch::start(IOService *provider)
 	setProperty("SurfaceHeight", (unsigned long long)(151 << 16), 32);
 	gSweetTouch = this;
 	registerService();
-	IOLog("SWEET HID: touch registered\n");
+	IOLog("SWEET HID: touch registered (%ux%u frames)\n", fLogicalW, fLogicalH);
 	return true;
 }
 
