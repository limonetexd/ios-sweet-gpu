index 4150baa..bb12f3b 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -161,6 +161,8 @@ class AppleCLCD : public IOMobileFramebuffer {
