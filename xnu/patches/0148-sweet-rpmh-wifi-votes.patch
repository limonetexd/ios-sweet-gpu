From: HakiOS
Subject: [PATCH 0148] sweet wifi: RPMh votes via /dev/pmem for wland (0131 -> 0148)

Adds PMEM_RPMH ioctl to /dev/pmem and sweet_rpmh_write() kernel API for
active TCS votes. Used by userspace wland (via /dev/pmem) and in-kernel
BCM votes (0149). Same safety model as touch L11C vote: ACTIVE TCS only,
one TCS, own IRQ masked while busy, timeout poisons driver for this boot.

bsd/dev/sweet_pmem.c: add struct pmem_rpmh, PMEM_RPMH _IOW, extern
sweet_rpmh_write; handle PMEM_RPMH in pm_ioctl (outside lock, waits for TCS).
bsd/dev/sweet_rpmh.c: rh_map() logs geometry once (static bool); new
sweet_rpmh_write(res, n, offsets, values) for wland votes.

Log check: with sweetpmem=1, "SWEET PMEM: rpmh <res> N cmds -> 0".

Port of ios-sweet 0131; regenerated on current tree after 0147.---
diff --git a/bsd/dev/sweet_pmem.c b/bsd/dev/sweet_pmem.c
index 5a05a10..530ea5f 100755
--- a/bsd/dev/sweet_pmem.c
+++ b/bsd/dev/sweet_pmem.c
@@ -65,6 +65,15 @@ struct pmem_list {
 #define PMEM_FREE       _IOW('P', 2, uint64_t)
 #define PMEM_SMC        _IOWR('P', 3, struct pmem_smc)
 #define PMEM_LIST       _IOR('P', 4, struct pmem_list)
+/* Wi-Fi 0131 (ios-flame 0102): one RPMh active vote for wland; sweet_rpmh.c checks it. */
+struct pmem_rpmh {
+	char res[16];           /* cmd-db name */
+	uint32_t n;             /* 1..4 commands */
+	uint32_t offset[4];     /* from the resource address */
+	uint32_t value[4];
+};
+#define PMEM_RPMH       _IOW('P', 5, struct pmem_rpmh)
+extern int sweet_rpmh_write(const char *res, unsigned n, const uint32_t *offsets, const uint32_t *values);
 
 #define PMEM_MAPS       16              /* 2 MB device windows, round robin */
 #define PMEM_WIN        0x200000ULL
@@ -111,6 +120,14 @@ static int
 pm_rw(struct uio *uio, bool write)
 {
 	int err = 0;
+	if (cmd == PMEM_RPMH) {
+		/* Waits for the TCS: not under the pmem lock. */
+		struct pmem_rpmh *r = (struct pmem_rpmh *)data;
+		r->res[sizeof(r->res) - 1] = 0;
+		err = sweet_rpmh_write(r->res, r->n, r->offset, r->value);
+		printf("SWEET PMEM: rpmh %s %u cmds (%#x=%u ...) -> %d\n", r->res, r->n, r->offset[0], r->value[0], err);
+		return err;
+	}
 	lck_mtx_lock(&sweet_pmem_lock);
 	while (!err && uio_resid(uio) > 0) {
 		uint64_t pa = (uint64_t)uio_offset(uio);
@@ -272,6 +289,14 @@ static int
 pm_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag, __unused struct proc *p)
 {
 	int err = 0;
+	if (cmd == PMEM_RPMH) {
+		/* Waits for the TCS: not under the pmem lock. */
+		struct pmem_rpmh *r = (struct pmem_rpmh *)data;
+		r->res[sizeof(r->res) - 1] = 0;
+		err = sweet_rpmh_write(r->res, r->n, r->offset, r->value);
+		printf("SWEET PMEM: rpmh %s %u cmds (%#x=%u ...) -> %d\n", r->res, r->n, r->offset[0], r->value[0], err);
+		return err;
+	}
 	lck_mtx_lock(&sweet_pmem_lock);
 	switch (cmd) {
 	case PMEM_ALLOC:
diff --git a/bsd/dev/sweet_rpmh.c b/bsd/dev/sweet_rpmh.c
index 4da50d8..6b09084 100644
--- a/bsd/dev/sweet_rpmh.c
+++ b/bsd/dev/sweet_rpmh.c
@@ -119,8 +119,11 @@ rh_map(void)
 	unsigned major = (id >> 16) & 0xffu;
 	unsigned count = (config >> (6u * RH_DRV)) & 0x3fu;
 	rh_ncpt = (config >> 27) & 0x1fu;
-	printf("SWEET RPMH: rsc=%#x tcs=%#x DRV=%u id=%#x solver=%#x config=%#x TCS=%u ncpt=%u\n",
-	    RH_RSC_PA, RH_TCS_PA, RH_DRV, id, solver, config, count, rh_ncpt);
+	static bool geometry_logged;    /* Wi-Fi votes call rh_map() many times */
+	if (!geometry_logged) {
+		printf("SWEET RPMH: rsc=%#x tcs=%#x DRV=%u id=%#x solver=%#x config=%#x TCS=%u ncpt=%u\n",
+		    RH_RSC_PA, RH_TCS_PA, RH_DRV, id, solver, config, count, rh_ncpt);
+	}
 	/* This client implements the pre-v3 layout only; do not guess v3 offsets. */
 	if ((major != 1 && major != 2) || config == 0xffffffffu ||
 	    solver == 0xffffffffu || count < RH_NORMAL_N ||
@@ -148,8 +151,11 @@ rh_map(void)
 	uint32_t db_version = rh_read(rh_db, 0);
 	uint32_t magic = rh_read(rh_db, 4);
 	uint32_t flags = rh_read(rh_db, 140);
-	printf("SWEET RPMH: cmd-db version=%#x magic=%#x checksum=%#x flags=%#x\n",
-	    db_version, magic, rh_read(rh_db, 136), flags);
+	if (!geometry_logged) {
+		printf("SWEET RPMH: cmd-db version=%#x magic=%#x checksum=%#x flags=%#x\n",
+		    db_version, magic, rh_read(rh_db, 136), flags);
+	}
+	geometry_logged = true;
 	/* Linux only checks magic; version 1 is an intentionally stricter policy. */
 	if (magic != RH_DB_MAGIC || db_version != 1 || (flags & 1u)) {
 		printf("SWEET RPMH: unsupported/standalone cmd-db\n");
@@ -355,4 +361,34 @@ out:
 	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
 	return error;
 }
+
+/*
+ * Wi-Fi/modem votes for wland (Wi-Fi port 0131, behaviour from DC28088
+ * 0141/0149 but written in this file's own rh_lookup/rh_send style; none of
+ * the branch's Adreno ARC code is used). Reached only through /dev/pmem
+ * PMEM_RPMH (root, sweetpmem=1) and the in-kernel BCM votes of 0132. Same
+ * safety model as the touch L11C vote: ACTIVE TCS only, one TCS, its own IRQ
+ * source masked while busy, a timeout poisons the driver for this boot.
+ */
+int
+sweet_rpmh_write(const char *res, unsigned n, const uint32_t *offsets, const uint32_t *values)
+{
+	if (!res || n == 0 || n > 4 || !offsets || !values) {
+		return EINVAL;
+	}
+	if (rh_poisoned) {
+		return EPERM;
+	}
+	int error = rh_map();
+	if (error) {
+		return error;
+	}
+	uint32_t address;
+	error = rh_lookup(res, &address);
+	if (error) {
+		return error;
+	}
+	error = rh_send(address, values);
+	return error;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
