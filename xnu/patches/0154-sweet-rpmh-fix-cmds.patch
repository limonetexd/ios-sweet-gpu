From: HakiOS
Subject: [PATCH 0154] sweet wifi: fix RPMH cmd-db scope; generic multi-command sender (0147 fix)

0147 put db_version/magic/flags inside the geometry_logged block in rh_map(),
so the magic/version check below referenced out-of-scope identifiers (CI
42403022012 fails there). Declarations return to function scope; only the
printf stays gated.

Also corrects the vote path: sweet_rpmh_write() and sweet_rpmh_bcm_vote()
called rh_send(), which is the LDO helper (3 commands: value/mode 7/enable 1
at offsets 0/8/4). BCM votes and generic wland votes need their own command
set. New rh_send_cmds(address, n, offsets, values) reuses the same TCS slot
selection, IRQ masking, completion and quarantine logic with n = 1..4
commands, and both callers use it (BCM sends one command: commit|valid|vote
at offset 0).

No behavior change on a default boot: all callers are behind sweetpmem=1 /
sweetsmmuwlan=1|2.
---
diff --git a/bsd/dev/sweet_rpmh.c b/bsd/dev/sweet_rpmh.c
index 818b3b1..de770ef 100644
--- a/bsd/dev/sweet_rpmh.c
+++ b/bsd/dev/sweet_rpmh.c
@@ -148,14 +148,14 @@ rh_map(void)
 		}
 		rh_db_size = size;
 	}
-			if (!geometry_logged) {
-			uint32_t db_version = rh_read(rh_db, 0);
-			uint32_t magic = rh_read(rh_db, 4);
-			uint32_t flags = rh_read(rh_db, 140);
-			printf("SWEET RPMH: cmd-db version=%#x magic=%#x checksum=%#x flags=%#x\n",
-			    db_version, magic, rh_read(rh_db, 136), flags);
-		}
+	uint32_t db_version = rh_read(rh_db, 0);
+	uint32_t magic = rh_read(rh_db, 4);
+	uint32_t flags = rh_read(rh_db, 140);
+	if (!geometry_logged) {
+		printf("SWEET RPMH: cmd-db version=%#x magic=%#x checksum=%#x flags=%#x\n",
+		    db_version, magic, rh_read(rh_db, 136), flags);
 		geometry_logged = true;
+	}
 	/* Linux only checks magic; version 1 is an intentionally stricter policy. */
 	if (magic != RH_DB_MAGIC || db_version != 1 || (flags & 1u)) {
 		printf("SWEET RPMH: unsupported/standalone cmd-db\n");
@@ -332,6 +332,115 @@ rh_send(uint32_t address, unsigned mv)
 	return 0;
 }
 
+/*
+ * Generic sender for non-LDO resources (BCM votes and the Wi-Fi votes that
+ * wland makes through /dev/pmem): n commands (1..4) at `offsets` from the
+ * resource address, each with its own value. Slot selection, IRQ masking and
+ * quarantine rules are the same as rh_send().
+ */
+static int
+rh_send_cmds(uint32_t address, unsigned n, const uint32_t *offsets, const uint32_t *values)
+{
+	int chosen = -1;
+	if (n == 0 || n > 4 || !offsets || !values) {
+		return EINVAL;
+	}
+	for (unsigned t = 0; t < RH_ACTIVE_N; ++t) {
+		uint32_t b = t * RH_TCS_STRIDE;
+		uint32_t enabled = rh_read(rh_tcs, b + RH_ENABLE);
+		printf("SWEET RPMH: ACTIVE TCS%u idle=%#x control=%#x enable=%#x wait=%#x\n",
+		    t, rh_read(rh_tcs, b + RH_STATUS), rh_read(rh_tcs, b + RH_CONTROL),
+		    enabled, rh_read(rh_tcs, b + RH_WAIT));
+		if (enabled & ~((1u << rh_ncpt) - 1u)) {
+			return EIO;
+		}
+		for (unsigned c = 0; c < rh_ncpt; ++c) {
+			if ((enabled & (1u << c)) &&
+			    (rh_read(rh_tcs, b + RH_ADDR + c * RH_CMD_STRIDE) & ~15u) == address) {
+				printf("SWEET RPMH: conflicting inherited request in TCS%u\n", t);
+				return EBUSY;
+			}
+		}
+		if (chosen < 0 && rh_free(t)) {
+			chosen = (int)t;
+		}
+	}
+	if (chosen < 0) {
+		printf("SWEET RPMH: no empty idle ACTIVE TCS; leaving inherited state intact\n");
+		return EBUSY;
+	}
+	unsigned t = (unsigned)chosen;
+	uint32_t b = t * RH_TCS_STRIDE, bit = 1u << t, mask = (1u << n) - 1u;
+	uint32_t irq_en = rh_read(rh_tcs, RH_IRQ_EN);
+	if (irq_en == 0xffffffffu || !rh_free(t)) {
+		return EBUSY;
+	}
+	/* Only this TCS's source is masked. Other sources/CPU IRQs remain intact. */
+	if (!rh_sync(RH_IRQ_EN, irq_en & ~bit)) {
+		rh_poisoned = true;
+		return EIO;
+	}
+	if (!rh_free(t)) {
+		if (!rh_sync(RH_IRQ_EN, (rh_read(rh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+			rh_poisoned = true;
+		}
+		return EBUSY;
+	}
+	/* From here an uncertain write/timeout quarantines our slot for this boot. */
+	rh_poisoned = true;
+	printf("SWEET RPMH: TCS%u ACTIVE %u cmds at %#x irq-enable=%#x\n", t, n, address, irq_en);
+	for (unsigned c = 0; c < n; ++c) {
+		uint32_t cmd = b + c * RH_CMD_STRIDE;
+		if (!rh_sync(cmd + RH_MSGID, RH_WRITE_ACK) ||
+		    !rh_sync(cmd + RH_ADDR, address + offsets[c]) ||
+		    !rh_sync(cmd + RH_DATA, values[c])) {
+			return EIO;
+		}
+	}
+	if (!rh_sync(b + RH_WAIT, mask) || !rh_sync(b + RH_ENABLE, mask) ||
+	    !rh_sync(b + RH_CONTROL, 0) || !rh_sync(b + RH_CONTROL, RH_AMC_EN)) {
+		return EIO;
+	}
+	rh_write(rh_tcs, b + RH_CONTROL, RH_AMC_EN | RH_TRIGGER);
+	uint32_t irq = 0, idle = 0, status[4] = {0, 0, 0, 0};
+	bool done = false, progress = false;
+	for (unsigned us = 0; us < RH_TIMEOUT_US; ++us) {
+		irq = rh_read(rh_tcs, RH_IRQ_STATUS);
+		idle = rh_read(rh_tcs, b + RH_STATUS);
+		bool complete = true;
+		for (unsigned c = 0; c < n; ++c) {
+			status[c] = rh_read(rh_tcs, b + RH_CMD_STATUS + c * RH_CMD_STRIDE);
+			complete &= status[c] != 0xffffffffu &&
+			    (status[c] & (RH_ISSUED | RH_COMPLETE)) == (RH_ISSUED | RH_COMPLETE);
+		}
+		progress |= idle == 0 || !complete;
+		if (idle && idle != 0xffffffffu && irq != 0xffffffffu &&
+		    ((irq & bit) || progress) && complete) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	printf("SWEET RPMH: TCS%u done=%d irq=%#x idle=%#x control=%#x cmd-status=%#x/%#x/%#x/%#x\n",
+	    t, done, irq, idle, rh_read(rh_tcs, b + RH_CONTROL), status[0], status[1], status[2], status[3]);
+	if (!done) {
+		printf("SWEET RPMH: timeout; TCS quarantined, IRQ remains masked; no reset/retry\n");
+		return ETIMEDOUT;
+	}
+	if (!rh_sync(b + RH_CONTROL, RH_AMC_EN) || !rh_sync(b + RH_CONTROL, 0) ||
+	    !rh_sync(b + RH_ENABLE, 0) || !rh_sync(b + RH_WAIT, 0)) {
+		return EIO;
+	}
+	rh_write(rh_tcs, RH_IRQ_CLEAR, bit);
+	if ((rh_read(rh_tcs, RH_IRQ_STATUS) & bit) ||
+	    !rh_sync(RH_IRQ_EN, (rh_read(rh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+		return EIO;
+	}
+	rh_poisoned = false;
+	printf("SWEET RPMH: %u cmds at %#x complete\n", n, address);
+	return 0;
+}
+
 int
 sweet_rpmh_vreg_enable(const char *res, unsigned mv)
 {
@@ -390,14 +499,7 @@ sweet_rpmh_write(const char *res, unsigned n, const uint32_t *offsets, const uin
 	if (error) {
 		return error;
 	}
-	/* rh_send takes a single value; iterate over the commands. */
-	for (unsigned i = 0; i < n; i++) {
-		error = rh_send(address + offsets[i], values[i]);
-		if (error) {
-			break;
-		}
-	}
-	return error;
+	return rh_send_cmds(address, n, offsets, values);
 }
 
 /*
@@ -428,9 +530,10 @@ sweet_rpmh_bcm_vote(const char *res, uint32_t x, uint32_t y)
 			error = rh_lookup(res, &address);
 		}
 		if (!error) {
+			const uint32_t offset = 0;
 			const uint32_t value = (1u << 30) | (1u << 29) | (x << 14) | y;
 			static unsigned bcm_logged;
-			error = rh_send(address, value);
+			error = rh_send_cmds(address, 1, &offset, &value);
 			if (error || ++bcm_logged <= 4) {
 				printf("SWEET RPMH: BCM %s addr=%#x vote %#x -> %d\n", res, address, value, error);
 			}
